<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<tproject xmlns="http://www.tizen.org/tproject">
    <platforms>
        <platform>
            <name>tv-samsung-10.0</name>
        </platform>
    </platforms>
    <package>
        <blacklist>
            <item>scripts</item>
            <item>scripts/**</item>
            <item>*.log</item>
            <item>.git</item>
            <item>.git/**</item>
            <item>.buildResult</item>
            <item>.buildResult/**</item>
            <item>*.wgt</item>
            <item>ISRTV.wgt</item>
            <item>node_modules</item>
            <item>node_modules/**</item>
            <item>.cursor</item>
            <item>.cursor/**</item>
            <item>.DS_Store</item>
            <item>**/.DS_Store</item>
            <item>agent-transcripts</item>
            <item>**/*.map</item>
        </blacklist>
    </package>
</tproject>
