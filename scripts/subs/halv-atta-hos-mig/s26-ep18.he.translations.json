[
  {
    "i": 0,
    "start": "00:00:01.000",
    "end": "00:00:03.040",
    "text": "אוי, איזה יפה יצאת!"
  },
  {
    "i": 1,
    "start": "00:00:03.200",
    "end": "00:00:05.600",
    "text": "זו התוכנית \"Halv åtta hos mig\"."
  },
  {
    "i": 2,
    "start": "00:00:05.760",
    "end": "00:00:10.200",
    "text": "אתם יודעים, התוכנית שבה ארבעה חבר'ה\nמזמינים זה את זה לארוחת ערב."
  },
  {
    "i": 3,
    "start": "00:00:10.360",
    "end": "00:00:14.880",
    "text": "כל הארוחות מקבלות ניקוד, והניקוד הגבוה\nביותר זוכה ב-15,000 קרונות."
  },
  {
    "i": 4,
    "start": "00:00:15.040",
    "end": "00:00:20.200",
    "text": "הבנתם? מעולה! כי עכשיו\nמתחילים את \"Halv åtta hos mig\"!"
  },
  {
    "i": 5,
    "start": "00:00:41.840",
    "end": "00:00:44.920",
    "text": "Kungsträdgården המפואר\nבסטוקהולם..."
  },
  {
    "i": 6,
    "start": "00:00:45.080",
    "end": "00:00:49.920",
    "text": "היה במאות ה-16 וה-17\nשמור רק למשפחת המלוכה."
  },
  {
    "i": 7,
    "start": "00:00:50.080",
    "end": "00:00:53.600",
    "text": "אבל בימי Gustav III\nנפתח הפארק לקהל הרחב."
  },
  {
    "i": 8,
    "start": "00:00:53.760",
    "end": "00:00:58.120",
    "text": "אבל אחרי הרבה מהומות בשנות ה-70\nהמלך התעייף..."
  },
  {
    "i": 9,
    "start": "00:00:58.280",
    "end": "00:01:02.360",
    "text": "ובשנות ה-80 לקח את המקום בחזרה\nועשה המון רעש."
  },
  {
    "i": 10,
    "start": "00:01:02.520",
    "end": "00:01:06.360",
    "text": "כלומר, לא Gustav III,\nאלא מלך Kungsan."
  },
  {
    "i": 11,
    "start": "00:01:06.520",
    "end": "00:01:08.960",
    "text": "אבל זה לא קשור\nלתוכנית של אתמול..."
  },
  {
    "i": 12,
    "start": "00:01:09.120",
    "end": "00:01:13.840",
    "text": "כי אז היינו אצל ויקטור, שם הוגש\nריקוד לוהט על הסלעים..."
  },
  {
    "i": 13,
    "start": "00:01:14.000",
    "end": "00:01:17.640",
    "text": "ושרימפס חריפים למנה ראשונה.\nלמנה עיקרית: עוף בגריל..."
  },
  {
    "i": 14,
    "start": "00:01:17.800",
    "end": "00:01:20.480",
    "text": "והמון תוספות."
  },
  {
    "i": 15,
    "start": "00:01:20.640",
    "end": "00:01:23.360",
    "text": "על זה קיבל ויקטור 20 נקודות."
  },
  {
    "i": 16,
    "start": "00:01:23.520",
    "end": "00:01:26.760",
    "text": "מחר נלך לבחור מזוקן\nבשם מיקה..."
  },
  {
    "i": 17,
    "start": "00:01:26.920",
    "end": "00:01:29.080",
    "text": "שמתאמן בשמחה,\nאם מישהו מכריח אותו."
  },
  {
    "i": 18,
    "start": "00:01:29.240",
    "end": "00:01:31.000",
    "text": "אוקיי, קדימה. יוצאים לדרך."
  },
  {
    "i": 19,
    "start": "00:01:31.160",
    "end": "00:01:34.520",
    "text": "בלעדיה לא הייתי מתאמן."
  },
  {
    "i": 20,
    "start": "00:01:34.680",
    "end": "00:01:37.960",
    "text": "אם הוא טיפוס תחרותי או שהכול\nעניין של גולגולות..."
  },
  {
    "i": 21,
    "start": "00:01:38.120",
    "end": "00:01:39.760",
    "text": "נגלה מחר."
  },
  {
    "i": 22,
    "start": "00:01:39.920",
    "end": "00:01:41.600",
    "text": "זו פשוט תרבות טובה."
  },
  {
    "i": 23,
    "start": "00:01:41.760",
    "end": "00:01:44.880",
    "text": "ביום חמישי הגמר\nבסלטשבהדן אצל מריה..."
  },
  {
    "i": 24,
    "start": "00:01:45.040",
    "end": "00:01:48.400",
    "text": "שאולי קצת שונה\nבתפיסת המציאות."
  },
  {
    "i": 25,
    "start": "00:01:48.560",
    "end": "00:01:51.880",
    "text": "לא לכולם יש אייל בגובה 2.5 מטר\nבמוח?"
  },
  {
    "i": 26,
    "start": "00:01:52.040",
    "end": "00:01:57.800",
    "text": "עם ההתמכרות החמורה לספרי בישול\nוהפטיש שלה לציוד מטבח..."
  },
  {
    "i": 27,
    "start": "00:01:57.960",
    "end": "00:02:00.600",
    "text": "אפשר רק לקוות\nלארוחה מפוצצת באמת."
  },
  {
    "i": 28,
    "start": "00:02:01.800",
    "end": "00:02:05.480",
    "text": "אבל היום יום שלישי. אז נכיר\nאת מימי קצת יותר טוב."
  },
  {
    "i": 29,
    "start": "00:02:05.640",
    "end": "00:02:08.640",
    "text": "איך היית מתארת את עצמך?"
  },
  {
    "i": 30,
    "start": "00:02:08.800",
    "end": "00:02:14.240",
    "text": "כאדם שמח וסקרן\nשאוהב את החיים הטובים, אולי."
  },
  {
    "i": 31,
    "start": "00:02:14.400",
    "end": "00:02:18.560",
    "text": "-כן, אולי. איפה אנחנו עכשיו?\n-הנה הסירה שלי."
  },
  {
    "i": 32,
    "start": "00:02:18.720",
    "end": "00:02:22.560",
    "text": "רוצה לבוא לסיבוב קטן?\nכיף! יוצאים!"
  },
  {
    "i": 33,
    "start": "00:02:22.720",
    "end": "00:02:24.600",
    "text": "ספינה מגניבה."
  },
  {
    "i": 34,
    "start": "00:02:24.760",
    "end": "00:02:28.320",
    "text": "כן, מושלמת להתפנק בה ב-Mälaren."
  },
  {
    "i": 35,
    "start": "00:02:28.480",
    "end": "00:02:30.080",
    "text": "ספינה מהממת!"
  },
  {
    "i": 36,
    "start": "00:02:30.240",
    "end": "00:02:32.880",
    "text": "חייבים כובע קברניט\nכשיוצאים לים!"
  },
  {
    "i": 37,
    "start": "00:02:33.040",
    "end": "00:02:35.280",
    "text": "בניגוד לכובע בטון\nשאולי תקבלי מחר."
  },
  {
    "i": 38,
    "start": "00:02:35.440",
    "end": "00:02:40.400",
    "text": "-יש לך קצת ידע בים?\n-עכשיו אני בטלוויזיה."
  },
  {
    "i": 39,
    "start": "00:02:40.560",
    "end": "00:02:43.760",
    "text": "אז בהחלט."
  },
  {
    "i": 40,
    "start": "00:02:43.920",
    "end": "00:02:47.680",
    "text": "אבל אם נטשטש אותך ונקרא לך\nUlla, אז אפשר להיות כנה?"
  },
  {
    "i": 41,
    "start": "00:02:47.840",
    "end": "00:02:54.000",
    "text": "אני בדרך כלל יושבת על הגג\nומנהיגה עם הרגליים..."
  },
  {
    "i": 42,
    "start": "00:02:54.160",
    "end": "00:02:58.000",
    "text": "כדי שהשמש תהיה עליי ולא\nלשבת סגורה בתוך הסירה."
  },
  {
    "i": 43,
    "start": "00:02:58.160",
    "end": "00:03:00.640",
    "text": "לא יודעת אם זה נחשב\nלידע ימי בריא..."
  },
  {
    "i": 44,
    "start": "00:03:00.800",
    "end": "00:03:02.640",
    "text": "אבל עד עכשיו זה עבד טוב."
  },
  {
    "i": 45,
    "start": "00:03:02.800",
    "end": "00:03:05.280",
    "text": "את חושבת שטייסים יכולים\nליהנות מזה?"
  },
  {
    "i": 46,
    "start": "00:03:05.440",
    "end": "00:03:08.320",
    "text": "זה תלוי כמה טוב\nעובדים עם הרגליים."
  },
  {
    "i": 47,
    "start": "00:03:08.480",
    "end": "00:03:11.440",
    "text": "כן, ו-Ulla בעצם נקראת\nבשם אחר."
  },
  {
    "i": 48,
    "start": "00:03:11.600",
    "end": "00:03:13.880",
    "text": "מה את עושה כשאת לא\nבלב הגלים?"
  },
  {
    "i": 49,
    "start": "00:03:14.040",
    "end": "00:03:19.760",
    "text": "מסתובבת עם החברים שלי,\nשותה בירה, יוצאת לאכול."
  },
  {
    "i": 50,
    "start": "00:03:19.920",
    "end": "00:03:21.840",
    "text": "זה כנראה מה שאנחנו עושים הכי הרבה."
  },
  {
    "i": 51,
    "start": "00:03:22.000",
    "end": "00:03:23.920",
    "text": "-נחמד.\n-באמת."
  },
  {
    "i": 52,
    "start": "00:03:24.080",
    "end": "00:03:26.080",
    "text": "כאן ב-Hornstull?"
  },
  {
    "i": 53,
    "start": "00:03:26.240",
    "end": "00:03:28.160",
    "text": "בדרך כלל אנחנו נתקעות כאן."
  },
  {
    "i": 54,
    "start": "00:03:28.320",
    "end": "00:03:33.160",
    "text": "אנחנו מדברות על ללכת למקום אחר\nואז בכל זאת נשארות."
  },
  {
    "i": 55,
    "start": "00:03:33.320",
    "end": "00:03:36.160",
    "text": "-את מי הבאת איתך?\n-זו Johanna."
  },
  {
    "i": 56,
    "start": "00:03:36.320",
    "end": "00:03:39.040",
    "text": "לחיים!"
  },
  {
    "i": 57,
    "start": "00:03:39.200",
    "end": "00:03:42.120",
    "text": "על מה אתן בדרך כלל מדברות\nכשאתן שותות בירה?"
  },
  {
    "i": 58,
    "start": "00:03:42.280",
    "end": "00:03:45.880",
    "text": "אנחנו מדברות הרבה על אוכל\nועל מסעדות."
  },
  {
    "i": 59,
    "start": "00:03:46.040",
    "end": "00:03:48.960",
    "text": "אוכל וגברים."
  },
  {
    "i": 60,
    "start": "00:03:49.120",
    "end": "00:03:52.560",
    "text": "אה, הנושאים האהובים עליי! אבל עכשיו\nמימי אמורה להיות מארחת \"Halv åtta\"."
  },
  {
    "i": 61,
    "start": "00:03:52.720",
    "end": "00:03:56.120",
    "text": "מרגש. בהצלחה הערב.\nזה ילך כל כך טוב."
  },
  {
    "i": 62,
    "start": "00:03:56.280",
    "end": "00:03:58.280",
    "text": "-כן, מקווה.\n-גם אני!"
  },
  {
    "i": 63,
    "start": "00:03:58.440",
    "end": "00:04:01.480",
    "text": "את לא יכולה להסיע אותי על האופניים?\nלא, שם יש סל."
  },
  {
    "i": 64,
    "start": "00:04:01.640",
    "end": "00:04:05.400",
    "text": "אבל רגע... הלו?\nאצטרך לרוץ. הלו?"
  },
  {
    "i": 65,
    "start": "00:04:05.560",
    "end": "00:04:09.240",
    "text": "-הנה אני!\n-ברוכה הבאה."
  },
  {
    "i": 66,
    "start": "00:04:09.400",
    "end": "00:04:13.000",
    "text": "-כאן אני גרה עם החבר שלי.\n-איזה סגנון יש לכם?"
  },
  {
    "i": 67,
    "start": "00:04:13.160",
    "end": "00:04:17.920",
    "text": "שאלה טובה. לפעמים אני תוהה:\n\"זה הסגנון שלנו?\""
  },
  {
    "i": 68,
    "start": "00:04:18.080",
    "end": "00:04:22.280",
    "text": "שאלה קשה. אבל הנה לך ואן גוך\nמתקופת הפקקים שלו."
  },
  {
    "i": 69,
    "start": "00:04:22.440",
    "end": "00:04:24.720",
    "text": "-תוכלי להראות לי קצת את הבית?\n-בטח."
  },
  {
    "i": 70,
    "start": "00:04:24.880",
    "end": "00:04:30.000",
    "text": "-את עוסקת שם בוולטיז'?\n-בדיוק. ספורט שלא מעריכים מספיק."
  },
  {
    "i": 71,
    "start": "00:04:30.160",
    "end": "00:04:35.200",
    "text": "-קצת כמו התעמלות על סוס.\n-כמה זמן עסקת בזה?"
  },
  {
    "i": 72,
    "start": "00:04:35.360",
    "end": "00:04:40.720",
    "text": "-התעסקתי בזה בערך עשר שנים.\n-וואו! את יכולה לרדת לשפגט?"
  },
  {
    "i": 73,
    "start": "00:04:40.880",
    "end": "00:04:44.560",
    "text": "בהחלט. מעניין לראות אם\nזה יעבוד עם הג'ינס האלה."
  },
  {
    "i": 74,
    "start": "00:04:44.720",
    "end": "00:04:46.600",
    "text": "ננסה."
  },
  {
    "i": 75,
    "start": "00:04:48.320",
    "end": "00:04:51.760",
    "text": "-זה הצליח!\n-המכנסיים החזיקו!"
  },
  {
    "i": 76,
    "start": "00:04:51.920",
    "end": "00:04:53.960",
    "text": "כן, אז אין בעיה."
  },
  {
    "i": 77,
    "start": "00:04:54.120",
    "end": "00:04:57.240",
    "text": "את יכולה גם לקום מהשפגט\nכדי שנוכל לעשות גלגלים החוצה?"
  },
  {
    "i": 78,
    "start": "00:04:57.400",
    "end": "00:05:03.160",
    "text": "-נו, יוצאים שוב?\n-נציץ קצת בגידולים."
  },
  {
    "i": 79,
    "start": "00:05:03.320",
    "end": "00:05:07.480",
    "text": "אוקיי, איזה כיף! כאן את מגדלת\nפרחים משגעים, אני מבינה."
  },
  {
    "i": 80,
    "start": "00:05:07.640",
    "end": "00:05:12.160",
    "text": "-זו הערוגה שלנו.\n-אה, ככה."
  },
  {
    "i": 81,
    "start": "00:05:12.320",
    "end": "00:05:15.680",
    "text": "אבל אני די משגשגת\nמהצד השני."
  },
  {
    "i": 82,
    "start": "00:05:15.840",
    "end": "00:05:18.840",
    "text": "אבל יש לנו ריבס, ואותו\nאני הולכת להשתמש היום."
  },
  {
    "i": 83,
    "start": "00:05:19.000",
    "end": "00:05:21.480",
    "text": "בזמן שאת שמה עליהם ריבס\nאני אבדוק עם ויקטור..."
  },
  {
    "i": 84,
    "start": "00:05:21.640",
    "end": "00:05:23.680",
    "text": "איך הוא מרגיש לקראת הערב."
  },
  {
    "i": 85,
    "start": "00:05:23.840",
    "end": "00:05:27.000",
    "text": "אין לי מושג\nמה מחכה לי שם."
  },
  {
    "i": 86,
    "start": "00:05:27.160",
    "end": "00:05:31.360",
    "text": "אני חושבת שמחכה לך בחורה\nבשם מימי שמזמינה לאוכל."
  },
  {
    "i": 87,
    "start": "00:05:31.520",
    "end": "00:05:33.520",
    "text": "-נבשל קצת?\n-נבשל."
  },
  {
    "i": 88,
    "start": "00:05:33.680",
    "end": "00:05:36.720",
    "text": "יופי. הגיע הזמן לפגוש\nתפריט למנה ראשונה שכתוב בו..."
  },
  {
    "i": 89,
    "start": "00:05:40.240",
    "end": "00:05:42.320",
    "text": "מה היה הרעיון עם המנה הזו, מימי?"
  },
  {
    "i": 90,
    "start": "00:05:42.480",
    "end": "00:05:47.280",
    "text": "שהיא תרגיש קצת רעננה."
  },
  {
    "i": 91,
    "start": "00:05:47.440",
    "end": "00:05:52.560",
    "text": "וזה מתאים מאוד\nלטעמים האסיאתיים האלה."
  },
  {
    "i": 92,
    "start": "00:05:52.720",
    "end": "00:05:55.680",
    "text": "ורציתי לעשות צמחוני."
  },
  {
    "i": 93,
    "start": "00:05:55.840",
    "end": "00:05:59.000",
    "text": "-זה הנושא שלך הערב?\n-כן."
  },
  {
    "i": 94,
    "start": "00:05:59.160",
    "end": "00:06:01.760",
    "text": "אז היום זה יהיה צמחוני לגמרי."
  },
  {
    "i": 95,
    "start": "00:06:01.920",
    "end": "00:06:04.920",
    "text": "אני שהתכוננתי לבשרי לגמרי.\n- ויקטור, מה דעתך?"
  },
  {
    "i": 96,
    "start": "00:06:05.080",
    "end": "00:06:07.040",
    "text": "מקווה שזה אבוקדו,\nמלפפון ונייר אורז."
  },
  {
    "i": 97,
    "start": "00:06:07.200",
    "end": "00:06:09.520",
    "text": "אתה מקווה למה שכתוב בתפריט?"
  },
  {
    "i": 98,
    "start": "00:06:09.680",
    "end": "00:06:13.520",
    "text": "יהיה מגניב אם שלושת הדברים האלה\nיעשו משהו קסום."
  },
  {
    "i": 99,
    "start": "00:06:13.680",
    "end": "00:06:15.560",
    "text": "אני לא רוצה שיהיו\nהמון דברים אחרים."
  },
  {
    "i": 100,
    "start": "00:06:15.720",
    "end": "00:06:19.200",
    "text": "לא, כמו תיבולים ושטויות.\nלמשל הדרסינג הזה."
  },
  {
    "i": 101,
    "start": "00:06:19.360",
    "end": "00:06:21.600",
    "text": "אופס. סורי, ויקטור."
  },
  {
    "i": 102,
    "start": "00:06:21.760",
    "end": "00:06:25.200",
    "text": "את זה נשפוך\nממש לפני ההגשה."
  },
  {
    "i": 103,
    "start": "00:06:25.360",
    "end": "00:06:28.640",
    "text": "-זה משהו שאכלת, מיקה?\n-לא."
  },
  {
    "i": 104,
    "start": "00:06:28.800",
    "end": "00:06:32.840",
    "text": "אולי נתקלת בזה\nבמסעדה יפנית או סינית."
  },
  {
    "i": 105,
    "start": "00:06:33.000",
    "end": "00:06:35.400",
    "text": "אבל זה יהיה מעניין."
  },
  {
    "i": 106,
    "start": "00:06:35.560",
    "end": "00:06:37.040",
    "text": "-אוי.\n-וואו!"
  },
  {
    "i": 107,
    "start": "00:06:37.200",
    "end": "00:06:40.200",
    "text": "-מה קורה כאן?\n-אלה לא פצצות, אלא נייר אורז."
  },
  {
    "i": 108,
    "start": "00:06:40.360",
    "end": "00:06:45.200",
    "text": "אבל זה קל לקרות ככה כשמנסים\nלהפריד אותם קצת."
  },
  {
    "i": 109,
    "start": "00:06:45.360",
    "end": "00:06:48.320",
    "text": "זה לא נראה ממש טעים, אתה יודע."
  },
  {
    "i": 110,
    "start": "00:06:48.480",
    "end": "00:06:52.800",
    "text": "לא, אבל חכה רק\nעד שאטגן אותם."
  },
  {
    "i": 111,
    "start": "00:06:52.960",
    "end": "00:06:57.480",
    "text": "-את הולכת לטגן אותם?\n-בהחלט. אז זה יהיה קצת יותר כיף."
  },
  {
    "i": 112,
    "start": "00:06:57.640",
    "end": "00:07:00.560",
    "text": "-הכול הוכן למנה הראשונה.\n-את מתכוננת אמיתית."
  },
  {
    "i": 113,
    "start": "00:07:00.720",
    "end": "00:07:02.320",
    "text": "למנה עיקרית..."
  },
  {
    "i": 114,
    "start": "00:07:06.840",
    "end": "00:07:08.560",
    "text": "על מה אתה חושב, ויקטור?"
  },
  {
    "i": 115,
    "start": "00:07:08.720",
    "end": "00:07:13.080",
    "text": "בשר טחון על בסיס אצות וצמחים?\nמאיפה זה בא?"
  },
  {
    "i": 116,
    "start": "00:07:13.240",
    "end": "00:07:15.960",
    "text": "כן, מהתפריט, אני חושבת.\nוהאצות מהים."
  },
  {
    "i": 117,
    "start": "00:07:16.120",
    "end": "00:07:18.960",
    "text": "-חשבת פעם לאכול את זה?\n-בהחלט לא."
  },
  {
    "i": 118,
    "start": "00:07:19.120",
    "end": "00:07:23.320",
    "text": "זה האוכל של הדגים,\nאני לא רוצה להתחרות שם."
  },
  {
    "i": 119,
    "start": "00:07:23.480",
    "end": "00:07:26.880",
    "text": "אולי אתה מעדיף\nבשר טחון על בסיס איילים וצמחים."
  },
  {
    "i": 120,
    "start": "00:07:27.040",
    "end": "00:07:31.160",
    "text": "עכשיו בואו נכין את הדרסינג\nלבשר הטחון."
  },
  {
    "i": 121,
    "start": "00:07:31.320",
    "end": "00:07:37.040",
    "text": "-את אוהבת את הבשר הטחון הזה, מימי.\n-כן, יש לו אופי מיוחד."
  },
  {
    "i": 122,
    "start": "00:07:37.200",
    "end": "00:07:42.120",
    "text": "שטעים וטוב\nומרגיש טוב."
  },
  {
    "i": 123,
    "start": "00:07:42.280",
    "end": "00:07:45.920",
    "text": "-די טוב גם לסביבה.\n-יותר מ\"די\"."
  },
  {
    "i": 124,
    "start": "00:07:46.080",
    "end": "00:07:48.960",
    "text": "שוודי לעולם לא חושף\nאת מקום האצות שלו."
  },
  {
    "i": 125,
    "start": "00:07:49.120",
    "end": "00:07:51.320",
    "text": "אבל את אוספת אצות\nבעצמך באיזשהו מקום?"
  },
  {
    "i": 126,
    "start": "00:07:51.480",
    "end": "00:07:54.440",
    "text": "לא, השאלה כמה אצות\nיש כאן ב-Pålsundet."
  },
  {
    "i": 127,
    "start": "00:07:54.600",
    "end": "00:07:57.320",
    "text": "-אבל כדאי לבדוק.\n-בהחלט."
  },
  {
    "i": 128,
    "start": "00:07:57.480",
    "end": "00:07:59.760",
    "text": "מה את חושבת שיהיו הטעמים,\nמריה?"
  },
  {
    "i": 129,
    "start": "00:07:59.920",
    "end": "00:08:03.640",
    "text": "אולי קצת טעמים מקסיקניים.\nאולי יגיע גוואקמולה..."
  },
  {
    "i": 130,
    "start": "00:08:03.800",
    "end": "00:08:05.120",
    "text": "מהצד."
  },
  {
    "i": 131,
    "start": "00:08:05.280",
    "end": "00:08:07.280",
    "text": "כן, ויצא שוב בצד השני."
  },
  {
    "i": 132,
    "start": "00:08:07.440",
    "end": "00:08:12.000",
    "text": "-זה תאיקוס, לא טאקוס.\n-תאיקוס? אה..."
  },
  {
    "i": 133,
    "start": "00:08:12.160",
    "end": "00:08:16.800",
    "text": "תאי-טאקוס? עוד יותר מעניין.\nעוד יותר מלהיב."
  },
  {
    "i": 134,
    "start": "00:08:16.960",
    "end": "00:08:19.800",
    "text": "לא, טעיתי.\nהייתי אמורה לדבר עם מיקה."
  },
  {
    "i": 135,
    "start": "00:08:19.960",
    "end": "00:08:22.920",
    "text": "הנה אתה.\nמה דעתך על טורטיות?"
  },
  {
    "i": 136,
    "start": "00:08:23.080",
    "end": "00:08:25.520",
    "text": "-מעניין אם היא אפתה אותן בעצמה.\n-כן, אני מניח."
  },
  {
    "i": 137,
    "start": "00:08:25.680",
    "end": "00:08:30.280",
    "text": "אז זה יהיה רענן וטרי,\nככה אני חושב."
  },
  {
    "i": 138,
    "start": "00:08:30.440",
    "end": "00:08:33.760",
    "text": "אוקיי. אבל איך עושים טורטיות\nממש טעימות?"
  },
  {
    "i": 139,
    "start": "00:08:33.920",
    "end": "00:08:38.360",
    "text": "ניסיתי כל מיני דברים\nואני חושב שהכי יוצא טוב..."
  },
  {
    "i": 140,
    "start": "00:08:38.520",
    "end": "00:08:42.880",
    "text": "כשמשלבים קמח חיטה\nוקמח תירס."
  },
  {
    "i": 141,
    "start": "00:08:43.040",
    "end": "00:08:44.840",
    "text": "כן, זה נשמע\nכמו שילוב מושלם."
  },
  {
    "i": 142,
    "start": "00:08:45.000",
    "end": "00:08:48.040",
    "text": "כמו Humle ו-Dumle, Tommy\nו-Annika, Drutten ו-Gena..."
  },
  {
    "i": 143,
    "start": "00:08:48.200",
    "end": "00:08:52.480",
    "text": "Carl אקסל ו-Monica Dominique,\nמורגן ו-Lasse... כן, הבנתם."
  },
  {
    "i": 144,
    "start": "00:08:52.640",
    "end": "00:08:56.480",
    "text": "-מה קורה עכשיו?\n-עכשיו אני מכניסה אותן קצת למקרר."
  },
  {
    "i": 145,
    "start": "00:08:56.640",
    "end": "00:09:00.120",
    "text": "-שם הן ינוחו קצת.\n-נסתכל על הקינוח."
  },
  {
    "i": 146,
    "start": "00:09:03.520",
    "end": "00:09:07.680",
    "text": "-נשמע טעים, מיקה?\n-ריבס זה טעים מאוד."
  },
  {
    "i": 147,
    "start": "00:09:07.840",
    "end": "00:09:11.560",
    "text": "אני אף פעם לא אוכל ג'ינג'ר,\nחוץ מאשר עם סושי."
  },
  {
    "i": 148,
    "start": "00:09:11.720",
    "end": "00:09:14.040",
    "text": "זה חזק מדי בשבילי.\nאני לא אוהב את הטעם."
  },
  {
    "i": 149,
    "start": "00:09:14.200",
    "end": "00:09:17.600",
    "text": "בלי פחד. אפשר לחשוב\nשאתה אוכל סושי לקינוח."
  },
  {
    "i": 150,
    "start": "00:09:17.760",
    "end": "00:09:20.520",
    "text": "זה יהיה קינוח Hornstull אמיתי!"
  },
  {
    "i": 151,
    "start": "00:09:20.680",
    "end": "00:09:24.080",
    "text": "מדברים על מקומי. יותר מקומי\nמזה כבר לא יהיה."
  },
  {
    "i": 152,
    "start": "00:09:24.240",
    "end": "00:09:27.560",
    "text": "אפשר לטעום עד כמה זה מקומי בטעם?"
  },
  {
    "i": 153,
    "start": "00:09:27.720",
    "end": "00:09:30.800",
    "text": "-בטח.\n-סבבה. תודה."
  },
  {
    "i": 154,
    "start": "00:09:30.960",
    "end": "00:09:33.800",
    "text": "זה כל כך חמוץ\nשהשעונים עוצרים."
  },
  {
    "i": 155,
    "start": "00:09:33.960",
    "end": "00:09:35.880",
    "text": "-אי אפשר להסתיר את זה.\n-מסכים."
  },
  {
    "i": 156,
    "start": "00:09:36.040",
    "end": "00:09:38.560",
    "text": "מה את אומרת על קומפוט ריבס,\nמריה?"
  },
  {
    "i": 157,
    "start": "00:09:38.720",
    "end": "00:09:44.920",
    "text": "הכנתי ריבת ריבס\nוצ'אטני ריבס. טעים בטירוף."
  },
  {
    "i": 158,
    "start": "00:09:45.080",
    "end": "00:09:47.600",
    "text": "ואם נוסיף ג'ינג'ר\nונשים על גלידת וניל..."
  },
  {
    "i": 159,
    "start": "00:09:47.760",
    "end": "00:09:49.960",
    "text": "זה כנראה מנצח."
  },
  {
    "i": 160,
    "start": "00:09:50.120",
    "end": "00:09:53.040",
    "text": "אבל נראה שמימי שכחה את הג'ינג'ר,\nלא?"
  },
  {
    "i": 161,
    "start": "00:09:53.200",
    "end": "00:09:56.840",
    "text": "כן, נכון. טוב שאמרת.\nכמעט שכחתי."
  },
  {
    "i": 162,
    "start": "00:09:57.000",
    "end": "00:09:58.960",
    "text": "יהיה קצת ג'ינג'ר טחון\nבמקום."
  },
  {
    "i": 163,
    "start": "00:09:59.120",
    "end": "00:10:01.120",
    "text": "-טוב שאתה כאן.\n-גם לך."
  },
  {
    "i": 164,
    "start": "00:10:01.280",
    "end": "00:10:04.440",
    "text": "אחרת אנשים היו תוהים:\nעם מי לעזאזל אני מדברת?"
  },
  {
    "i": 165,
    "start": "00:10:04.600",
    "end": "00:10:06.520",
    "text": "עכשיו זה ינוח עד ההגשה."
  },
  {
    "i": 166,
    "start": "00:10:06.680",
    "end": "00:10:08.720",
    "text": "ויקטור, מה אתה אומר על קראמבל קרמל?"
  },
  {
    "i": 167,
    "start": "00:10:08.880",
    "end": "00:10:13.640",
    "text": "יש סוכריות קרמל מתוקות מאוד, אחרות\nפחות מתוקות, ויש קשות כאבן."
  },
  {
    "i": 168,
    "start": "00:10:13.800",
    "end": "00:10:16.720",
    "text": "קראמבל קרמל נשמע כמו\nשמקבלים רק את טעם הקרמל..."
  },
  {
    "i": 169,
    "start": "00:10:16.880",
    "end": "00:10:19.640",
    "text": "ולכן זה הכי טוב.\nזה יהיה טעים בטירוף."
  },
  {
    "i": 170,
    "start": "00:10:19.800",
    "end": "00:10:24.560",
    "text": "פצצה, או אולי אצהצצה\nכי היום הכול צמחוני."
  },
  {
    "i": 171,
    "start": "00:10:24.720",
    "end": "00:10:29.160",
    "text": "חשוב לקבל גם\nמרקמים שונים."
  },
  {
    "i": 172,
    "start": "00:10:29.320",
    "end": "00:10:33.360",
    "text": "הפירורים בקינוח נותנים קראנץ'\nואין להמעיט בערכו."
  },
  {
    "i": 173,
    "start": "00:10:33.520",
    "end": "00:10:37.560",
    "text": "-אוקיי, ומה עכשיו?\n-עכשיו אני רק אטעם."
  },
  {
    "i": 174,
    "start": "00:10:37.720",
    "end": "00:10:39.960",
    "text": "-טעים?\n-להפליא."
  },
  {
    "i": 175,
    "start": "00:10:40.120",
    "end": "00:10:42.440",
    "text": "-נהדר.\n-ועכשיו לתנור."
  },
  {
    "i": 176,
    "start": "00:10:42.600",
    "end": "00:10:45.680",
    "text": "איך היית מסכם\nאת תפריט הערב, מיקה?"
  },
  {
    "i": 177,
    "start": "00:10:45.840",
    "end": "00:10:49.680",
    "text": "אני רואה קצת אסיאתי, קצת בריאות."
  },
  {
    "i": 178,
    "start": "00:10:49.840",
    "end": "00:10:55.360",
    "text": "-רענן וקצת רזה.\n-כמוך?"
  },
  {
    "i": 179,
    "start": "00:10:55.520",
    "end": "00:10:59.920",
    "text": "-כן. תראה איך אני נראה. חתיך.\n-בהחלט!"
  },
  {
    "i": 180,
    "start": "00:11:00.080",
    "end": "00:11:03.120",
    "text": "אם כבר מדברים על רזים, אני אנסה\nלקפוץ לשפגט..."
  },
  {
    "i": 181,
    "start": "00:11:03.280",
    "end": "00:11:06.840",
    "text": "ולראות כמה זמן אפשר להישאר\nבאוויר. נתראה בקרוב."
  },
  {
    "i": 182,
    "start": "00:11:07.000",
    "end": "00:11:09.400",
    "text": "-Fame...! אאוץ'!\n-אוקיי, אני מתחיל."
  },
  {
    "i": 183,
    "start": "00:11:09.560",
    "end": "00:11:12.360",
    "text": "האורחים משדרגים\nאת כובע הטיפש הקלאסי."
  },
  {
    "i": 184,
    "start": "00:11:12.520",
    "end": "00:11:14.680",
    "text": "זה היה נכנס\nאם היית יושב בשקט."
  },
  {
    "i": 185,
    "start": "00:11:14.840",
    "end": "00:11:17.960",
    "text": "האווירה נעשית קצת קרירה\nלפני הארוחה."
  },
  {
    "i": 186,
    "start": "00:11:18.120",
    "end": "00:11:19.440",
    "text": "והאם ויקטור יהיה\nבאמת שבע?"
  },
  {
    "i": 187,
    "start": "00:11:19.600",
    "end": "00:11:22.840",
    "text": "תגיד אם אתה הולך להשאיר קצת."
  },
  {
    "i": 188,
    "start": "00:11:33.600",
    "end": "00:11:37.360",
    "text": "ברוכים השבים לוונציה\nשל הצפון, סטוקהולם."
  },
  {
    "i": 189,
    "start": "00:11:37.520",
    "end": "00:11:41.800",
    "text": "איך מרגיש, מימי? כמו לקפוץ\nבנג'י בלי חבל?"
  },
  {
    "i": 190,
    "start": "00:11:41.960",
    "end": "00:11:45.720",
    "text": "לא, זה בטח אם זה נהיה\nקצת לחוץ..."
  },
  {
    "i": 191,
    "start": "00:11:45.880",
    "end": "00:11:48.600",
    "text": "אבל זה מרגיש די רגוע בכל זאת."
  },
  {
    "i": 192,
    "start": "00:11:48.760",
    "end": "00:11:50.920",
    "text": "נעים, כי הנה מגיעים\nשלושה תושבי 08 עליזים:"
  },
  {
    "i": 193,
    "start": "00:11:51.080",
    "end": "00:11:54.280",
    "text": "מריה, ויקטור ומיקה."
  },
  {
    "i": 194,
    "start": "00:11:55.560",
    "end": "00:12:00.320",
    "text": "-אה, היי!\n-מה נשמע!"
  },
  {
    "i": 195,
    "start": "00:12:00.480",
    "end": "00:12:03.200",
    "text": "כן, איזו הפתעה!"
  },
  {
    "i": 196,
    "start": "00:12:03.360",
    "end": "00:12:06.840",
    "text": "אתם תצטרפו אלינו למרפסת."
  },
  {
    "i": 197,
    "start": "00:12:07.000",
    "end": "00:12:12.000",
    "text": "-לחיים וברוכים הבאים!\n-תדמיינו שאתם במסיבת ילדים עכשיו."
  },
  {
    "i": 198,
    "start": "00:12:12.160",
    "end": "00:12:15.880",
    "text": "זה מושלם! איזה מתוקים אתם!"
  },
  {
    "i": 199,
    "start": "00:12:16.040",
    "end": "00:12:20.600",
    "text": "כיף שאתם כאן אצלי היום.\nאתם תשבו כאן ותיהנו קצת..."
  },
  {
    "i": 200,
    "start": "00:12:20.760",
    "end": "00:12:23.520",
    "text": "בזמן שאני נכנסת לסדר במטבח."
  },
  {
    "i": 201,
    "start": "00:12:23.680",
    "end": "00:12:27.480",
    "text": "-נשמע טוב.\n-נתראה בקרוב."
  },
  {
    "i": 202,
    "start": "00:12:27.640",
    "end": "00:12:32.560",
    "text": "אנחנו לא באמת נשב כאן? חייבים\nלראות איך היא גרה. לחטט קצת."
  },
  {
    "i": 203,
    "start": "00:12:32.720",
    "end": "00:12:35.760",
    "text": "-אני מצטרפת אליך.\n-ואני מצטרף אליכם."
  },
  {
    "i": 204,
    "start": "00:12:35.920",
    "end": "00:12:38.440",
    "text": "-מה יש לה כאן?\n-כן, מה זה?"
  },
  {
    "i": 205,
    "start": "00:12:38.600",
    "end": "00:12:41.960",
    "text": "זה לא משהו שבדרך כלל שמים\nעל שולחן סלון, נכון?"
  },
  {
    "i": 206,
    "start": "00:12:42.120",
    "end": "00:12:46.440",
    "text": "-זו כרית עיסוי.\n-אף פעם לא שיחקתם גולף כובעים?"
  },
  {
    "i": 207,
    "start": "00:12:46.600",
    "end": "00:12:49.440",
    "text": "-אני יכול לנסות.\n-היא צריכה לשבת כאן למעלה."
  },
  {
    "i": 208,
    "start": "00:12:49.600",
    "end": "00:12:51.720",
    "text": "-אם יש לה מקום.\n-רק תחשוב על התספורת."
  },
  {
    "i": 209,
    "start": "00:12:51.880",
    "end": "00:12:55.760",
    "text": "הדבר הכי מצחיק במסיבות,\nאבל משפיל מאוד."
  },
  {
    "i": 210,
    "start": "00:12:55.920",
    "end": "00:12:59.280",
    "text": "איך מרגיש לשים את ספינת הקרב\nפוטיומקין על הראש?"
  },
  {
    "i": 211,
    "start": "00:12:59.440",
    "end": "00:13:02.640",
    "text": "צריך לעשות צחוק מעצמך ולהסתובב\nעם ספינה על הראש."
  },
  {
    "i": 212,
    "start": "00:13:02.800",
    "end": "00:13:06.680",
    "text": "-זה היה קצת כיף.\n-אני מסכים."
  },
  {
    "i": 213,
    "start": "00:13:06.840",
    "end": "00:13:09.800",
    "text": "זה היה נכנס\nאם היית יושב בשקט."
  },
  {
    "i": 214,
    "start": "00:13:09.960",
    "end": "00:13:12.400",
    "text": "כן, אני יושב בלי לזוז. קדימה."
  },
  {
    "i": 215,
    "start": "00:13:12.560",
    "end": "00:13:16.040",
    "text": "-אתה מדויק, ויקטור?\n-אני די מגושם."
  },
  {
    "i": 216,
    "start": "00:13:16.200",
    "end": "00:13:18.720",
    "text": "-גרוע בלפגוע.\n-אני מבין."
  },
  {
    "i": 217,
    "start": "00:13:18.880",
    "end": "00:13:21.920",
    "text": "אבל, תודה לאל, הייתי טוב יותר\nממריה."
  },
  {
    "i": 218,
    "start": "00:13:22.080",
    "end": "00:13:26.040",
    "text": "טוב שיש היסטוריה נקייה אם רוצים\nהלוואה. אבל הנה, תשים אותה."
  },
  {
    "i": 219,
    "start": "00:13:26.200",
    "end": "00:13:29.480",
    "text": "את ה-high five נאלצתי להשאיר תלוי באוויר."
  },
  {
    "i": 220,
    "start": "00:13:29.640",
    "end": "00:13:31.560",
    "text": "איך הרגיש לעשות\nממיקה צחוק?"
  },
  {
    "i": 221,
    "start": "00:13:31.720",
    "end": "00:13:33.520",
    "text": "היה כיף, אבל קשה."
  },
  {
    "i": 222,
    "start": "00:13:33.680",
    "end": "00:13:35.840",
    "text": "כי הוא כבר היה כל כך מגוחך?"
  },
  {
    "i": 223,
    "start": "00:13:36.000",
    "end": "00:13:38.200",
    "text": "סיימנו עם זה עכשיו.\nנמשיך?"
  },
  {
    "i": 224,
    "start": "00:13:38.360",
    "end": "00:13:43.080",
    "text": "רעיון טוב. מישהו יודע\nשמימי יש חלקת גידול בחצר."
  },
  {
    "i": 225,
    "start": "00:13:43.240",
    "end": "00:13:46.320",
    "text": "הנה, אז זו החלקה."
  },
  {
    "i": 226,
    "start": "00:13:46.480",
    "end": "00:13:48.800",
    "text": "אתה נשמע קצת מאוכזב."
  },
  {
    "i": 227,
    "start": "00:13:48.960",
    "end": "00:13:52.120",
    "text": "שמעתי שלא מימי\nאחראית על הערוגה..."
  },
  {
    "i": 228,
    "start": "00:13:52.280",
    "end": "00:13:56.320",
    "text": "אלא בן הזוג שלה, אבל\nהם חייבים לגדל בה עוד משהו."
  },
  {
    "i": 229,
    "start": "00:13:56.480",
    "end": "00:13:59.720",
    "text": "-היא קצת ריקה.\n-איפה הריבס?"
  },
  {
    "i": 230,
    "start": "00:13:59.880",
    "end": "00:14:02.840",
    "text": "-באמת נעשה את זה? זה שובב.\n-אל תסתכלו עליי."
  },
  {
    "i": 231,
    "start": "00:14:03.000",
    "end": "00:14:06.760",
    "text": "מלשינים אין חברים. טעם אחד."
  },
  {
    "i": 232,
    "start": "00:14:06.920",
    "end": "00:14:12.720",
    "text": "-חמוץ או מה?\n-כן, כרגיל. חמוץ."
  },
  {
    "i": 233,
    "start": "00:14:12.880",
    "end": "00:14:16.640",
    "text": "בלי פרצופים חמוצים, תקטפו\nקצת פרחים נבולים במקום."
  },
  {
    "i": 234,
    "start": "00:14:16.800",
    "end": "00:14:21.560",
    "text": "-את זה?\n-לא, הם צריכים לרדת מעצמם..."
  },
  {
    "i": 235,
    "start": "00:14:21.720",
    "end": "00:14:23.520",
    "text": "לפני שעושים איתם משהו."
  },
  {
    "i": 236,
    "start": "00:14:23.680",
    "end": "00:14:26.280",
    "text": "-עכשיו עשיתי משהו לא נכון.\n-אל תקשיבו לי."
  },
  {
    "i": 237,
    "start": "00:14:26.440",
    "end": "00:14:29.480",
    "text": "-כבר אמרתי את זה.\n-סליחה."
  },
  {
    "i": 238,
    "start": "00:14:29.640",
    "end": "00:14:32.760",
    "text": "-אף אחד לא ישים לב לזה.\n-אולי זה היה ילד."
  },
  {
    "i": 239,
    "start": "00:14:32.920",
    "end": "00:14:35.800",
    "text": "כן, נאשים את הילדים.\nאבל אולי נמשיך הלאה."
  },
  {
    "i": 240,
    "start": "00:14:35.960",
    "end": "00:14:38.760",
    "text": "-כן, עדיף.\n-ואני חף מפשע."
  },
  {
    "i": 241,
    "start": "00:14:38.920",
    "end": "00:14:43.040",
    "text": "-אתה תמיד מאשים אחרים.\n-גם לך יש אחריות בזה."
  },
  {
    "i": 242,
    "start": "00:14:43.200",
    "end": "00:14:46.800",
    "text": "בזמן שאתם מסדרים את זה, אני אבדוק\nאיך הולך למימי במטבח."
  },
  {
    "i": 243,
    "start": "00:14:46.960",
    "end": "00:14:48.800",
    "text": "-איך מרגיש?\n-טוב."
  },
  {
    "i": 244,
    "start": "00:14:48.960",
    "end": "00:14:53.160",
    "text": "-איזה יופי.\n-זה יכול להיות הצלחה."
  },
  {
    "i": 245,
    "start": "00:14:53.320",
    "end": "00:14:56.840",
    "text": "אני אוהבת את הגישה הזו.\nיש לך שליטה בטמפרטורת השמן?"
  },
  {
    "i": 246,
    "start": "00:14:57.000",
    "end": "00:15:01.320",
    "text": "לא, אני צריכה?\nאני הולכת קצת על תחושה."
  },
  {
    "i": 247,
    "start": "00:15:01.480",
    "end": "00:15:04.400",
    "text": "אני בדרך כלל עושה את מבחן האצבע.\nכשקצה האצבע פריך..."
  },
  {
    "i": 248,
    "start": "00:15:04.560",
    "end": "00:15:08.840",
    "text": "וחום-זהוב, אז השמן\nבטמפרטורה הנכונה. איזה יפה!"
  },
  {
    "i": 249,
    "start": "00:15:09.000",
    "end": "00:15:11.640",
    "text": "-אז המנה הראשונה מוכנה!\n-מושלם!"
  },
  {
    "i": 250,
    "start": "00:15:11.800",
    "end": "00:15:14.560",
    "text": "למנה ראשונה: טרטר\nאבוקדו ומלפפון."
  },
  {
    "i": 251,
    "start": "00:15:14.720",
    "end": "00:15:19.680",
    "text": "-מוגש בנייר אורז.\n-בבקשה. מקווה שיטעם."
  },
  {
    "i": 252,
    "start": "00:15:19.840",
    "end": "00:15:23.800",
    "text": "-זה נראה טעים מאוד.\n-תטעמו ותראו."
  },
  {
    "i": 253,
    "start": "00:15:23.960",
    "end": "00:15:27.560",
    "text": "-כל כך רענן, כל כך טעים.\n-רענן בטירוף."
  },
  {
    "i": 254,
    "start": "00:15:27.720",
    "end": "00:15:30.640",
    "text": "גם משחת שיניים היא רעננה.\nאבל זה היה טעים?"
  },
  {
    "i": 255,
    "start": "00:15:30.800",
    "end": "00:15:34.680",
    "text": "זה היה בטעם רענן.\nאפשר לאכול ממנו הרבה."
  },
  {
    "i": 256,
    "start": "00:15:34.840",
    "end": "00:15:37.040",
    "text": "להשביע את עצמך מהמנה הראשונה."
  },
  {
    "i": 257,
    "start": "00:15:37.200",
    "end": "00:15:39.960",
    "text": "ובכל זאת להרגיש רענן."
  },
  {
    "i": 258,
    "start": "00:15:40.120",
    "end": "00:15:43.080",
    "text": "אוקיי, אני נכנע.\nרענן הוא הטעים החדש."
  },
  {
    "i": 259,
    "start": "00:15:43.240",
    "end": "00:15:47.280",
    "text": "-רענן בטירוף.\n-עוד משהו להגיד על המנה הראשונה?"
  },
  {
    "i": 260,
    "start": "00:15:47.440",
    "end": "00:15:49.840",
    "text": "-רכה, עם טעמים יפים.\n-כן, זה היה משהו אחר."
  },
  {
    "i": 261,
    "start": "00:15:50.000",
    "end": "00:15:53.960",
    "text": "-משהו שרצית ממנו יותר?\n-המון יותר כוסברה."
  },
  {
    "i": 262,
    "start": "00:15:54.120",
    "end": "00:15:58.920",
    "text": "-כי אני אוהבת כוסברה.\n-תגידי אם את הולכת להשאיר קצת."
  },
  {
    "i": 263,
    "start": "00:16:00.280",
    "end": "00:16:03.560",
    "text": "כנראה שלא אעשה את זה.\nחשבתי לקחת בדיוק הכול."
  },
  {
    "i": 264,
    "start": "00:16:03.720",
    "end": "00:16:06.640",
    "text": "זה היה רענן אבל קטן מדי, או מה?"
  },
  {
    "i": 265,
    "start": "00:16:06.800",
    "end": "00:16:10.120",
    "text": "זה היה רענן\nעם עוד מנה?"
  },
  {
    "i": 266,
    "start": "00:16:10.280",
    "end": "00:16:12.480",
    "text": "אני מפרשת את זה כמשהו טוב.\nאיך הלך?"
  },
  {
    "i": 267,
    "start": "00:16:12.640",
    "end": "00:16:15.920",
    "text": "כולם סיימו את הצלחת,\nוזה תמיד ציון טוב."
  },
  {
    "i": 268,
    "start": "00:16:16.080",
    "end": "00:16:19.120",
    "text": "ועכשיו את מטגנת\nבשר טחון מאצות וצמחים."
  },
  {
    "i": 269,
    "start": "00:16:19.280",
    "end": "00:16:22.040",
    "text": "-איך הוא טעים?\n-קצת ים וקצת אומאמי."
  },
  {
    "i": 270,
    "start": "00:16:22.200",
    "end": "00:16:26.960",
    "text": "ואיך בעצם טעם אומאמי?\nאולי תרצי לענות על זה."
  },
  {
    "i": 271,
    "start": "00:16:27.120",
    "end": "00:16:28.920",
    "text": "כי אני לא יכולה!"
  },
  {
    "i": 272,
    "start": "00:16:29.080",
    "end": "00:16:32.880",
    "text": "המילה אומאמי באה מטקסס\nוהיא אומרת \"טעים בטירוף\"."
  },
  {
    "i": 273,
    "start": "00:16:33.040",
    "end": "00:16:34.720",
    "text": "\"Oh, mami! This is good!\""
  },
  {
    "i": 274,
    "start": "00:16:34.880",
    "end": "00:16:38.280",
    "text": "-כמה זמן מטגנים את הטורטייה?\n-כאן הולכים על תחושה."
  },
  {
    "i": 275,
    "start": "00:16:38.440",
    "end": "00:16:45.920",
    "text": "-אוקיי, כמו עם השמן.\n-כאן אולי הייתי קצת מוקדמת."
  },
  {
    "i": 276,
    "start": "00:16:46.080",
    "end": "00:16:51.000",
    "text": "אבל תני לה עוד קצת\nבצד השני וזה יהיה טוב."
  },
  {
    "i": 277,
    "start": "00:16:51.160",
    "end": "00:16:56.480",
    "text": "בדיוק. אם קיבלת מעט שמש\nעל הבטן, מותר לשרוף את הגב."
  },
  {
    "i": 278,
    "start": "00:16:57.760",
    "end": "00:17:01.840",
    "text": "אז. עכשיו אני חושבת שזה\nמעוטר סופית. יוצאים."
  },
  {
    "i": 279,
    "start": "00:17:02.000",
    "end": "00:17:06.080",
    "text": "למנה עיקרית: תאיקוס,\nבשר טחון מאצות וצמחים..."
  },
  {
    "i": 280,
    "start": "00:17:06.240",
    "end": "00:17:08.520",
    "text": "עם טורטייה, כוסברה\nומיונז צ'ילי."
  },
  {
    "i": 281,
    "start": "00:17:08.680",
    "end": "00:17:13.600",
    "text": "-בון אפטי!\n-כן, סוף סוף!"
  },
  {
    "i": 282,
    "start": "00:17:14.880",
    "end": "00:17:17.360",
    "text": "נו, אז...?"
  },
  {
    "i": 283,
    "start": "00:17:17.520",
    "end": "00:17:24.040",
    "text": "-וואו, איזה טעים. איזה טעמים!\n-איזה כיף!"
  },
  {
    "i": 284,
    "start": "00:17:24.200",
    "end": "00:17:27.560",
    "text": "אבל זה היה פשוט...\nפשוט מדהים."
  },
  {
    "i": 285,
    "start": "00:17:27.720",
    "end": "00:17:31.920",
    "text": "זה הכי טעים שטעמתי.\nכל השילובים!"
  },
  {
    "i": 286,
    "start": "00:17:32.080",
    "end": "00:17:34.560",
    "text": "זה היה טעים מאוד."
  },
  {
    "i": 287,
    "start": "00:17:34.720",
    "end": "00:17:39.400",
    "text": "-הכי טעים שאכלת?\n-כן, זה היה סופר טעים."
  },
  {
    "i": 288,
    "start": "00:17:39.560",
    "end": "00:17:42.320",
    "text": "-היה בו המון טעם.\n-איזה כיף!"
  },
  {
    "i": 289,
    "start": "00:17:42.480",
    "end": "00:17:46.440",
    "text": "ספרי על האצות. חשבתי שזה\nאצות ובשר טחון מפולים."
  },
  {
    "i": 290,
    "start": "00:17:46.600",
    "end": "00:17:48.400",
    "text": "או שהאצות בפנים?"
  },
  {
    "i": 291,
    "start": "00:17:48.560",
    "end": "00:17:56.160",
    "text": "יש אצות בבשר הטחון, זה יותר\nכמו נשא של טעם ובריאות."
  },
  {
    "i": 292,
    "start": "00:17:56.320",
    "end": "00:17:59.920",
    "text": "-לא הרגשת שום אצות?\n-לא ממש הרגשתי אצות."
  },
  {
    "i": 293,
    "start": "00:18:00.080",
    "end": "00:18:05.160",
    "text": "-אז הן פשוט ירדו.\n-ויקטור, הרגשת את האצות?"
  },
  {
    "i": 294,
    "start": "00:18:05.320",
    "end": "00:18:09.360",
    "text": "ממש לא. ציפיתי\nלהתאצות קצת."
  },
  {
    "i": 295,
    "start": "00:18:09.520",
    "end": "00:18:12.440",
    "text": "-אבל לא יצא לי.\n-לא יצא לך להתאצות?"
  },
  {
    "i": 296,
    "start": "00:18:12.600",
    "end": "00:18:15.000",
    "text": "או שככה אצות טועמות\nוזה היה טעים מאוד."
  },
  {
    "i": 297,
    "start": "00:18:15.160",
    "end": "00:18:17.120",
    "text": "יש לך מה להוסיף, מריה?"
  },
  {
    "i": 298,
    "start": "00:18:17.280",
    "end": "00:18:23.000",
    "text": "זה היה בטעם כל הטעמים הנפלאים\nשאוהבים. בצל כבוש, אבוקדו..."
  },
  {
    "i": 299,
    "start": "00:18:23.160",
    "end": "00:18:25.320",
    "text": "-זה היה רענן.\n-הנה זה שוב."
  },
  {
    "i": 300,
    "start": "00:18:25.480",
    "end": "00:18:28.160",
    "text": "שלושה דברים טובים על המנה העיקרית, ויקטור."
  },
  {
    "i": 301,
    "start": "00:18:28.320",
    "end": "00:18:31.680",
    "text": "אחד: הטורטיות היו בכל מקרה\nהטעימות ביותר בשוודיה."
  },
  {
    "i": 302,
    "start": "00:18:31.840",
    "end": "00:18:37.360",
    "text": "שניים: אסיר תודה בטירוף ששמת\nהמון קראנץ'."
  },
  {
    "i": 303,
    "start": "00:18:37.520",
    "end": "00:18:41.480",
    "text": "ושלוש: שהמתכון\nיופיע באתר köket.se."
  },
  {
    "i": 304,
    "start": "00:18:41.640",
    "end": "00:18:43.840",
    "text": "-אז אוכל להכין את זה בבית.\n-תודה על זה!"
  },
  {
    "i": 305,
    "start": "00:18:44.000",
    "end": "00:18:47.920",
    "text": "-זה היה הצלחה!\n-כן, איזה כיף!"
  },
  {
    "i": 306,
    "start": "00:18:48.080",
    "end": "00:18:52.560",
    "text": "-נכון?\n-כן, הייתי קצת לחוצה לפני."
  },
  {
    "i": 307,
    "start": "00:18:52.720",
    "end": "00:18:56.280",
    "text": "אבל יש לך מושג\nכמה חם הקומפוט צריך להיות?"
  },
  {
    "i": 308,
    "start": "00:18:56.440",
    "end": "00:18:59.400",
    "text": "חשבתי שהוא יהיה\nפושר קצת בלבד, לא חם מדי."
  },
  {
    "i": 309,
    "start": "00:18:59.560",
    "end": "00:19:01.760",
    "text": "כי חם מדי אף פעם לא טוב."
  },
  {
    "i": 310,
    "start": "00:19:01.920",
    "end": "00:19:06.640",
    "text": "הוא יכול לעמוד כאן קצת\nבזמן שאני מוציאה את הגלידה."
  },
  {
    "i": 311,
    "start": "00:19:06.800",
    "end": "00:19:09.400",
    "text": "-אוי אוי אוי.\n-היא הייתה קשה?"
  },
  {
    "i": 312,
    "start": "00:19:09.560",
    "end": "00:19:13.840",
    "text": "-היא הייתה קצת קשה.\n-אני רואה. אופס!"
  },
  {
    "i": 313,
    "start": "00:19:14.000",
    "end": "00:19:18.320",
    "text": "-היא חמקה!\n-כן, שני כדורי גלידה ובלילה."
  },
  {
    "i": 314,
    "start": "00:19:18.480",
    "end": "00:19:20.240",
    "text": "הדבר הכי חכם שאני מכירה."
  },
  {
    "i": 315,
    "start": "00:19:20.400",
    "end": "00:19:24.560",
    "text": "נו, זה יותר מצחיק\nעם אופה ובלילה."
  },
  {
    "i": 316,
    "start": "00:19:24.720",
    "end": "00:19:27.280",
    "text": "-די עם זה. זה ייראה יפה!\n-ככה, כן."
  },
  {
    "i": 317,
    "start": "00:19:27.440",
    "end": "00:19:29.600",
    "text": "אז אני מרגישה שסיימתי\nעם הקינוח."
  },
  {
    "i": 318,
    "start": "00:19:29.760",
    "end": "00:19:32.720",
    "text": "-נשאר רק להגיש.\n-יאפ!"
  },
  {
    "i": 319,
    "start": "00:19:32.880",
    "end": "00:19:36.880",
    "text": "לקינוח: גלידת וניל עם\nקומפוט ריבס וג'ינג'ר."
  },
  {
    "i": 320,
    "start": "00:19:37.040",
    "end": "00:19:39.840",
    "text": "מעליה קראמבל קרמל. מממ!"
  },
  {
    "i": 321,
    "start": "00:19:40.000",
    "end": "00:19:42.320",
    "text": "אני כל כך שמחה. פחדתי שזה ייתקע\nבין השיניים..."
  },
  {
    "i": 322,
    "start": "00:19:42.480",
    "end": "00:19:45.680",
    "text": "ואולי יעקור כמה, אבל\nזה לא קרה."
  },
  {
    "i": 323,
    "start": "00:19:45.840",
    "end": "00:19:48.520",
    "text": "אז תודה על הקראנץ'."
  },
  {
    "i": 324,
    "start": "00:19:48.680",
    "end": "00:19:51.600",
    "text": "גם אתה לא איבדת שיניים, נכון?\nויקטור?"
  },
  {
    "i": 325,
    "start": "00:19:51.760",
    "end": "00:19:53.880",
    "text": "אם משווים לגלידה שלך אתמול?"
  },
  {
    "i": 326,
    "start": "00:19:54.040",
    "end": "00:19:58.960",
    "text": "אני חושב שהגלידה שלה התמקדה\nבשמנת והייתה קצת כבדה מדי."
  },
  {
    "i": 327,
    "start": "00:19:59.120",
    "end": "00:20:01.760",
    "text": "-על מה התמקדה הגלידה שלך?\n-רעננות מצננת."
  },
  {
    "i": 328,
    "start": "00:20:01.920",
    "end": "00:20:06.760",
    "text": "-נכון.\n-זו הייתה עוגת שמנת."
  },
  {
    "i": 329,
    "start": "00:20:06.920",
    "end": "00:20:12.240",
    "text": "פרסום כוזב, אם כן.\nמה אתה אומר על הקראמבל קרמל, מיקה?"
  },
  {
    "i": 330,
    "start": "00:20:12.400",
    "end": "00:20:18.320",
    "text": "זה היה טעים בטירוף. היא הצליחה\nאת הקרמל הזה, פריך, מקרקש."
  },
  {
    "i": 331,
    "start": "00:20:18.480",
    "end": "00:20:21.320",
    "text": "-מעולה.\n-כיף! והקומפוט?"
  },
  {
    "i": 332,
    "start": "00:20:21.480",
    "end": "00:20:26.000",
    "text": "הוא לא היה מתוק מדי. הייתי רוצה\nטאץ' קטן של ג'ינג'ר, קצת יותר."
  },
  {
    "i": 333,
    "start": "00:20:26.160",
    "end": "00:20:30.960",
    "text": "-אבל אתה לא אוהב ג'ינג'ר.\n-רציתי לחוות קצת יותר ממנו."
  },
  {
    "i": 334,
    "start": "00:20:31.120",
    "end": "00:20:33.280",
    "text": "רק כדי לטעום את השילוב."
  },
  {
    "i": 335,
    "start": "00:20:33.440",
    "end": "00:20:36.480",
    "text": "אני מבינה. מריה, חשבת\nשהקומפוט היה מאוזן?"
  },
  {
    "i": 336,
    "start": "00:20:36.640",
    "end": "00:20:40.280",
    "text": "אולי קצת יותר טעם,\nקצת יותר ג'ינג'ר, קצת יותר בעיטה."
  },
  {
    "i": 337,
    "start": "00:20:40.440",
    "end": "00:20:43.280",
    "text": "-אותו דבר אצלי.\n-זה היה עובד."
  },
  {
    "i": 338,
    "start": "00:20:43.440",
    "end": "00:20:46.920",
    "text": "לחיים ותודה לכם.\nכיף שהייתם כאן."
  },
  {
    "i": 339,
    "start": "00:20:47.080",
    "end": "00:20:50.680",
    "text": "-מריה, איך הייתה האווירה?\n-עליזה ונהדרת."
  },
  {
    "i": 340,
    "start": "00:20:50.840",
    "end": "00:20:55.000",
    "text": "עכשיו הכרנו אחד את השני קצת.\nכיף גדול."
  },
  {
    "i": 341,
    "start": "00:20:55.160",
    "end": "00:20:59.000",
    "text": "ויקטור, אפשר סיכום\nוהנקודות שלך, בבקשה?"
  },
  {
    "i": 342,
    "start": "00:20:59.160",
    "end": "00:21:01.640",
    "text": "היה לי ערב נעים מאוד\nאצל מימי."
  },
  {
    "i": 343,
    "start": "00:21:01.800",
    "end": "00:21:07.080",
    "text": "הגלידה הייתה קצת שמנתית מדי בשבילי."
  },
  {
    "i": 344,
    "start": "00:21:07.240",
    "end": "00:21:10.560",
    "text": "לעומת זאת המנה העיקרית\nהייתה כמו זיקוקים בפה..."
  },
  {
    "i": 345,
    "start": "00:21:10.720",
    "end": "00:21:12.640",
    "text": "ולכן מימי מקבלת שבע."
  },
  {
    "i": 346,
    "start": "00:21:12.800",
    "end": "00:21:15.400",
    "text": "הבנתי. ו-Michael?"
  },
  {
    "i": 347,
    "start": "00:21:15.560",
    "end": "00:21:19.800",
    "text": "אני נותן למימי תשע."
  },
  {
    "i": 348,
    "start": "00:21:19.960",
    "end": "00:21:23.280",
    "text": "אז למימי יש 16 נקודות בריאות\nוהיא צריכה לפחות חמש..."
  },
  {
    "i": 349,
    "start": "00:21:23.440",
    "end": "00:21:26.160",
    "text": "כדי להיות לפני ויקטור.\nמריה, מה זה יהיה?"
  },
  {
    "i": 350,
    "start": "00:21:26.320",
    "end": "00:21:29.600",
    "text": "-שמונה!\n-אז למימי יש 24 נקודות..."
  },
  {
    "i": 351,
    "start": "00:21:29.760",
    "end": "00:21:32.880",
    "text": "ועולה להובלה. אבל נשארו\nעוד שתי ארוחות..."
  },
  {
    "i": 352,
    "start": "00:21:33.040",
    "end": "00:21:38.120",
    "text": "וכל דבר יכול לקרות.\nמחר אנחנו נוסעים אל מיקה."
  },
  {
    "i": 353,
    "start": "00:21:38.280",
    "end": "00:21:39.960",
    "text": "ראיתם?"
  },
  {
    "i": 354,
    "start": "00:21:40.120",
    "end": "00:21:42.720",
    "text": "מיקה מטיף לתפקיד הגולגולת\nבחיי האהבה."
  },
  {
    "i": 355,
    "start": "00:21:42.880",
    "end": "00:21:46.040",
    "text": "אין בחור רומנטי יותר\nממני."
  },
  {
    "i": 356,
    "start": "00:21:46.200",
    "end": "00:21:48.040",
    "text": "ומתגאה בקלפטומניה שלו."
  },
  {
    "i": 357,
    "start": "00:21:48.200",
    "end": "00:21:52.360",
    "text": "אני אוהב לגנוב דברים.\nגונבים קצת פה וקצת שם."
  },
  {
    "i": 358,
    "start": "00:21:52.520",
    "end": "00:21:55.640",
    "text": "ואיך אומרים \"מנחה מעצבן\nבטירוף\" ביפנית?"
  },
  {
    "i": 359,
    "start": "00:21:58.440",
    "end": "00:22:04.760",
    "text": "-ומה המטרה עכשיו?\n-ערב נעים וחמים."
  },
  {
    "i": 360,
    "start": "00:22:04.920",
    "end": "00:22:07.760",
    "text": "כתוביות: פבלו דיאז ברנל\nIyuno"
  }
]