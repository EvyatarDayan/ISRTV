[
  {
    "i": 0,
    "start": "00:00:02.440",
    "end": "00:00:05.160",
    "text": "ב-\"Halv åtta hos mig\"\nמתחרים ארבעה טבחים ביתיים על-"
  },
  {
    "i": 1,
    "start": "00:00:05.320",
    "end": "00:00:08.000",
    "text": "-מי מבשל\nאת ארוחת הערב הכי טעימה."
  },
  {
    "i": 2,
    "start": "00:00:08.160",
    "end": "00:00:12.080",
    "text": "כל שבוע נבחר זוכה חדש.\nברוכים הבאים."
  },
  {
    "i": 3,
    "start": "00:00:26.160",
    "end": "00:00:30.400",
    "text": "תגידו צ'יז כל תושבי פלביגדן\nכי אתם בטלוויזיה."
  },
  {
    "i": 4,
    "start": "00:00:30.560",
    "end": "00:00:34.880",
    "text": "שארכם ברוכים הבאים\nלעיר הגבינות - פלקופינג."
  },
  {
    "i": 5,
    "start": "00:00:35.040",
    "end": "00:00:39.000",
    "text": "עכשיו ספארי גבינות.\nמה זה יכול להיות?"
  },
  {
    "i": 6,
    "start": "00:00:39.160",
    "end": "00:00:42.640",
    "text": "זה חייב להיות ברי."
  },
  {
    "i": 7,
    "start": "00:00:42.800",
    "end": "00:00:46.520",
    "text": "ואז יש לנו סן אגור."
  },
  {
    "i": 8,
    "start": "00:00:46.680",
    "end": "00:00:50.960",
    "text": "את זו אני לא מכירה.\nאשאל משתתף אחר כך."
  },
  {
    "i": 9,
    "start": "00:00:51.120",
    "end": "00:00:55.720",
    "text": "התחלנו אתמול אצל\nכוכב הרוק של פלקופינג, מרקוס."
  },
  {
    "i": 10,
    "start": "00:00:55.880",
    "end": "00:01:01.920",
    "text": "הגישו בין השאר\nטרטר עם לפת כבושה-"
  },
  {
    "i": 11,
    "start": "00:01:02.080",
    "end": "00:01:05.320",
    "text": "-ושניצל חזיר בר Cordon Bleu."
  },
  {
    "i": 12,
    "start": "00:01:05.480",
    "end": "00:01:07.800",
    "text": "בזה ממש הצלחת."
  },
  {
    "i": 13,
    "start": "00:01:07.960",
    "end": "00:01:12.200",
    "text": "מרקוס נחת על 23 נקודות.\nמחר נלך הביתה לאריקה."
  },
  {
    "i": 14,
    "start": "00:01:12.360",
    "end": "00:01:16.360",
    "text": "היא חושפת איך עושים\nכשמתגעגעים הביתה."
  },
  {
    "i": 15,
    "start": "00:01:16.520",
    "end": "00:01:21.480",
    "text": "אני אוהבת דקלים.\nמרגישים שהיא רוצה לספר משהו."
  },
  {
    "i": 16,
    "start": "00:01:21.640",
    "end": "00:01:25.080",
    "text": "האורחים מקבלים קורס ציור."
  },
  {
    "i": 17,
    "start": "00:01:25.240",
    "end": "00:01:28.960",
    "text": "אולי יהיה ברזילאי\nגם לארוחת ערב?"
  },
  {
    "i": 18,
    "start": "00:01:29.120",
    "end": "00:01:34.680",
    "text": "נסיים את השבוע\nאצל השחקנית אידה."
  },
  {
    "i": 19,
    "start": "00:01:34.840",
    "end": "00:01:40.000",
    "text": "שבנוסף לחשיפת\nהעתיד המאיים שלי-"
  },
  {
    "i": 20,
    "start": "00:01:40.160",
    "end": "00:01:45.800",
    "text": "-גם מגישה ארוחת גמר\nשאני לא מתכוונת לחשוף."
  },
  {
    "i": 21,
    "start": "00:01:45.960",
    "end": "00:01:48.480",
    "text": "בחזרה לפרק של היום-"
  },
  {
    "i": 22,
    "start": "00:01:48.640",
    "end": "00:01:52.680",
    "text": "-ולגבינה הזו\nשאני לא מצליחה לפענח."
  },
  {
    "i": 23,
    "start": "00:01:52.840",
    "end": "00:01:56.080",
    "text": "כל אחד רואה,\nגרוייר קלאסי."
  },
  {
    "i": 24,
    "start": "00:01:56.240",
    "end": "00:02:00.280",
    "text": "ענה מארח הערב מגנוס\nקצת בהתנשאות."
  },
  {
    "i": 25,
    "start": "00:02:00.440",
    "end": "00:02:02.960",
    "text": "זה ספארי הגבינות הראשון שלי\nכאן במישור."
  },
  {
    "i": 26,
    "start": "00:02:03.120",
    "end": "00:02:06.480",
    "text": "עכשיו אמרת משהו שאסור להגיד כאן.\nאמרת \"המישור\"."
  },
  {
    "i": 27,
    "start": "00:02:06.640",
    "end": "00:02:09.440",
    "text": "זה הרי לגמרי שטוח כאן."
  },
  {
    "i": 28,
    "start": "00:02:09.600",
    "end": "00:02:13.960",
    "text": "יש הבדל עצום\nבין פלביגדן למישור."
  },
  {
    "i": 29,
    "start": "00:02:14.120",
    "end": "00:02:17.520",
    "text": "בפלביגדן יש פרות,\nבמישור תבואה וחזירים."
  },
  {
    "i": 30,
    "start": "00:02:17.680",
    "end": "00:02:20.520",
    "text": "אני חייבת ללמוד\nלהבדיל בין חזיר לפרה?"
  },
  {
    "i": 31,
    "start": "00:02:20.680",
    "end": "00:02:25.240",
    "text": "-אני באמת אשתדל.\n-אני מאוד מקווה."
  },
  {
    "i": 32,
    "start": "00:02:25.400",
    "end": "00:02:27.520",
    "text": "וזה שם זה אבן."
  },
  {
    "i": 33,
    "start": "00:02:27.680",
    "end": "00:02:31.880",
    "text": "כאן שוכב המלך אינגה.\nכאן הוא נקבר."
  },
  {
    "i": 34,
    "start": "00:02:32.040",
    "end": "00:02:39.400",
    "text": "-מישהו שכדאי להכיר?\n-המלך אינגה היה גבוה להפליא."
  },
  {
    "i": 35,
    "start": "00:02:39.560",
    "end": "00:02:44.480",
    "text": "-הוא יכול להחליף נורות.\n-אשתו נקראה הלנה."
  },
  {
    "i": 36,
    "start": "00:02:44.640",
    "end": "00:02:47.280",
    "text": "-גם שלי כך קוראים.\n-איזה צירוף מקרים."
  },
  {
    "i": 37,
    "start": "00:02:47.440",
    "end": "00:02:49.840",
    "text": "היה לו עוד claim to fame?"
  },
  {
    "i": 38,
    "start": "00:02:50.000",
    "end": "00:02:53.480",
    "text": "הוא החזיר לעצמו את הכס פעמיים."
  },
  {
    "i": 39,
    "start": "00:02:53.640",
    "end": "00:02:58.040",
    "text": "מיומן. כמעט מרגישים\nכאן את כנפי ההיסטוריה."
  },
  {
    "i": 40,
    "start": "00:02:58.200",
    "end": "00:03:03.000",
    "text": "מקומות עם היסטוריה\nואופי חשובים לי מאוד."
  },
  {
    "i": 41,
    "start": "00:03:03.160",
    "end": "00:03:08.080",
    "text": "פאסטיס בלי מים זה חזק.\nאבל איפה גר המלך מגנוס?"
  },
  {
    "i": 42,
    "start": "00:03:08.240",
    "end": "00:03:10.920",
    "text": "היי, אתה כאן? ברוך הבא."
  },
  {
    "i": 43,
    "start": "00:03:11.080",
    "end": "00:03:14.960",
    "text": "הוא בטח שכח\nשדיברנו ממש עכשיו."
  },
  {
    "i": 44,
    "start": "00:03:15.120",
    "end": "00:03:17.080",
    "text": "איזה תחושה מוצקה."
  },
  {
    "i": 45,
    "start": "00:03:17.240",
    "end": "00:03:20.040",
    "text": "תחושת החווה הישנה האותנטית."
  },
  {
    "i": 46,
    "start": "00:03:20.200",
    "end": "00:03:24.920",
    "text": "כאן צריך להיות זהיר.\nשם נכנסתי פעם אחת."
  },
  {
    "i": 47,
    "start": "00:03:25.080",
    "end": "00:03:28.040",
    "text": "איך זה שאתה ואינגה\nנהייתם כל כך גבוהים?"
  },
  {
    "i": 48,
    "start": "00:03:28.200",
    "end": "00:03:32.920",
    "text": "-זה בגנים.\n-שמת את השולחן באמצע הדרך?"
  },
  {
    "i": 49,
    "start": "00:03:33.080",
    "end": "00:03:36.480",
    "text": "זה שולחן אפריקה הקטן שלנו."
  },
  {
    "i": 50,
    "start": "00:03:36.640",
    "end": "00:03:41.200",
    "text": "-אפריקה היא יעד הטיול האהוב?\n-כן, אולי."
  },
  {
    "i": 51,
    "start": "00:03:41.360",
    "end": "00:03:45.360",
    "text": "הייתי שם כמה פעמים,\nיבשת מאוד מיוחדת."
  },
  {
    "i": 52,
    "start": "00:03:45.520",
    "end": "00:03:50.840",
    "text": "אני אוהב את אפריקה\nואת כל האנשים השמחים והחבר'ה."
  },
  {
    "i": 53,
    "start": "00:03:51.000",
    "end": "00:03:54.040",
    "text": "שם הייתה חולצה שמחה ונחמדה."
  },
  {
    "i": 54,
    "start": "00:03:54.200",
    "end": "00:03:58.320",
    "text": "את זו שאני לובש\nאני גאה בה מאוד."
  },
  {
    "i": 55,
    "start": "00:03:58.480",
    "end": "00:04:04.360",
    "text": "היא מזכירה קצת\nאת החצץ האפריקאי."
  },
  {
    "i": 56,
    "start": "00:04:04.520",
    "end": "00:04:07.880",
    "text": "ההיא ישבה כמו כובע בטון\nבבוקר יום ראשון."
  },
  {
    "i": 57,
    "start": "00:04:08.040",
    "end": "00:04:12.880",
    "text": "-מה אתה אוהב בה?\n-את הדפוס."
  },
  {
    "i": 58,
    "start": "00:04:13.040",
    "end": "00:04:16.960",
    "text": "-נתלבש בחזרה?\n-עכשיו נשים שוב את הצהובה."
  },
  {
    "i": 59,
    "start": "00:04:17.120",
    "end": "00:04:20.640",
    "text": "מה עוד מעניין אותך\nחוץ מחולצות אפריקאיות?"
  },
  {
    "i": 60,
    "start": "00:04:20.800",
    "end": "00:04:24.440",
    "text": "כאן המקום האהוב עליי\nבשבתות בשתיים וחצי."
  },
  {
    "i": 61,
    "start": "00:04:24.600",
    "end": "00:04:27.000",
    "text": "עכשיו שבע וחצי ויום שלישי."
  },
  {
    "i": 62,
    "start": "00:04:27.160",
    "end": "00:04:30.000",
    "text": "כש-V75 מתחיל להתחמם."
  },
  {
    "i": 63,
    "start": "00:04:30.160",
    "end": "00:04:34.240",
    "text": "אתה יושב ומתחמם\nכבר ארבעה ימים לפני?"
  },
  {
    "i": 64,
    "start": "00:04:34.400",
    "end": "00:04:38.520",
    "text": "זה אליטלופט כש\nביורן גופ מנצח עם טימוקו."
  },
  {
    "i": 65,
    "start": "00:04:38.680",
    "end": "00:04:40.800",
    "text": "אגדי..."
  },
  {
    "i": 66,
    "start": "00:04:40.960",
    "end": "00:04:43.880",
    "text": "אז עמדתי ביציע שם."
  },
  {
    "i": 67,
    "start": "00:04:44.040",
    "end": "00:04:47.960",
    "text": "אתה צופה במרוצי סוסים ישנים?\nמרגש..."
  },
  {
    "i": 68,
    "start": "00:04:48.120",
    "end": "00:04:53.560",
    "text": "-היו לך סוסים משלך?\n-היו לנו במשפחה."
  },
  {
    "i": 69,
    "start": "00:04:53.720",
    "end": "00:04:55.360",
    "text": "בכמה מגרשים שונים."
  },
  {
    "i": 70,
    "start": "00:04:55.520",
    "end": "00:04:58.480",
    "text": "אפשר למכור את הסוס\nאחרי כמה סיבובים בלבד?"
  },
  {
    "i": 71,
    "start": "00:04:58.640",
    "end": "00:05:01.440",
    "text": "אבל אליטלופט זה העניין, נכון?"
  },
  {
    "i": 72,
    "start": "00:05:01.600",
    "end": "00:05:04.680",
    "text": "פעם בשנה\nאתה נוסע לסולוולה."
  },
  {
    "i": 73,
    "start": "00:05:04.840",
    "end": "00:05:07.360",
    "text": "ככה צריך לעשות\nאם זה מעניין אותך."
  },
  {
    "i": 74,
    "start": "00:05:07.520",
    "end": "00:05:12.160",
    "text": "-קצת כמו אירוויזיון.\n-בשבילי זה משהו אחר לגמרי."
  },
  {
    "i": 75,
    "start": "00:05:12.320",
    "end": "00:05:16.360",
    "text": "עכשיו נצעד החוצה למטבח,\nאבל בלי דהרה."
  },
  {
    "i": 76,
    "start": "00:05:16.520",
    "end": "00:05:18.480",
    "text": "אז נבשל קצת אוכל."
  },
  {
    "i": 77,
    "start": "00:05:18.640",
    "end": "00:05:22.800",
    "text": "מה את חושבת\nעל כישורי הבישול של מגנוס, אידה?"
  },
  {
    "i": 78,
    "start": "00:05:22.960",
    "end": "00:05:25.520",
    "text": "נראה שהוא טוב ברוב הדברים."
  },
  {
    "i": 79,
    "start": "00:05:25.680",
    "end": "00:05:29.920",
    "text": "תראי כשהוא צופה במרוצים\nאו תשמעי כשאקרא את התפריט."
  },
  {
    "i": 80,
    "start": "00:05:34.400",
    "end": "00:05:38.280",
    "text": "זו לא קשת\nשלוקחים איתך לכביש."
  },
  {
    "i": 81,
    "start": "00:05:38.440",
    "end": "00:05:42.400",
    "text": "אני אוהבת שרימפס\nוכוס יין ריזלינג לצידם."
  },
  {
    "i": 82,
    "start": "00:05:42.560",
    "end": "00:05:45.920",
    "text": "שילוב טוב."
  },
  {
    "i": 83,
    "start": "00:05:46.080",
    "end": "00:05:48.680",
    "text": "מה אנחנו חושבים על קשת בצק עלים, אריקה?"
  },
  {
    "i": 84,
    "start": "00:05:48.840",
    "end": "00:05:54.440",
    "text": "זה דג? לא..."
  },
  {
    "i": 85,
    "start": "00:05:54.600",
    "end": "00:05:59.800",
    "text": "-את חושבת על דג קשת?\n-אולי זה לא דג."
  },
  {
    "i": 86,
    "start": "00:05:59.960",
    "end": "00:06:03.840",
    "text": "זה שרימפס עם שרימפס."
  },
  {
    "i": 87,
    "start": "00:06:04.000",
    "end": "00:06:05.880",
    "text": "קצת כמו עוגה על עוגה?"
  },
  {
    "i": 88,
    "start": "00:06:06.040",
    "end": "00:06:09.200",
    "text": "לא נכניס כבר\nאת הדבר הזה פנימה?"
  },
  {
    "i": 89,
    "start": "00:06:09.360",
    "end": "00:06:13.400",
    "text": "אתה יכול להיות כאן קצת. 15 דקות."
  },
  {
    "i": 90,
    "start": "00:06:13.560",
    "end": "00:06:18.920",
    "text": "העבודה שלי היא לדבר.\nתהיה ילד טוב וקצוץ שרימפס."
  },
  {
    "i": 91,
    "start": "00:06:19.080",
    "end": "00:06:24.280",
    "text": "-סלט שרימפס, מרקוס?\n-יש הרבה גרסאות."
  },
  {
    "i": 92,
    "start": "00:06:24.440",
    "end": "00:06:27.080",
    "text": "אבל סלט שרימפס זה סלט שרימפס."
  },
  {
    "i": 93,
    "start": "00:06:27.240",
    "end": "00:06:30.200",
    "text": "איך מזהים אותו לפי הדיאלקט? מה אתם אומרים?"
  },
  {
    "i": 94,
    "start": "00:06:30.360",
    "end": "00:06:34.440",
    "text": "-סלט שרימפס.\n-קצת יותר למעלה."
  },
  {
    "i": 95,
    "start": "00:06:34.600",
    "end": "00:06:37.440",
    "text": "למעלה כאן? סלט שרימפס."
  },
  {
    "i": 96,
    "start": "00:06:37.600",
    "end": "00:06:42.200",
    "text": "-זה נשמע רק כמו 50 מטר למעלה.\n-אני לא שוטרת שפה."
  },
  {
    "i": 97,
    "start": "00:06:42.360",
    "end": "00:06:46.440",
    "text": "אילו מרכיבים יש לנו\nבסלט שרימפס, אידה?"
  },
  {
    "i": 98,
    "start": "00:06:46.600",
    "end": "00:06:52.200",
    "text": "קלאסית זה\nכמעט רק שרימפס ושמנת חמוצה."
  },
  {
    "i": 99,
    "start": "00:06:52.360",
    "end": "00:06:55.160",
    "text": "בצל אדום טעים.\nאפשר לקוות שיש לו את זה."
  },
  {
    "i": 100,
    "start": "00:06:55.320",
    "end": "00:07:01.200",
    "text": "מגנוס אף פעם לא שכח את הבצל כל\nזמן שאני מכירה אותו."
  },
  {
    "i": 101,
    "start": "00:07:01.360",
    "end": "00:07:07.040",
    "text": "-תודה, עשית את זה יפה, מגנוס.\n-תודה גם לך, פטרה."
  },
  {
    "i": 102,
    "start": "00:07:07.200",
    "end": "00:07:09.520",
    "text": "נמשיך למנה העיקרית."
  },
  {
    "i": 103,
    "start": "00:07:15.760",
    "end": "00:07:19.120",
    "text": "-אהבת את זה.\n-My favorite."
  },
  {
    "i": 104,
    "start": "00:07:19.280",
    "end": "00:07:24.680",
    "text": "אידה מקבלת את החלופה הצמחונית\nהמבורגרים צמחיים במקום."
  },
  {
    "i": 105,
    "start": "00:07:24.840",
    "end": "00:07:27.000",
    "text": "כן, אלוהים איזה טעים."
  },
  {
    "i": 106,
    "start": "00:07:27.160",
    "end": "00:07:32.120",
    "text": "-איך הגעת לזה, מגנוס?\n-אני מאוד בעד בשר, תפוחי אדמה."
  },
  {
    "i": 107,
    "start": "00:07:32.280",
    "end": "00:07:36.280",
    "text": "רוטב שמחזק הכול.\nזה קצת הדבר שלי."
  },
  {
    "i": 108,
    "start": "00:07:36.440",
    "end": "00:07:40.400",
    "text": "הדבר שלי הוא שאני אף פעם לא מבינה\nמה זה עוגת תפוחי אדמה."
  },
  {
    "i": 109,
    "start": "00:07:40.560",
    "end": "00:07:46.280",
    "text": "-אתה יודע, מרקוס?\n-עוגת תפוחי אדמה זה תפוחי אדמה דחוסים."
  },
  {
    "i": 110,
    "start": "00:07:46.440",
    "end": "00:07:51.800",
    "text": "שמכניסים לתנור הרבה זמן\nעד שהם רכים ויפים."
  },
  {
    "i": 111,
    "start": "00:07:51.960",
    "end": "00:07:55.760",
    "text": "וגבינה צריכה להיות, איזה סוג?"
  },
  {
    "i": 112,
    "start": "00:07:55.920",
    "end": "00:08:01.320",
    "text": "לעוגה הזו\nתמיד שמתי גבינת וסטרבוטן."
  },
  {
    "i": 113,
    "start": "00:08:01.480",
    "end": "00:08:07.240",
    "text": "זה נותן טעם ומליחות נוספים."
  },
  {
    "i": 114,
    "start": "00:08:07.400",
    "end": "00:08:12.280",
    "text": "זה לא בגידה עליונה להשתמש\nבגבינת וסטרבוטן בפלביגדן?"
  },
  {
    "i": 115,
    "start": "00:08:12.440",
    "end": "00:08:15.040",
    "text": "מה את חושבת על העוגה, אריקה?"
  },
  {
    "i": 116,
    "start": "00:08:15.200",
    "end": "00:08:19.600",
    "text": "אני מקווה\nשעוגת תפוחי האדמה תטעם-"
  },
  {
    "i": 117,
    "start": "00:08:19.760",
    "end": "00:08:22.600",
    "text": "-כמו תפוחי אדמה."
  },
  {
    "i": 118,
    "start": "00:08:22.760",
    "end": "00:08:27.400",
    "text": "-אז היא נכנסת לתנור.\n-ב-1,500 מעלות ליממה."
  },
  {
    "i": 119,
    "start": "00:08:27.560",
    "end": "00:08:30.680",
    "text": "לא, אני מבלבלת את זה\nעם קורס הקדרות."
  },
  {
    "i": 120,
    "start": "00:08:30.840",
    "end": "00:08:35.160",
    "text": "-מאיפה הבשר?\n-מהחקלאי המוכר שלנו..."
  },
  {
    "i": 121,
    "start": "00:08:35.320",
    "end": "00:08:40.360",
    "text": "בפרויארד,...\nאמביורן לנארטסון."
  },
  {
    "i": 122,
    "start": "00:08:40.520",
    "end": "00:08:44.280",
    "text": "-כמה שזה יכול להיות טוב.\n-אמביורן שחט פרה, אריקה."
  },
  {
    "i": 123,
    "start": "00:08:44.440",
    "end": "00:08:47.080",
    "text": "-נשמע נפלא.\n-לא בשביל הפרה."
  },
  {
    "i": 124,
    "start": "00:08:47.240",
    "end": "00:08:52.920",
    "text": "-נוסיף כמה ענפי טימין.\n-ואז לתוך סוויד."
  },
  {
    "i": 125,
    "start": "00:08:53.080",
    "end": "00:08:58.000",
    "text": "-איך אתה מבשל את הסטייק?\n-מתבל במלח ופלפל."
  },
  {
    "i": 126,
    "start": "00:08:58.160",
    "end": "00:09:03.800",
    "text": "מועך שיני שום במחבת\nוצולה בחום גבוה."
  },
  {
    "i": 127,
    "start": "00:09:03.960",
    "end": "00:09:09.160",
    "text": "המתכון למנה הזו ולמנות האחרות\nשל מגנוס תמצאו ב-köket.se."
  },
  {
    "i": 128,
    "start": "00:09:09.320",
    "end": "00:09:13.320",
    "text": "-סיימנו ככה?\n-עד כאן אנחנו על גלגלים."
  },
  {
    "i": 129,
    "start": "00:09:13.480",
    "end": "00:09:16.960",
    "text": "יפה, אז נגלגל הלאה\nלקינוח, מרקוס."
  },
  {
    "i": 130,
    "start": "00:09:21.760",
    "end": "00:09:26.200",
    "text": "-עכשיו עזבנו את פלביגדן.\n-איטלקי."
  },
  {
    "i": 131,
    "start": "00:09:26.360",
    "end": "00:09:30.200",
    "text": "סמיפרדו מזכיר גלידה, לא?"
  },
  {
    "i": 132,
    "start": "00:09:30.360",
    "end": "00:09:35.360",
    "text": "-קשה להכין אותה?\n-צריך קצת קצב."
  },
  {
    "i": 133,
    "start": "00:09:35.520",
    "end": "00:09:40.320",
    "text": "צריך להיות זהירים\nלהפריד חלמונים וחלבונים."
  },
  {
    "i": 134,
    "start": "00:09:40.480",
    "end": "00:09:45.320",
    "text": "-אידה, איך סמיפרדו טעים?\n-בטח זה טעים קצת..."
  },
  {
    "i": 135,
    "start": "00:09:45.480",
    "end": "00:09:49.040",
    "text": "וניל כי יש...\nפטל, אוכמניות ושוקולד לצד."
  },
  {
    "i": 136,
    "start": "00:09:49.200",
    "end": "00:09:54.840",
    "text": "-מה קורה עכשיו?\n-פטרה, עכשיו נקציף שמנת."
  },
  {
    "i": 137,
    "start": "00:09:55.000",
    "end": "00:09:57.360",
    "text": "אני אוהבת את צליל המקצפים החשמליים."
  },
  {
    "i": 138,
    "start": "00:09:57.520",
    "end": "00:10:01.600",
    "text": "מגנוס מערבב את השמנת עם\nהחלמונים והחלבון המוקצף."
  },
  {
    "i": 139,
    "start": "00:10:01.760",
    "end": "00:10:05.160",
    "text": "הוא מוסיף שוקולד מגורר."
  },
  {
    "i": 140,
    "start": "00:10:06.000",
    "end": "00:10:11.720",
    "text": "-לפחות תנסה לפגוע בקערה.\n-זה פשוט עף לי."
  },
  {
    "i": 141,
    "start": "00:10:11.880",
    "end": "00:10:17.120",
    "text": "חוץ משוקולד מגורר\nמגנוס שם פטל."
  },
  {
    "i": 142,
    "start": "00:10:17.280",
    "end": "00:10:20.680",
    "text": "-כמה זמן זה צריך להיות במקפיא?\n-בערך ארבע שעות."
  },
  {
    "i": 143,
    "start": "00:10:20.840",
    "end": "00:10:25.880",
    "text": "-זה בקבוק שמפניה אחר כך.\n-אז זה נהיה כל כך נעים ורך."
  },
  {
    "i": 144,
    "start": "00:10:26.040",
    "end": "00:10:32.040",
    "text": "מזל שזה לא מוגש עכשיו.\nאז זה היה זורם לתוך הזקן."
  },
  {
    "i": 145,
    "start": "00:10:32.200",
    "end": "00:10:37.040",
    "text": "-מרקוס, ציפיות לערב?\n-אוכל טוב וחברה נעימה."
  },
  {
    "i": 146,
    "start": "00:10:37.200",
    "end": "00:10:39.520",
    "text": "אני בעצמי נרגש\nכמו שיח פטל שחור."
  },
  {
    "i": 147,
    "start": "00:10:39.680",
    "end": "00:10:44.520",
    "text": "-אידה?\n-אני סופר נרגשת."
  },
  {
    "i": 148,
    "start": "00:10:44.680",
    "end": "00:10:47.880",
    "text": "-עכשיו האורחים מגיעים בקרוב.\n-עבודה יפה."
  },
  {
    "i": 149,
    "start": "00:10:48.040",
    "end": "00:10:52.480",
    "text": "בהפסקה אלמד את ההבדל\nבין \"מישור\" ל\"אזור כפרי\"."
  },
  {
    "i": 150,
    "start": "00:10:52.640",
    "end": "00:10:55.840",
    "text": "נתראה עוד רגע. ביי בינתיים."
  },
  {
    "i": 151,
    "start": "00:10:56.000",
    "end": "00:11:00.480",
    "text": "האורחים צועדים ישר\nלעבר העבר של מגנוס."
  },
  {
    "i": 152,
    "start": "00:11:00.640",
    "end": "00:11:02.640",
    "text": "אוי, הנה מגנוס."
  },
  {
    "i": 153,
    "start": "00:11:02.800",
    "end": "00:11:06.720",
    "text": "-מגנוס צוחק קצת...\n-זמר החמאה, פוליו אינגלסיאס."
  },
  {
    "i": 154,
    "start": "00:11:06.880",
    "end": "00:11:09.440",
    "text": "הקינוח מנצנץ."
  },
  {
    "i": 155,
    "start": "00:11:09.600",
    "end": "00:11:13.080",
    "text": "הרגיש מאוד חשמלי וטעים."
  },
  {
    "i": 156,
    "start": "00:11:25.520",
    "end": "00:11:29.480",
    "text": "מגיעה ארוחת ערב\nדי רחוק מפלקופינג."
  },
  {
    "i": 157,
    "start": "00:11:29.640",
    "end": "00:11:34.720",
    "text": "האורחים בדרך הביתה\nלמנהל העירייה מגנוס-"
  },
  {
    "i": 158,
    "start": "00:11:34.880",
    "end": "00:11:38.160",
    "text": "-שיראה אם הוא\nהאיש החזק של Halv åtta."
  },
  {
    "i": 159,
    "start": "00:11:38.320",
    "end": "00:11:40.280",
    "text": "איך נשמע הפקק?"
  },
  {
    "i": 160,
    "start": "00:11:40.440",
    "end": "00:11:42.800",
    "text": "בדיוק ככה."
  },
  {
    "i": 161,
    "start": "00:11:42.960",
    "end": "00:11:45.880",
    "text": "-זה מסתדר.\n-ובדיוק בזמן."
  },
  {
    "i": 162,
    "start": "00:11:46.040",
    "end": "00:11:50.680",
    "text": "-עכשיו מגיעים האורחים שלי.\n-או מוכר סלמי."
  },
  {
    "i": 163,
    "start": "00:11:50.840",
    "end": "00:11:55.280",
    "text": "היי וברוכים הבאים!"
  },
  {
    "i": 164,
    "start": "00:11:55.440",
    "end": "00:11:57.440",
    "text": "תראו, גם מתנות."
  },
  {
    "i": 165,
    "start": "00:11:57.600",
    "end": "00:12:02.040",
    "text": "ממש ערב חג מולד,\nאבל בלי טבילה בסיר."
  },
  {
    "i": 166,
    "start": "00:12:02.200",
    "end": "00:12:04.600",
    "text": "מגנוס הכין דברים יותר משובחים."
  },
  {
    "i": 167,
    "start": "00:12:04.760",
    "end": "00:12:06.560",
    "text": "נקח קצת בועות."
  },
  {
    "i": 168,
    "start": "00:12:06.720",
    "end": "00:12:10.880",
    "text": "-לחיים וברוכים הבאים.\n-נעים."
  },
  {
    "i": 169,
    "start": "00:12:12.040",
    "end": "00:12:14.640",
    "text": "אני אלך לסדר קצת במטבח עכשיו."
  },
  {
    "i": 170,
    "start": "00:12:14.800",
    "end": "00:12:19.200",
    "text": "-תשמרו קצת עין.\n-אנחנו שומרים."
  },
  {
    "i": 171,
    "start": "00:12:19.360",
    "end": "00:12:23.120",
    "text": "-מה אתם אומרים?\n-נלך לבדוק, או?"
  },
  {
    "i": 172,
    "start": "00:12:23.280",
    "end": "00:12:27.320",
    "text": "אידה, איך זה להגיע\nרחוק משלטי ה-50?"
  },
  {
    "i": 173,
    "start": "00:12:27.480",
    "end": "00:12:32.320",
    "text": "אני חושבת שאני גרה בכפר,\nאבל זה היה גרוע יותר."
  },
  {
    "i": 174,
    "start": "00:12:32.480",
    "end": "00:12:35.680",
    "text": "אוי ואבוי, אבל מה יש לנו כאן?"
  },
  {
    "i": 175,
    "start": "00:12:35.840",
    "end": "00:12:39.400",
    "text": "סוסים ודברים."
  },
  {
    "i": 176,
    "start": "00:12:39.560",
    "end": "00:12:45.440",
    "text": "-זה היה בלתי צפוי?\n-יש סוסים בפלקופינג."
  },
  {
    "i": 177,
    "start": "00:12:45.600",
    "end": "00:12:50.360",
    "text": "זה לא כל כך שונה,\nאבל דווקא על מגנוס לא ידעתי."
  },
  {
    "i": 178,
    "start": "00:12:50.520",
    "end": "00:12:53.560",
    "text": "תראו, הנה מגנוס."
  },
  {
    "i": 179,
    "start": "00:12:53.720",
    "end": "00:12:56.440",
    "text": "-\"5/4-99.\"\n-\"הבעלים מגנוס.\""
  },
  {
    "i": 180,
    "start": "00:12:56.600",
    "end": "00:13:01.440",
    "text": "-אה, סוס מרוץ.\n-עניין במרוצים."
  },
  {
    "i": 181,
    "start": "00:13:01.600",
    "end": "00:13:03.800",
    "text": "מרקוס, אתה נוהג להמר על טוטו?"
  },
  {
    "i": 182,
    "start": "00:13:03.960",
    "end": "00:13:10.080",
    "text": "הפסדתי איזו מאה קרונות,\nאבל לא יותר מזה."
  },
  {
    "i": 183,
    "start": "00:13:10.240",
    "end": "00:13:13.880",
    "text": "אני בעצמי יודע בדיוק\nכמו שסוס צועד."
  },
  {
    "i": 184,
    "start": "00:13:14.040",
    "end": "00:13:15.840",
    "text": "כיף."
  },
  {
    "i": 185,
    "start": "00:13:16.000",
    "end": "00:13:20.400",
    "text": "נמשיך לצעוד? יש למגנוס עוד צדדים סודיים?"
  },
  {
    "i": 186,
    "start": "00:13:20.560",
    "end": "00:13:26.200",
    "text": "הוא קצת הכול.\nקצת ערמומי, קצת שובב."
  },
  {
    "i": 187,
    "start": "00:13:26.360",
    "end": "00:13:30.120",
    "text": "זה נשמע כמו אוסהניסה. אוסהניסה באפריקה אולי?"
  },
  {
    "i": 188,
    "start": "00:13:30.280",
    "end": "00:13:34.240",
    "text": "העניין שלו באפריקה\nובמערב הודו היה קצת מצחיק."
  },
  {
    "i": 189,
    "start": "00:13:34.400",
    "end": "00:13:36.240",
    "text": "את זה לא ידענו."
  },
  {
    "i": 190,
    "start": "00:13:36.400",
    "end": "00:13:40.400",
    "text": "מגנוס נבחר\nלכובע הקליפה של החודש."
  },
  {
    "i": 191,
    "start": "00:13:40.560",
    "end": "00:13:43.720",
    "text": "-תודו שזה יפה.\n-כן."
  },
  {
    "i": 192,
    "start": "00:13:43.880",
    "end": "00:13:47.040",
    "text": "אולי זה שייך\nלבגדי הבמה של נסטור?"
  },
  {
    "i": 193,
    "start": "00:13:47.200",
    "end": "00:13:51.640",
    "text": "הכול יכול לקרות ביקום של נסטור. נראה."
  },
  {
    "i": 194,
    "start": "00:13:51.800",
    "end": "00:13:54.600",
    "text": "Näver mind the bollocks,\nאבל איך הולך עם האוכל?"
  },
  {
    "i": 195,
    "start": "00:13:54.760",
    "end": "00:13:57.800",
    "text": "האורחים יתחילו לאכול\nאת החולצות האפריקאיות שלך."
  },
  {
    "i": 196,
    "start": "00:13:57.960",
    "end": "00:14:02.640",
    "text": "אני מבין,\nאבל נפתור את זה."
  },
  {
    "i": 197,
    "start": "00:14:02.800",
    "end": "00:14:06.480",
    "text": "איך זה שהאורחים\nממששים את הדברים שלך?"
  },
  {
    "i": 198,
    "start": "00:14:06.640",
    "end": "00:14:09.600",
    "text": "-גם אני מיששתי אצלם.\n-זה נכון."
  },
  {
    "i": 199,
    "start": "00:14:09.760",
    "end": "00:14:13.480",
    "text": "-איך המנה הייתה נקראת כסוס מרוץ?\n-קשת הניצחון."
  },
  {
    "i": 200,
    "start": "00:14:13.640",
    "end": "00:14:16.720",
    "text": "-קשתות הניצחון יצאו טוב?\n-מושלמות."
  },
  {
    "i": 201,
    "start": "00:14:16.880",
    "end": "00:14:23.160",
    "text": "-מה האורחים אומרים על סלט השרימפס?\n-אולי שזה שנות ה-80."
  },
  {
    "i": 202,
    "start": "00:14:23.320",
    "end": "00:14:25.480",
    "text": "-ככה, מוכן.\n-מוכן ושולם."
  },
  {
    "i": 203,
    "start": "00:14:25.640",
    "end": "00:14:29.320",
    "text": "עכשיו מנה ראשונה.\nקשת בצק עלים עם סלט שרימפס."
  },
  {
    "i": 204,
    "start": "00:14:29.480",
    "end": "00:14:32.960",
    "text": "-הנה מנה ראשונה קטנה.\n-אוי, אוי."
  },
  {
    "i": 205,
    "start": "00:14:33.120",
    "end": "00:14:36.560",
    "text": "ברוכים הבאים ובתאבון."
  },
  {
    "i": 206,
    "start": "00:14:36.720",
    "end": "00:14:40.000",
    "text": "עכשיו אני כמובן תוהה...\nאיך זה טעם?"
  },
  {
    "i": 207,
    "start": "00:14:40.160",
    "end": "00:14:44.760",
    "text": "זה היה שילוב טוב.\nהיה קצת קרמי."
  },
  {
    "i": 208,
    "start": "00:14:44.920",
    "end": "00:14:47.520",
    "text": "מסלט השרימפס."
  },
  {
    "i": 209,
    "start": "00:14:47.680",
    "end": "00:14:52.400",
    "text": "ואז קצת פריך מבצק העלים. מושלם."
  },
  {
    "i": 210,
    "start": "00:14:52.560",
    "end": "00:14:55.440",
    "text": "-כיף.\n-יש בזה קצת שנות ה-80."
  },
  {
    "i": 211,
    "start": "00:14:55.600",
    "end": "00:14:58.680",
    "text": "-מאוד טוב.\n-אז מרקוס אוהב את זה."
  },
  {
    "i": 212,
    "start": "00:14:58.840",
    "end": "00:15:02.280",
    "text": "-אני נתקע קצת בדברים ישנים.\n-טעים מאוד."
  },
  {
    "i": 213,
    "start": "00:15:02.440",
    "end": "00:15:06.960",
    "text": "אידה גם מוזמנת לספר\nאיך זה טעם."
  },
  {
    "i": 214,
    "start": "00:15:07.120",
    "end": "00:15:10.480",
    "text": "ממש טעים.\nבדיוק כמו שקיוויתי-"
  },
  {
    "i": 215,
    "start": "00:15:10.640",
    "end": "00:15:14.280",
    "text": "-היה קצת בצל אדום בסלט השרימפס."
  },
  {
    "i": 216,
    "start": "00:15:14.440",
    "end": "00:15:18.720",
    "text": "טבעות בצק עלים פריכות. זה היה סופר."
  },
  {
    "i": 217,
    "start": "00:15:18.880",
    "end": "00:15:21.560",
    "text": "דגת את השרימפסים\nבאגם הורנבורגה?"
  },
  {
    "i": 218,
    "start": "00:15:21.720",
    "end": "00:15:24.160",
    "text": "אז הם לא כל כך יפים."
  },
  {
    "i": 219,
    "start": "00:15:24.320",
    "end": "00:15:27.560",
    "text": "הסלט היה בסדר?"
  },
  {
    "i": 220,
    "start": "00:15:27.720",
    "end": "00:15:33.080",
    "text": "מנה מאוזנת היטב. אהבתי אותה מאוד."
  },
  {
    "i": 221,
    "start": "00:15:33.240",
    "end": "00:15:37.880",
    "text": "מגנוס, יש לך טיפים לסוסים? מה עושים כשסייח מקבל שיהוקים?"
  },
  {
    "i": 222,
    "start": "00:15:38.040",
    "end": "00:15:42.440",
    "text": "אין טעם ללמוד.\nזה כל כך מסובך."
  },
  {
    "i": 223,
    "start": "00:15:42.600",
    "end": "00:15:46.880",
    "text": "כשחושבים שיודעים\nזה בכלל לא עובד."
  },
  {
    "i": 224,
    "start": "00:15:47.040",
    "end": "00:15:51.320",
    "text": "נראה שהמנה הראשונה\nעברה יפה."
  },
  {
    "i": 225,
    "start": "00:15:51.480",
    "end": "00:15:55.360",
    "text": "זה עבד די טוב,\nבערך כמו שחשבתי."
  },
  {
    "i": 226,
    "start": "00:15:55.520",
    "end": "00:16:00.000",
    "text": "-חשבת על המשך?\n-עכשיו המנה העיקרית."
  },
  {
    "i": 227,
    "start": "00:16:00.160",
    "end": "00:16:04.440",
    "text": "עוגת תפוחי האדמה נכנסת לתנור ומקבלת\nחברה של עגבנייה ושעועית ירוקה."
  },
  {
    "i": 228,
    "start": "00:16:04.600",
    "end": "00:16:09.520",
    "text": "שווה לשלם יותר\nעבור בשר מקומי?"
  },
  {
    "i": 229,
    "start": "00:16:09.680",
    "end": "00:16:13.160",
    "text": "כן, אני חושב שזה מרגיש טוב."
  },
  {
    "i": 230,
    "start": "00:16:13.320",
    "end": "00:16:19.000",
    "text": "בשיעורי בישול למדתי\nלא לשים יותר מדי במחבת."
  },
  {
    "i": 231,
    "start": "00:16:19.160",
    "end": "00:16:22.240",
    "text": "זה יותר מדי. אני חושב שאוציא אחד."
  },
  {
    "i": 232,
    "start": "00:16:22.400",
    "end": "00:16:26.440",
    "text": "-לא כל כך כבד במחבת.\n-לא, אז הבשר המבושל..."
  },
  {
    "i": 233,
    "start": "00:16:26.600",
    "end": "00:16:29.360",
    "text": "או יותר נכון הבשר הצלוי יהפוך למבושל."
  },
  {
    "i": 234,
    "start": "00:16:29.520",
    "end": "00:16:32.840",
    "text": "-נראה טוב.\n-זה צריך לנוח קצת תחת נייר אלומיניום?"
  },
  {
    "i": 235,
    "start": "00:16:33.000",
    "end": "00:16:36.960",
    "text": "-זמר החמאה הספרדי.\n-מה?"
  },
  {
    "i": 236,
    "start": "00:16:37.120",
    "end": "00:16:40.080",
    "text": "זמר החמאה הספרדי,\nפוליו אינגלסיאס."
  },
  {
    "i": 237,
    "start": "00:16:40.240",
    "end": "00:16:44.320",
    "text": "לא לבלבל עם\nהשוודי-פיני מרקפוליו..."
  },
  {
    "i": 238,
    "start": "00:16:44.480",
    "end": "00:16:50.760",
    "text": "גם הפילה צריך להיצלו\nכדי לקבל משטח יפה."
  },
  {
    "i": 239,
    "start": "00:16:50.920",
    "end": "00:16:53.880",
    "text": "-איך יצא?\n-ככה זה צריך להיראות."
  },
  {
    "i": 240,
    "start": "00:16:54.040",
    "end": "00:16:57.680",
    "text": "אם הם רוצים יותר עשוי\nשיתגרו בעצמם."
  },
  {
    "i": 241,
    "start": "00:16:57.840",
    "end": "00:17:01.920",
    "text": "לזה מגנוס מגיש רוטב\nעם פלפל ירוק וקוניאק."
  },
  {
    "i": 242,
    "start": "00:17:02.080",
    "end": "00:17:05.400",
    "text": "שעועית ירוקה\nועגבניות גרטין."
  },
  {
    "i": 243,
    "start": "00:17:05.560",
    "end": "00:17:11.720",
    "text": "-אתה חושב שהאורחים יאהבו?\n-אני מקווה."
  },
  {
    "i": 244,
    "start": "00:17:11.880",
    "end": "00:17:16.120",
    "text": "עכשיו סוס מרוץ משומש\nוסטייק."
  },
  {
    "i": 245,
    "start": "00:17:16.280",
    "end": "00:17:21.800",
    "text": "לא, פילה בקר וסטייק עם\nעוגת תפוחי אדמה ורוטב פלפל ירוק."
  },
  {
    "i": 246,
    "start": "00:17:21.960",
    "end": "00:17:25.240",
    "text": "אידה מקבלת המבורגרים צמחיים\nעם גבינת פטה וצ'ילי."
  },
  {
    "i": 247,
    "start": "00:17:25.400",
    "end": "00:17:30.360",
    "text": "-מיוחד בשבילך, אידה.\n-תודה, תודה."
  },
  {
    "i": 248,
    "start": "00:17:30.520",
    "end": "00:17:33.320",
    "text": "-בבקשה.\n-תודה רבה."
  },
  {
    "i": 249,
    "start": "00:17:33.480",
    "end": "00:17:37.440",
    "text": "איך היה הבשר מפלביגדן, אריקה?"
  },
  {
    "i": 250,
    "start": "00:17:37.600",
    "end": "00:17:41.240",
    "text": "-הבשר בושל מושלם.\n-כל כך טוב."
  },
  {
    "i": 251,
    "start": "00:17:41.400",
    "end": "00:17:45.920",
    "text": "-והצלחת הצמחונית?\n-חשבתי על זה, אידה."
  },
  {
    "i": 252,
    "start": "00:17:46.080",
    "end": "00:17:50.120",
    "text": "-נלחמתי קשה עליה.\n-היא יפה להפליא."
  },
  {
    "i": 253,
    "start": "00:17:50.280",
    "end": "00:17:54.920",
    "text": "-מרוצה מההמבורגר הצמחי?\n-קיוויתי ליותר אוכל."
  },
  {
    "i": 254,
    "start": "00:17:55.080",
    "end": "00:17:59.480",
    "text": "לא רק ירקות. זה היה המבורגר מושלם."
  },
  {
    "i": 255,
    "start": "00:17:59.640",
    "end": "00:18:04.400",
    "text": "-גם נסענו לאפריקה.\n-רקדתי ריקוד אפריקאי."
  },
  {
    "i": 256,
    "start": "00:18:04.560",
    "end": "00:18:08.280",
    "text": "-נעשה מסיבה אפריקאית.\n-נעשה את זה."
  },
  {
    "i": 257,
    "start": "00:18:08.440",
    "end": "00:18:12.600",
    "text": "צמחונית שרוקדת\nריקודים אפריקאיים, כל כך בלתי צפוי."
  },
  {
    "i": 258,
    "start": "00:18:12.760",
    "end": "00:18:16.120",
    "text": "רק אל תגידו שבחור הרוק\nרוצה את הבשר מדמם."
  },
  {
    "i": 259,
    "start": "00:18:16.280",
    "end": "00:18:19.840",
    "text": "-מה חשבת, מרקוס?\n-הטעמים היו טובים."
  },
  {
    "i": 260,
    "start": "00:18:20.000",
    "end": "00:18:23.120",
    "text": "-אבל?\n-הבשר יכול היה להיות קצת פחות זמן."
  },
  {
    "i": 261,
    "start": "00:18:23.280",
    "end": "00:18:27.360",
    "text": "בעיקר הסטייק\nהיה די קשה בצלייה."
  },
  {
    "i": 262,
    "start": "00:18:27.520",
    "end": "00:18:30.200",
    "text": "איזה מכיר בני אדם בכל זאת."
  },
  {
    "i": 263,
    "start": "00:18:30.360",
    "end": "00:18:34.520",
    "text": "-מה חשבת בעצמך, מגנוס?\n-מהבשר אני מרוצה לגמרי."
  },
  {
    "i": 264,
    "start": "00:18:34.680",
    "end": "00:18:39.040",
    "text": "יצא כמו שחשבתי. עכשיו קינוח."
  },
  {
    "i": 265,
    "start": "00:18:39.200",
    "end": "00:18:42.600",
    "text": "נוציא את\nהסמיפרדו הביתי שלנו."
  },
  {
    "i": 266,
    "start": "00:18:42.760",
    "end": "00:18:46.560",
    "text": "לחשוב שאנחנו כבר\nבקינוח?"
  },
  {
    "i": 267,
    "start": "00:18:46.720",
    "end": "00:18:50.280",
    "text": "המרוץ האחרון! אני מאמין בזה עכשיו."
  },
  {
    "i": 268,
    "start": "00:18:50.440",
    "end": "00:18:54.080",
    "text": "-אני מרוצה מאוד מעצמי.\n-גם אני."
  },
  {
    "i": 269,
    "start": "00:18:54.240",
    "end": "00:18:58.520",
    "text": "יצא יפהפה למרות שחלק\nמהמרכיבים נפלו לרצפה."
  },
  {
    "i": 270,
    "start": "00:18:58.680",
    "end": "00:19:02.000",
    "text": "כשהכנו את הקינוח\nהשוקולד התחיל לקפוץ."
  },
  {
    "i": 271,
    "start": "00:19:02.160",
    "end": "00:19:07.080",
    "text": "נס כימי. אני עדיין לא מבינה למה."
  },
  {
    "i": 272,
    "start": "00:19:07.240",
    "end": "00:19:11.080",
    "text": "רוח המלך אינגה רצתה\nאולי לשים לך מקלות בגלגלים?"
  },
  {
    "i": 273,
    "start": "00:19:11.240",
    "end": "00:19:15.200",
    "text": "-זה כנראה נגמר עכשיו.\n-לעזאזל."
  },
  {
    "i": 274,
    "start": "00:19:15.360",
    "end": "00:19:22.160",
    "text": "כנראה שלא, אבל נגיעה אחרונה\nלפני ההגשה."
  },
  {
    "i": 275,
    "start": "00:19:22.320",
    "end": "00:19:24.120",
    "text": "ככה, עכשיו מוכן."
  },
  {
    "i": 276,
    "start": "00:19:24.280",
    "end": "00:19:30.400",
    "text": "עכשיו סמיפרדו\nעם פטל, אוכמניות ושוקולד."
  },
  {
    "i": 277,
    "start": "00:19:30.560",
    "end": "00:19:33.520",
    "text": "-תודה, תודה.\n-הסמיפרדו של מגנוס."
  },
  {
    "i": 278,
    "start": "00:19:33.680",
    "end": "00:19:37.200",
    "text": "-בואו נטעם.\n-תודה."
  },
  {
    "i": 279,
    "start": "00:19:37.360",
    "end": "00:19:41.200",
    "text": "היה טוב כמו שחשבנו, אריקה?"
  },
  {
    "i": 280,
    "start": "00:19:41.360",
    "end": "00:19:45.080",
    "text": "היה טעים.\nלא מתוק מדי, לא משעמם מדי."
  },
  {
    "i": 281,
    "start": "00:19:45.240",
    "end": "00:19:47.800",
    "text": "לא קשה מדי..."
  },
  {
    "i": 282,
    "start": "00:19:47.960",
    "end": "00:19:50.840",
    "text": "היה טוב."
  },
  {
    "i": 283,
    "start": "00:19:51.000",
    "end": "00:19:55.120",
    "text": "טעים מאוד.\nהשוקולד הרגיש מאוד-"
  },
  {
    "i": 284,
    "start": "00:19:55.280",
    "end": "00:19:57.720",
    "text": "-חשמלי וטעים."
  },
  {
    "i": 285,
    "start": "00:19:57.880",
    "end": "00:20:01.240",
    "text": "זה כנראה מה\nשקשר את זה קצת."
  },
  {
    "i": 286,
    "start": "00:20:01.400",
    "end": "00:20:03.440",
    "text": "היה בזה קצת הארד רוק."
  },
  {
    "i": 287,
    "start": "00:20:03.600",
    "end": "00:20:10.480",
    "text": "-היית מרוצה, מרקוס?\n-הייתי שם רוטב שוקולד."
  },
  {
    "i": 288,
    "start": "00:20:10.640",
    "end": "00:20:15.880",
    "text": "זה היה נותן טעם יותר שוקולדי\nשהתחתן עם הפטל."
  },
  {
    "i": 289,
    "start": "00:20:16.040",
    "end": "00:20:19.160",
    "text": "כמו כשפנטי התחתן עם טריה."
  },
  {
    "i": 290,
    "start": "00:20:19.320",
    "end": "00:20:23.040",
    "text": "מה חשבת על הקינוח, אידה?"
  },
  {
    "i": 291,
    "start": "00:20:23.200",
    "end": "00:20:26.280",
    "text": "היה בסדר."
  },
  {
    "i": 292,
    "start": "00:20:26.440",
    "end": "00:20:28.880",
    "text": "היה משהו לא בסדר בו?"
  },
  {
    "i": 293,
    "start": "00:20:29.040",
    "end": "00:20:33.360",
    "text": "לא, אני לא מחבבת\nדברים שמכילים ביצים חיים."
  },
  {
    "i": 294,
    "start": "00:20:33.520",
    "end": "00:20:36.120",
    "text": "לא אכלתי כל כך הרבה."
  },
  {
    "i": 295,
    "start": "00:20:36.280",
    "end": "00:20:39.200",
    "text": "חלק חושבים שביצים זה ביצי..."
  },
  {
    "i": 296,
    "start": "00:20:39.360",
    "end": "00:20:43.440",
    "text": "נרים כוסית?\nנטעם את יין הקינוח האיטלקי."
  },
  {
    "i": 297,
    "start": "00:20:43.600",
    "end": "00:20:49.800",
    "text": "תודה שקישטתם\nאת ערב שלישי רגיל הזה."
  },
  {
    "i": 298,
    "start": "00:20:49.960",
    "end": "00:20:51.720",
    "text": "אנחנו אלה שצריכים להודות."
  },
  {
    "i": 299,
    "start": "00:20:51.880",
    "end": "00:20:55.160",
    "text": "אני זה שמודה לכם,\nיקירי פלביגדן."
  },
  {
    "i": 300,
    "start": "00:20:55.320",
    "end": "00:20:59.400",
    "text": "-איך היה הערב?\n-ערב מעולה."
  },
  {
    "i": 301,
    "start": "00:20:59.560",
    "end": "00:21:03.680",
    "text": "-ביי, מגנוס. תודה רבה.\n-נתראה מחר."
  },
  {
    "i": 302,
    "start": "00:21:03.840",
    "end": "00:21:07.600",
    "text": "מרקוס, אפשר קצת נקודות, תודה."
  },
  {
    "i": 303,
    "start": "00:21:07.760",
    "end": "00:21:13.160",
    "text": "המנה הראשונה והקינוח היו\nמעולים. מהבשר קיוויתי ליותר."
  },
  {
    "i": 304,
    "start": "00:21:13.320",
    "end": "00:21:16.600",
    "text": "מגנוס היה מארח מעולה\nאז הוא מקבל שמונה."
  },
  {
    "i": 305,
    "start": "00:21:16.760",
    "end": "00:21:22.040",
    "text": "מה את מסתירה על הברכיים, אריקה?"
  },
  {
    "i": 306,
    "start": "00:21:22.200",
    "end": "00:21:27.360",
    "text": "אז מגנוס צריך עוד שמונה\nכדי לקחת את ההובלה לבד."
  },
  {
    "i": 307,
    "start": "00:21:27.520",
    "end": "00:21:30.080",
    "text": "מה יוצא ממך, אידה?"
  },
  {
    "i": 308,
    "start": "00:21:30.240",
    "end": "00:21:33.080",
    "text": "ממני מגנוס מקבל שבע."
  },
  {
    "i": 309,
    "start": "00:21:33.240",
    "end": "00:21:38.960",
    "text": "מגנוס מסיים על 23 נקודות,\nכמו מרקוס."
  },
  {
    "i": 310,
    "start": "00:21:39.120",
    "end": "00:21:44.640",
    "text": "מחר תור אריקה\nלתת לבנים תחרות."
  },
  {
    "i": 311,
    "start": "00:21:46.160",
    "end": "00:21:50.360",
    "text": "תהיה אווירת קרנבל במטבח."
  },
  {
    "i": 312,
    "start": "00:21:50.520",
    "end": "00:21:54.680",
    "text": "-איך כישורי הירי?\n-לא בדיוק מרטין בק."
  },
  {
    "i": 313,
    "start": "00:21:54.840",
    "end": "00:21:58.720",
    "text": "אידה יודעת איך היא רוצה את הקינוח שלה."
  },
  {
    "i": 314,
    "start": "00:21:58.880",
    "end": "00:22:01.240",
    "text": "שיטעם טעים."
  },
  {
    "i": 315,
    "start": "00:22:01.400",
    "end": "00:22:07.240",
    "text": "אני מרוצה מאוד. עכשיו נעבוד\nכדי שננקה את הדלפק."
  },
  {
    "i": 316,
    "start": "00:22:07.400",
    "end": "00:22:09.840",
    "text": "כתוביות: פטר למפינן\nIyuno"
  }
]