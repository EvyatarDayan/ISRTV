[
  {
    "i": 0,
    "start": "00:00:01.000",
    "end": "00:00:03.040",
    "text": "וואו, איזה יפה יצאת!"
  },
  {
    "i": 1,
    "start": "00:00:03.200",
    "end": "00:00:05.600",
    "text": "זה \"Halv åtta hos mig\"."
  },
  {
    "i": 2,
    "start": "00:00:05.760",
    "end": "00:00:10.200",
    "text": "אתם יודעים, התוכנית שבה ארבעה חבר'ה\nמזמינים זה את זה לארוחת ערב."
  },
  {
    "i": 3,
    "start": "00:00:10.360",
    "end": "00:00:14.880",
    "text": "כל הארוחות מקבלות ניקוד,\nוהניקוד הגבוה ביותר זוכה ב-15,000 קרונות."
  },
  {
    "i": 4,
    "start": "00:00:15.040",
    "end": "00:00:20.200",
    "text": "הבנתם? מעולה!\nכי עכשיו מתחילים את \"Halv åtta hos mig\"!"
  },
  {
    "i": 5,
    "start": "00:00:42.160",
    "end": "00:00:45.120",
    "text": "שלום וברוכים הבאים לסטוקהולם..."
  },
  {
    "i": 6,
    "start": "00:00:45.280",
    "end": "00:00:48.280",
    "text": "שם אנחנו מתחרים בבישול...\nב-\"Halv åtta hos mig\"."
  },
  {
    "i": 7,
    "start": "00:00:48.440",
    "end": "00:00:52.040",
    "text": "תחרות אחרת שנערכה כאן\nהיא אולימפיאדת הרכיבה של 1956..."
  },
  {
    "i": 8,
    "start": "00:00:52.200",
    "end": "00:00:54.600",
    "text": "ושם היו הצלחות גדולות...\nלשוודיה."
  },
  {
    "i": 9,
    "start": "00:00:54.760",
    "end": "00:00:57.080",
    "text": "בין השאר, השלישייה\nעם השמות המפוארים..."
  },
  {
    "i": 10,
    "start": "00:00:57.240",
    "end": "00:00:59.920",
    "text": "Gösta Boltenstern, Henri Saint Cyr...\nו-Janelle Persson..."
  },
  {
    "i": 11,
    "start": "00:01:00.080",
    "end": "00:01:04.920",
    "text": "זכתה בזהב ברכיבת דרסאז', והסוס Illuster...\nזכה בזהב ברכיבת שדה."
  },
  {
    "i": 12,
    "start": "00:01:05.080",
    "end": "00:01:08.960",
    "text": "לסוס Iller דווקא הלך פחות טוב,\nהוא נמכר כבשר להמבורגרים..."
  },
  {
    "i": 13,
    "start": "00:01:09.120",
    "end": "00:01:11.840",
    "text": "אחרי שנתקע במכשול...."
  },
  {
    "i": 14,
    "start": "00:01:12.960",
    "end": "00:01:16.360",
    "text": "השבוע התחלנו\nאצל מתקן הסירות ויקטור..."
  },
  {
    "i": 15,
    "start": "00:01:16.520",
    "end": "00:01:20.440",
    "text": "שהגיש גם שירי גריל...\nוגם בופה גריל אמיתי."
  },
  {
    "i": 16,
    "start": "00:01:20.600",
    "end": "00:01:22.480",
    "text": "זה היה בסדר גמור."
  },
  {
    "i": 17,
    "start": "00:01:22.640",
    "end": "00:01:26.640",
    "text": "האורחים לא התלהבו במיוחד,\nוויקטור נאלץ להסתפק ב-20 נקודות."
  },
  {
    "i": 18,
    "start": "00:01:26.800",
    "end": "00:01:29.280",
    "text": "אתמול זה היה\nמנהלת השיווק Mimmie..."
  },
  {
    "i": 19,
    "start": "00:01:29.440",
    "end": "00:01:32.360",
    "text": "שלא רק הובילה את הסירה שלה...\nאלא גם את ענייני ארוחת הערב."
  },
  {
    "i": 20,
    "start": "00:01:32.520",
    "end": "00:01:34.080",
    "text": "זה די מצחיק."
  },
  {
    "i": 21,
    "start": "00:01:34.240",
    "end": "00:01:37.600",
    "text": "והרכיבה תפריט צמחוני עם\nטרטר אבוקדו ומלפפון..."
  },
  {
    "i": 22,
    "start": "00:01:37.760",
    "end": "00:01:43.480",
    "text": "טאקו תאילנדי וגלידת וניל...\nשהעניקו לה 24 נקודות מלאות."
  },
  {
    "i": 23,
    "start": "00:01:43.640",
    "end": "00:01:46.360",
    "text": "המארחת בגמר היא המוכרת מריה..."
  },
  {
    "i": 24,
    "start": "00:01:46.520",
    "end": "00:01:50.040",
    "text": "שתציג דברים...\nשקרובים ללבה."
  },
  {
    "i": 25,
    "start": "00:01:50.200",
    "end": "00:01:54.000",
    "text": "לא לכולם יש איילה בגובה 2.5 מטר?"
  },
  {
    "i": 26,
    "start": "00:01:54.160",
    "end": "00:02:00.600",
    "text": "היום נסענו לאי האהוב\nעל פריקי הבריאות, לידינגו ליד סטוקהולם."
  },
  {
    "i": 27,
    "start": "00:02:00.760",
    "end": "00:02:04.920",
    "text": "וכאן, בחדר הכושר הפתוח הזה,\nאנחנו מוצאים את מיקה."
  },
  {
    "i": 28,
    "start": "00:02:05.080",
    "end": "00:02:09.040",
    "text": "אוקיי, תוריד את הישבן.\nקדימה. כן, יפה."
  },
  {
    "i": 29,
    "start": "00:02:09.200",
    "end": "00:02:11.880",
    "text": "וקדימה. יוצאים לדרך."
  },
  {
    "i": 30,
    "start": "00:02:12.040",
    "end": "00:02:15.920",
    "text": "איזה מקטרג!\nמה המורל באימונים?"
  },
  {
    "i": 31,
    "start": "00:02:16.080",
    "end": "00:02:17.880",
    "text": "בעצם הוא די בסדר."
  },
  {
    "i": 32,
    "start": "00:02:18.040",
    "end": "00:02:20.120",
    "text": "אני אוהב להתאמן,\nזה ממש כיף."
  },
  {
    "i": 33,
    "start": "00:02:20.280",
    "end": "00:02:24.600",
    "text": "אבל כיף גם להשתולל.\nקשה לי עם חוקים..."
  },
  {
    "i": 34,
    "start": "00:02:24.760",
    "end": "00:02:26.280",
    "text": "אז אני חייב לעשות קצת בעיות...."
  },
  {
    "i": 35,
    "start": "00:02:26.440",
    "end": "00:02:29.120",
    "text": "-אפשר להפסיק?\n-עוד אחד."
  },
  {
    "i": 36,
    "start": "00:02:31.120",
    "end": "00:02:33.240",
    "text": "לא תציג את\nחברת האימונים שלך?"
  },
  {
    "i": 37,
    "start": "00:02:33.400",
    "end": "00:02:36.320",
    "text": "זאת קים, המאמנת האישית שלי."
  },
  {
    "i": 38,
    "start": "00:02:36.480",
    "end": "00:02:41.400",
    "text": "היא זאת שתעשה אותי יפה.\nאו יפה יותר. תליטוש בקצוות."
  },
  {
    "i": 39,
    "start": "00:02:41.560",
    "end": "00:02:44.120",
    "text": "מאמנת אישית משלך? יוקרתי!"
  },
  {
    "i": 40,
    "start": "00:02:44.280",
    "end": "00:02:46.280",
    "text": "קים, איך מיקה כמתאמן?"
  },
  {
    "i": 41,
    "start": "00:02:46.440",
    "end": "00:02:49.920",
    "text": "הוא מקטרג קצת לפעמים\nאבל בכל זאת עושה מה שאני אומרת."
  },
  {
    "i": 42,
    "start": "00:02:51.560",
    "end": "00:02:53.960",
    "text": "-תן לי עוד שלוש עכשיו.\n-עוד שלוש?"
  },
  {
    "i": 43,
    "start": "00:02:54.120",
    "end": "00:02:56.400",
    "text": "למה זה תמיד עוד שלוש?"
  },
  {
    "i": 44,
    "start": "00:02:56.560",
    "end": "00:03:00.240",
    "text": "ככה זה פשוט.\nכמו השילוש הקדוש, Trio me' Bumba..."
  },
  {
    "i": 45,
    "start": "00:03:00.400",
    "end": "00:03:02.120",
    "text": "ושלושת התישים Bruse...."
  },
  {
    "i": 46,
    "start": "00:03:02.280",
    "end": "00:03:07.440",
    "text": "-עבודה טובה. איך מרגיש עכשיו?\n-כמו שצריך. קשה בטירוף."
  },
  {
    "i": 47,
    "start": "00:03:07.600",
    "end": "00:03:09.600",
    "text": "-עבודה טובה, כמו תמיד.\n-Love you."
  },
  {
    "i": 48,
    "start": "00:03:09.760",
    "end": "00:03:13.200",
    "text": "-בהצלחה הערב.\n-נשיקות נשיקות."
  },
  {
    "i": 49,
    "start": "00:03:13.360",
    "end": "00:03:15.480",
    "text": "-נשיקות, נשיקות. ביי.\n-ביי, קים."
  },
  {
    "i": 50,
    "start": "00:03:15.640",
    "end": "00:03:18.240",
    "text": "מיקה, אם מתעלמים\nממה שקורה כשאתה מתאמן..."
  },
  {
    "i": 51,
    "start": "00:03:18.400",
    "end": "00:03:21.680",
    "text": "אתה מקרין המון...\nאנרגיה חיובית."
  },
  {
    "i": 52,
    "start": "00:03:21.840",
    "end": "00:03:23.920",
    "text": "אני עובד על להיות שמח,\nלהשפיע על אנשים..."
  },
  {
    "i": 53,
    "start": "00:03:24.080",
    "end": "00:03:27.640",
    "text": "שיהיו שמחים,...\nשיחשבו שהחיים כיפיים."
  },
  {
    "i": 54,
    "start": "00:03:27.800",
    "end": "00:03:30.200",
    "text": "וכשהשמחה בחיים מגיעה לשיא\nברור..."
  },
  {
    "i": 55,
    "start": "00:03:30.360",
    "end": "00:03:33.280",
    "text": "שמרססים גולגולות...\nעל הבגדים."
  },
  {
    "i": 56,
    "start": "00:03:33.440",
    "end": "00:03:37.240",
    "text": "כן, בדיוק. לא רוצים דברים\nשיש לכולם."
  },
  {
    "i": 57,
    "start": "00:03:37.400",
    "end": "00:03:40.600",
    "text": "אז יוצרים משלך. ומכיוון\nשאני אוהב גולגולות..."
  },
  {
    "i": 58,
    "start": "00:03:40.760",
    "end": "00:03:43.960",
    "text": "ואוהב שרואים אותי,...\nזה הקטע שלי."
  },
  {
    "i": 59,
    "start": "00:03:44.120",
    "end": "00:03:46.000",
    "text": "אהה, זה הקטע שלך?"
  },
  {
    "i": 60,
    "start": "00:03:46.160",
    "end": "00:03:49.280",
    "text": "אז אתה צריך לתבוע את Guns N' Roses\nואת שאר חבורת ההארד רוק..."
  },
  {
    "i": 61,
    "start": "00:03:49.440",
    "end": "00:03:53.240",
    "text": "על הפרת סימן מסחרי. אבל מה...\nהסיפור עם הדפסי הגולגולות?"
  },
  {
    "i": 62,
    "start": "00:03:53.400",
    "end": "00:03:58.360",
    "text": "אולי נראים קצת מסוכנים\nויותר קשוחים."
  },
  {
    "i": 63,
    "start": "00:03:58.520",
    "end": "00:04:01.240",
    "text": "אז אתה לא כזה קשוח\nכמו שאפשר לחשוב?"
  },
  {
    "i": 64,
    "start": "00:04:01.400",
    "end": "00:04:05.240",
    "text": "לא, זה בדיוק הקטע.\nזה הפוך לגמרי."
  },
  {
    "i": 65,
    "start": "00:04:05.400",
    "end": "00:04:09.280",
    "text": "-אני הכי רך.\n-גם רך וגם קשוח."
  },
  {
    "i": 66,
    "start": "00:04:09.440",
    "end": "00:04:14.160",
    "text": "מתאים, אז, שאתה גננת ביום\nובארמן בלילה."
  },
  {
    "i": 67,
    "start": "00:04:14.320",
    "end": "00:04:16.800",
    "text": "כן. גמור, מוכן."
  },
  {
    "i": 68,
    "start": "00:04:16.960",
    "end": "00:04:20.240",
    "text": "חולצות מרוססות טרי\nבריח נפתלין."
  },
  {
    "i": 69,
    "start": "00:04:20.400",
    "end": "00:04:22.800",
    "text": "יותר מגניב מזה אי אפשר להיות."
  },
  {
    "i": 70,
    "start": "00:04:22.960",
    "end": "00:04:26.520",
    "text": "איך גר טיפוס מגניב כזה?\nאולי נציץ קצת?"
  },
  {
    "i": 71,
    "start": "00:04:26.680",
    "end": "00:04:29.560",
    "text": "ברוכים הבאים אליי הביתה.\nכאן אני גר עם בת הזוג שלי."
  },
  {
    "i": 72,
    "start": "00:04:29.720",
    "end": "00:04:32.920",
    "text": "תודה רבה.\nאתם אוהבים חפצים, אני רואה."
  },
  {
    "i": 73,
    "start": "00:04:33.080",
    "end": "00:04:37.880",
    "text": "פרחים, גולגולות.\nהבחורה שלי אוהבת פילים."
  },
  {
    "i": 74,
    "start": "00:04:38.040",
    "end": "00:04:42.720",
    "text": "-לאן הגענו עכשיו?\n-עכשיו אנחנו בקופסת התכשיטים שלי."
  },
  {
    "i": 75,
    "start": "00:04:42.880",
    "end": "00:04:47.040",
    "text": "השרשראות שלי. כמו שאתם יודעים, אני לא\nאוהב שיש לי מה שיש לאחרים."
  },
  {
    "i": 76,
    "start": "00:04:47.200",
    "end": "00:04:49.160",
    "text": "אז אני משנה אותן בעצמי."
  },
  {
    "i": 77,
    "start": "00:04:49.320",
    "end": "00:04:52.240",
    "text": "-יש משהו שאתה יכול להראות?\n-יש לנו את זה."
  },
  {
    "i": 78,
    "start": "00:04:52.400",
    "end": "00:04:56.960",
    "text": "רוסס, סודר. נמצא בשוק פשפשים,\nלא יצקתי בעצמי."
  },
  {
    "i": 79,
    "start": "00:04:57.120",
    "end": "00:04:59.360",
    "text": "-עוד גולגולות.\n-כן, גם כאן יש."
  },
  {
    "i": 80,
    "start": "00:04:59.520",
    "end": "00:05:02.040",
    "text": "-את זאת אני מכיר. זה אני?\n-כן."
  },
  {
    "i": 81,
    "start": "00:05:02.200",
    "end": "00:05:05.600",
    "text": "מספיק עם גולגולות.\nנמשיך הלאה?"
  },
  {
    "i": 82,
    "start": "00:05:05.760",
    "end": "00:05:07.120",
    "text": "כן, קדימה."
  },
  {
    "i": 83,
    "start": "00:05:07.280",
    "end": "00:05:11.160",
    "text": "הנה האוסף הקטן שלי\nשל כדי אפר יפניים."
  },
  {
    "i": 84,
    "start": "00:05:11.320",
    "end": "00:05:14.560",
    "text": "גולגולות ועכשיו כדי אפר?\nלא יהיה בהם אפר, נכון?"
  },
  {
    "i": 85,
    "start": "00:05:14.720",
    "end": "00:05:19.480",
    "text": "אני אוהב סמוראים.\nזה הקשר לכדים."
  },
  {
    "i": 86,
    "start": "00:05:19.640",
    "end": "00:05:23.360",
    "text": "אפר של סמוראים? אז זה בסדר."
  },
  {
    "i": 87,
    "start": "00:05:23.520",
    "end": "00:05:26.120",
    "text": "-זאת תרבות טובה.\n-הגיע הזמן לבחון את הידע שלך."
  },
  {
    "i": 88,
    "start": "00:05:26.280",
    "end": "00:05:30.880",
    "text": "-איך אומרים כד אפר ביפנית?\n-Arigato gozaimasu, מורגן."
  },
  {
    "i": 89,
    "start": "00:05:31.040",
    "end": "00:05:34.680",
    "text": "אממ... זה אומר בערך \"תודה רבה,\nמורגן\" או משהו כזה?"
  },
  {
    "i": 90,
    "start": "00:05:34.840",
    "end": "00:05:37.680",
    "text": "-נתחיל עם האוכל?\n-קדימה."
  },
  {
    "i": 91,
    "start": "00:05:37.840",
    "end": "00:05:40.640",
    "text": "ויקטור, מה אתה אומר על מיקה?\nטיפוס, נכון?"
  },
  {
    "i": 92,
    "start": "00:05:40.800",
    "end": "00:05:46.320",
    "text": "כן, הוא... מקורי.\nאני אוהב אנשים מקוריים."
  },
  {
    "i": 93,
    "start": "00:05:46.480",
    "end": "00:05:49.680",
    "text": "עכשיו נסתכל על התפריט המקורי שלו.\nלמנה ראשונה מוגש..."
  },
  {
    "i": 94,
    "start": "00:05:55.720",
    "end": "00:05:59.600",
    "text": "-מימי, איך זה נשמע?\n-נשמע טעים בטירוף. באמת."
  },
  {
    "i": 95,
    "start": "00:05:59.760",
    "end": "00:06:01.160",
    "text": "משהו מיוחד שתופס אותך?"
  },
  {
    "i": 96,
    "start": "00:06:01.320",
    "end": "00:06:04.080",
    "text": "אני לא מצליחה להגות את השם של\nהשקדים אבל אני אוהבת אותם."
  },
  {
    "i": 97,
    "start": "00:06:04.240",
    "end": "00:06:08.280",
    "text": "קל. מבטאים את זה כמו marketenteri,\nרק קצת אחרת."
  },
  {
    "i": 98,
    "start": "00:06:08.440",
    "end": "00:06:09.920",
    "text": "יש ציפיות."
  },
  {
    "i": 99,
    "start": "00:06:10.080",
    "end": "00:06:12.560",
    "text": "ויקטור, גם לך יש ציפיות?"
  },
  {
    "i": 100,
    "start": "00:06:12.720",
    "end": "00:06:16.560",
    "text": "סלמון ושורטן סלע זה גאוני.\nטעים בטירוף."
  },
  {
    "i": 101,
    "start": "00:06:16.720",
    "end": "00:06:21.960",
    "text": "לעומת זאת סלמון מלוח מרגיש\nיותר כמו חג מולד או פסחא."
  },
  {
    "i": 102,
    "start": "00:06:22.120",
    "end": "00:06:26.200",
    "text": "אבל הוא גאון,\nאז הוא יצליח לעשות את זה."
  },
  {
    "i": 103,
    "start": "00:06:26.360",
    "end": "00:06:28.720",
    "text": "מריה, את חושבת על משהו?"
  },
  {
    "i": 104,
    "start": "00:06:28.880",
    "end": "00:06:31.040",
    "text": "אני סקרנית לגבי רוטב ההולנדייז."
  },
  {
    "i": 105,
    "start": "00:06:31.200",
    "end": "00:06:35.600",
    "text": "אני ממש טובה בלפספס את זה בעצמי,\nכלומר לא בלהכין טוב."
  },
  {
    "i": 106,
    "start": "00:06:35.760",
    "end": "00:06:38.480",
    "text": "אז רוטב הולנדייז טוב\nזה בהחלט משהו שרוצים."
  },
  {
    "i": 107,
    "start": "00:06:38.640",
    "end": "00:06:41.720",
    "text": "מיקה, איך תמנע\nמהרוטב להיחתך?"
  },
  {
    "i": 108,
    "start": "00:06:41.880",
    "end": "00:06:43.920",
    "text": "עכשיו צריך לשים לב לטמפרטורה."
  },
  {
    "i": 109,
    "start": "00:06:44.080",
    "end": "00:06:45.600",
    "text": "-של החמאה או של החלמונים?\n-של שניהם."
  },
  {
    "i": 110,
    "start": "00:06:45.760",
    "end": "00:06:47.720",
    "text": "זה צריך להיות בערך 50 מעלות."
  },
  {
    "i": 111,
    "start": "00:06:47.880",
    "end": "00:06:52.160",
    "text": "ואז צריך לשפוך בזהירות\nולהקציף את החמאה לתוך החלמונים."
  },
  {
    "i": 112,
    "start": "00:06:52.320",
    "end": "00:06:56.200",
    "text": "זה לא קצת מסוכן להכין\nאת הרוטב כל כך הרבה זמן לפני ההגשה?"
  },
  {
    "i": 113,
    "start": "00:06:56.360",
    "end": "00:06:59.840",
    "text": "כן, הבעיה היא\nשהוא יכול להתקלקל."
  },
  {
    "i": 114,
    "start": "00:07:00.000",
    "end": "00:07:02.920",
    "text": "אבל זו לא בעיה.\nמהר להכין עוד אחד."
  },
  {
    "i": 115,
    "start": "00:07:03.080",
    "end": "00:07:08.760",
    "text": "אם זה לא יעבוד נכין\nחדש. אין בעיה."
  },
  {
    "i": 116,
    "start": "00:07:08.920",
    "end": "00:07:13.120",
    "text": "החיים בלי בעיות.\nלא, הם לא."
  },
  {
    "i": 117,
    "start": "00:07:15.840",
    "end": "00:07:19.120",
    "text": "-נו?\n-מדהים."
  },
  {
    "i": 118,
    "start": "00:07:19.280",
    "end": "00:07:21.720",
    "text": "What to say? What to say?"
  },
  {
    "i": 119,
    "start": "00:07:22.960",
    "end": "00:07:27.040",
    "text": "וואו, צ'יפס! זה משמח אותך,\nכשמצליחים במשהו."
  },
  {
    "i": 120,
    "start": "00:07:27.200",
    "end": "00:07:31.800",
    "text": "-אז אתה מרוצה, במילים אחרות?\n-יצא ממש טוב!"
  },
  {
    "i": 121,
    "start": "00:07:31.960",
    "end": "00:07:34.960",
    "text": "ואנחנו מקווים\nשזה יחזיק מעמד עד הערב."
  },
  {
    "i": 122,
    "start": "00:07:35.120",
    "end": "00:07:37.920",
    "text": "ובזה אנחנו עוברים\nלמנה העיקרית. קדימה, מריה."
  },
  {
    "i": 123,
    "start": "00:07:38.080",
    "end": "00:07:41.000",
    "text": "וואו, איזה טעים!"
  },
  {
    "i": 124,
    "start": "00:07:45.400",
    "end": "00:07:48.720",
    "text": "-תגובה ספונטנית?\n-טעים!"
  },
  {
    "i": 125,
    "start": "00:07:48.880",
    "end": "00:07:51.840",
    "text": "-רוצה להרחיב?\n-כן, זה יהיה טוב."
  },
  {
    "i": 126,
    "start": "00:07:52.000",
    "end": "00:07:55.800",
    "text": "אולי לא בהרחבה רבה.\n- מיקה, איך אתה מכין את פילה העגל?"
  },
  {
    "i": 127,
    "start": "00:07:55.960",
    "end": "00:07:59.280",
    "text": "את זה נסגור בחום גבוה\nואז זה נכנס לתנור."
  },
  {
    "i": 128,
    "start": "00:07:59.440",
    "end": "00:08:02.040",
    "text": "-כמה זמן?\n-20-25 דקות."
  },
  {
    "i": 129,
    "start": "00:08:02.200",
    "end": "00:08:04.720",
    "text": "ויקטור, תראה מופתע קלות\nותגיד מה אתה חושב."
  },
  {
    "i": 130,
    "start": "00:08:04.880",
    "end": "00:08:07.000",
    "text": "ממ... את זה אני אוהב."
  },
  {
    "i": 131,
    "start": "00:08:07.160",
    "end": "00:08:10.160",
    "text": "אין לי מושג\nאיך טעים פירה כרובית..."
  },
  {
    "i": 132,
    "start": "00:08:10.320",
    "end": "00:08:13.080",
    "text": "אבל הוא גאון...\nאז זה יהיה מדהים."
  },
  {
    "i": 133,
    "start": "00:08:13.240",
    "end": "00:08:16.280",
    "text": "המחמאות ממשיכות לרדת!\n- מימי?"
  },
  {
    "i": 134,
    "start": "00:08:16.440",
    "end": "00:08:19.360",
    "text": "נשמע טעים בטירוף.\nפירה כרובית זה אחד האהובים."
  },
  {
    "i": 135,
    "start": "00:08:19.520",
    "end": "00:08:22.160",
    "text": "אז את מכירה את זה.\nאיך הוא צריך להיות?"
  },
  {
    "i": 136,
    "start": "00:08:22.320",
    "end": "00:08:27.160",
    "text": "קרמי במידה, שיהיה טעם חזק של כרובית,\nבבקשה..."
  },
  {
    "i": 137,
    "start": "00:08:27.320",
    "end": "00:08:32.160",
    "text": "ומלוח במידה. כדאי גם קצת...\nחתיכות בפנים. זה לא מפריע."
  },
  {
    "i": 138,
    "start": "00:08:32.320",
    "end": "00:08:35.520",
    "text": "מיקה, איך נראה בשבילך\nפירה כרובית מושלם?"
  },
  {
    "i": 139,
    "start": "00:08:35.680",
    "end": "00:08:41.960",
    "text": "אני רוצה אותו די קרמי.\nעכשיו שמים חמאה וקצת שמנת..."
  },
  {
    "i": 140,
    "start": "00:08:42.120",
    "end": "00:08:45.040",
    "text": "גבינת שמנת וחלב...."
  },
  {
    "i": 141,
    "start": "00:08:45.200",
    "end": "00:08:50.440",
    "text": "-הצלחת שוב?\n-הוא מושלם. What to say?"
  },
  {
    "i": 142,
    "start": "00:08:50.600",
    "end": "00:08:53.560",
    "text": "-אם הוא מושלם, מה אתה שופך?\n-קצת שמן כמהין."
  },
  {
    "i": 143,
    "start": "00:08:53.720",
    "end": "00:08:58.880",
    "text": "אלוהים, איזה יוקרתי! עכשיו הוא\nיתפנק במקרר עד ארוחת הערב."
  },
  {
    "i": 144,
    "start": "00:08:59.040",
    "end": "00:09:02.240",
    "text": "ונציץ בקינוח.\nזה יהיה אוכל מלאכים."
  },
  {
    "i": 145,
    "start": "00:09:02.400",
    "end": "00:09:07.680",
    "text": "-נשמע שמימי, מימי?\n-כן, נשמע מדהים."
  },
  {
    "i": 146,
    "start": "00:09:07.840",
    "end": "00:09:13.440",
    "text": "אבל אין לי מושג\nמה זה אומר."
  },
  {
    "i": 147,
    "start": "00:09:13.600",
    "end": "00:09:19.040",
    "text": "אני לא חושבת שזה שוקולד.\nבטח משהו עם וניל."
  },
  {
    "i": 148,
    "start": "00:09:19.200",
    "end": "00:09:23.880",
    "text": "משהו אוורירי אולי.\nאפשר רק לנחש."
  },
  {
    "i": 149,
    "start": "00:09:24.040",
    "end": "00:09:26.840",
    "text": "אולי המתכון האהוב\nעל Christina Schollin."
  },
  {
    "i": 150,
    "start": "00:09:27.000",
    "end": "00:09:30.800",
    "text": "ויקטור, יש לך תיאוריה\nמה זה אוכל מלאכים?"
  },
  {
    "i": 151,
    "start": "00:09:30.960",
    "end": "00:09:36.040",
    "text": "-הר גדול של פרלינים.\n-פרלינים... עוד משהו?"
  },
  {
    "i": 152,
    "start": "00:09:36.200",
    "end": "00:09:43.600",
    "text": "קצת גבינה. משהו שגולש\nעם קצת שוקולד לבן..."
  },
  {
    "i": 153,
    "start": "00:09:43.760",
    "end": "00:09:45.240",
    "text": "זה לא מלאכי?"
  },
  {
    "i": 154,
    "start": "00:09:45.400",
    "end": "00:09:48.440",
    "text": "-שוקולד וגבינה מומסת?\n-כן, וגם פונדו."
  },
  {
    "i": 155,
    "start": "00:09:48.600",
    "end": "00:09:51.040",
    "text": "משהו שפשוט נוזל כדי שאפשר לטבול."
  },
  {
    "i": 156,
    "start": "00:09:51.200",
    "end": "00:09:53.960",
    "text": "אני מאמינה ומקווה שאתה טועה."
  },
  {
    "i": 157,
    "start": "00:09:54.120",
    "end": "00:09:56.600",
    "text": "מיקה, מה זה אוכל מלאכים?"
  },
  {
    "i": 158,
    "start": "00:09:56.760",
    "end": "00:10:01.920",
    "text": "אוכל מלאכים זה המתכון הכי פשוט\nוהכי טעים בעולם."
  },
  {
    "i": 159,
    "start": "00:10:02.080",
    "end": "00:10:04.560",
    "text": "זו קצת גלידת עניים.\nמקציפים שמנת..."
  },
  {
    "i": 160,
    "start": "00:10:04.720",
    "end": "00:10:09.960",
    "text": "משכבים עם פירורי עוגיות, פירות יער לבחירה,...\nאני עושה היום פטל."
  },
  {
    "i": 161,
    "start": "00:10:10.120",
    "end": "00:10:13.760",
    "text": "-על אילו טעמים את מקווה, מריה?\n-מקווה שזה יהיה בטעם קיץ."
  },
  {
    "i": 162,
    "start": "00:10:13.920",
    "end": "00:10:18.360",
    "text": "טעם קיץ בפה.\nכמו גלידה על המזח."
  },
  {
    "i": 163,
    "start": "00:10:18.520",
    "end": "00:10:23.320",
    "text": "נעים, אבל דבר אחד לא פתרנו.\nלמה קוראים לזה אוכל מלאכים?"
  },
  {
    "i": 164,
    "start": "00:10:23.480",
    "end": "00:10:25.520",
    "text": "אני לא יכול לענות על זה.\nשם נחמד."
  },
  {
    "i": 165,
    "start": "00:10:25.680",
    "end": "00:10:29.040",
    "text": "-אוכל מלאכים, כי זה לא אוכל.\n-וזה לא עשוי ממלאכים."
  },
  {
    "i": 166,
    "start": "00:10:29.200",
    "end": "00:10:31.040",
    "text": "לא, אני לא חושבת."
  },
  {
    "i": 167,
    "start": "00:10:31.200",
    "end": "00:10:36.000",
    "text": "-אולי זה אוכל למלאכים?\n-כן. יפה!"
  },
  {
    "i": 168,
    "start": "00:10:36.160",
    "end": "00:10:40.520",
    "text": "תודה רבה, ידידי.\nעכשיו אוכל המלאכים נכנס למקפיא."
  },
  {
    "i": 169,
    "start": "00:10:40.680",
    "end": "00:10:42.200",
    "text": "מימי, איך נשמע התפריט?"
  },
  {
    "i": 170,
    "start": "00:10:42.360",
    "end": "00:10:44.840",
    "text": "המנה הראשונה והעיקרית\nמדהימות."
  },
  {
    "i": 171,
    "start": "00:10:45.000",
    "end": "00:10:48.840",
    "text": "הקינוח היה קצת מסתורי,\nאז זה יהיה מאוד מרתק."
  },
  {
    "i": 172,
    "start": "00:10:49.000",
    "end": "00:10:52.680",
    "text": "כן, עכשיו האורחים יכולים להגיע\nאז אני הולך להתייפות."
  },
  {
    "i": 173,
    "start": "00:10:52.840",
    "end": "00:10:56.600",
    "text": "תן בראש, מיקה. בזמן שאתה עושה את זה\nאנחנו לוקחים הפסקה קטנה."
  },
  {
    "i": 174,
    "start": "00:10:56.760",
    "end": "00:11:00.840",
    "text": "אני שוקל לרסס תמונה\nשל חולצה על הפנים שלי."
  },
  {
    "i": 175,
    "start": "00:11:01.000",
    "end": "00:11:03.360",
    "text": "זה בטח יהיה ייחודי מאוד?"
  },
  {
    "i": 176,
    "start": "00:11:03.520",
    "end": "00:11:07.640",
    "text": "-ברוכים הבאים אליי הביתה.\n-האורחים מתפעלים."
  },
  {
    "i": 177,
    "start": "00:11:07.800",
    "end": "00:11:09.800",
    "text": "וואו... ראיתם?"
  },
  {
    "i": 178,
    "start": "00:11:09.960",
    "end": "00:11:12.200",
    "text": "מה זה שויקטור\nקיבל בצלחת?"
  },
  {
    "i": 179,
    "start": "00:11:12.360",
    "end": "00:11:15.680",
    "text": "זה פשוט התפרק בפה.\nמבפנים החוצה."
  },
  {
    "i": 180,
    "start": "00:11:15.840",
    "end": "00:11:18.360",
    "text": "מבחוץ פנימה? מבפנים החוצה."
  },
  {
    "i": 181,
    "start": "00:11:18.520",
    "end": "00:11:21.680",
    "text": "וזו תהיה אליפות העולם בקלישאות."
  },
  {
    "i": 182,
    "start": "00:11:21.840",
    "end": "00:11:24.760",
    "text": "אם אתם מרוצים, גם אני מרוצה."
  },
  {
    "i": 183,
    "start": "00:11:39.280",
    "end": "00:11:43.320",
    "text": "ברוכים השבים ללידינגו,\nהעירייה עם הכי הרבה טרקטורי EPA..."
  },
  {
    "i": 184,
    "start": "00:11:43.480",
    "end": "00:11:46.120",
    "text": "בכל מחוז סטוקהולם....\nהולכת להיות מסיבה..."
  },
  {
    "i": 185,
    "start": "00:11:46.280",
    "end": "00:11:48.280",
    "text": "אצל הברמן/הגננת מיקה...."
  },
  {
    "i": 186,
    "start": "00:11:48.440",
    "end": "00:11:51.120",
    "text": "איך זה מרגיש עכשיו\nכשהאורחים בדרך?"
  },
  {
    "i": 187,
    "start": "00:11:51.280",
    "end": "00:11:55.160",
    "text": "זה מרגיש מדהים.\nשהם יגיעו אליי הביתה."
  },
  {
    "i": 188,
    "start": "00:11:55.320",
    "end": "00:11:58.040",
    "text": "הם בטח מאושרים מאוד."
  },
  {
    "i": 189,
    "start": "00:11:58.200",
    "end": "00:12:00.160",
    "text": "אם הביטחון העצמי\nמשתקף בתוצאה..."
  },
  {
    "i": 190,
    "start": "00:12:00.320",
    "end": "00:12:03.000",
    "text": "אני בטוח שזה יהיה...\nערב מעולה."
  },
  {
    "i": 191,
    "start": "00:12:03.160",
    "end": "00:12:06.480",
    "text": "הנה האורחים שלנו ויקטור,\nמימי ומריה."
  },
  {
    "i": 192,
    "start": "00:12:06.640",
    "end": "00:12:09.800",
    "text": "היי, ברוכים הבאים!"
  },
  {
    "i": 193,
    "start": "00:12:09.960",
    "end": "00:12:12.560",
    "text": "-היכנסו.\n-היי, איזה כיף!"
  },
  {
    "i": 194,
    "start": "00:12:12.720",
    "end": "00:12:14.520",
    "text": "היי שוב!"
  },
  {
    "i": 195,
    "start": "00:12:14.680",
    "end": "00:12:17.080",
    "text": "-ברוכים הבאים אליי הביתה.\n-לחיים."
  },
  {
    "i": 196,
    "start": "00:12:17.240",
    "end": "00:12:19.120",
    "text": "לחיים לכם, ידידיי."
  },
  {
    "i": 197,
    "start": "00:12:19.280",
    "end": "00:12:22.280",
    "text": "איזה נעים יש לך. מרפסת גדולה."
  },
  {
    "i": 198,
    "start": "00:12:22.440",
    "end": "00:12:24.680",
    "text": "זו לא מרפסת,\nזו דק."
  },
  {
    "i": 199,
    "start": "00:12:24.840",
    "end": "00:12:28.040",
    "text": "-אני פשוט נהנה שם בחוץ.\n-אז למה אנחנו יושבים כאן?"
  },
  {
    "i": 200,
    "start": "00:12:28.200",
    "end": "00:12:31.080",
    "text": "נצא למרפ... לדק.\nאבל לא אתה, מיקה."
  },
  {
    "i": 201,
    "start": "00:12:31.240",
    "end": "00:12:34.080",
    "text": "צעד למטבח, שם\nתזיע בין הסירים..."
  },
  {
    "i": 202,
    "start": "00:12:34.240",
    "end": "00:12:36.440",
    "text": "בזמן שכולנו נהנים...."
  },
  {
    "i": 203,
    "start": "00:12:36.600",
    "end": "00:12:40.720",
    "text": "היא כל כך גדולה!\nוואו, ראיתם?"
  },
  {
    "i": 204,
    "start": "00:12:40.880",
    "end": "00:12:45.440",
    "text": "תראו, ידענו\nשהוא אוהב גולגולות..."
  },
  {
    "i": 205,
    "start": "00:12:45.600",
    "end": "00:12:47.480",
    "text": "הוא משוגע יותר מהמשוגעים."
  },
  {
    "i": 206,
    "start": "00:12:47.640",
    "end": "00:12:50.080",
    "text": "-כמה אתה גמיש, ויקטור?\n-מה זאת אומרת?"
  },
  {
    "i": 207,
    "start": "00:12:50.240",
    "end": "00:12:52.200",
    "text": "לנסות חולצה חדשה."
  },
  {
    "i": 208,
    "start": "00:12:52.360",
    "end": "00:12:55.640",
    "text": "זה תלוי כמה אתה טוב\nבלהלביש ילדים."
  },
  {
    "i": 209,
    "start": "00:12:55.800",
    "end": "00:12:59.880",
    "text": "אני רוצה לדעת כמה מריה\nטובה בלהלביש מבוגר."
  },
  {
    "i": 210,
    "start": "00:13:00.040",
    "end": "00:13:02.240",
    "text": "-וואו, איזה יפה יצאת!\n-כמו פינגווין גותי."
  },
  {
    "i": 211,
    "start": "00:13:02.400",
    "end": "00:13:05.920",
    "text": "תשים שרשרת ונשלים\nאת הלוק."
  },
  {
    "i": 212,
    "start": "00:13:06.080",
    "end": "00:13:09.040",
    "text": "-אתה מוכן?\n-איך התחושה?"
  },
  {
    "i": 213,
    "start": "00:13:09.200",
    "end": "00:13:10.880",
    "text": "צפוף."
  },
  {
    "i": 214,
    "start": "00:13:11.040",
    "end": "00:13:14.440",
    "text": "-זה קצת הדוק מדי?\n-כן, וחסרים שרוולים."
  },
  {
    "i": 215,
    "start": "00:13:14.600",
    "end": "00:13:17.760",
    "text": "-הרגשתי כלוא.\n-בעצם היו לה שרוולים."
  },
  {
    "i": 216,
    "start": "00:13:17.920",
    "end": "00:13:21.480",
    "text": "פספסתי אותם? הלבישו אותי..."
  },
  {
    "i": 217,
    "start": "00:13:21.640",
    "end": "00:13:24.480",
    "text": "אז לא היה לי הרבה...\nמה להגיד."
  },
  {
    "i": 218,
    "start": "00:13:24.640",
    "end": "00:13:27.280",
    "text": "מקווה שמריה הייתה טובה יותר\nבלהלביש את הילדים שלה."
  },
  {
    "i": 219,
    "start": "00:13:27.440",
    "end": "00:13:31.200",
    "text": "-ויקטור, משהו נוסף שאתה רוצה עכשיו?\n-עזרה."
  },
  {
    "i": 220,
    "start": "00:13:31.360",
    "end": "00:13:33.160",
    "text": "-אני לא מתקדם לשום מקום.\n-יאללה."
  },
  {
    "i": 221,
    "start": "00:13:33.320",
    "end": "00:13:37.200",
    "text": "-מאמץ צוותי.\n-ככה, נוריד את זה."
  },
  {
    "i": 222,
    "start": "00:13:37.360",
    "end": "00:13:40.760",
    "text": "-מה עוד כיף יש כאן בחוץ?\n-אני תלוי בך."
  },
  {
    "i": 223,
    "start": "00:13:40.920",
    "end": "00:13:44.480",
    "text": "-מה יש לנו כאן?\n-יש שם כזה..."
  },
  {
    "i": 224,
    "start": "00:13:44.640",
    "end": "00:13:46.680",
    "text": "-את, קוראים לזה את?\n-בדיוק!"
  },
  {
    "i": 225,
    "start": "00:13:46.840",
    "end": "00:13:49.320",
    "text": "אתם באמת מכירים את הכלים."
  },
  {
    "i": 226,
    "start": "00:13:49.480",
    "end": "00:13:54.280",
    "text": "את, מספריים, פרחים ואדמה.\nזה אומר לשים בפנים."
  },
  {
    "i": 227,
    "start": "00:13:54.440",
    "end": "00:13:57.200",
    "text": "או מה שאנחנו בשטח קוראים\nלזה לשתול."
  },
  {
    "i": 228,
    "start": "00:13:57.360",
    "end": "00:14:01.360",
    "text": "-אפשר פשוט להתחיל קצת?\n-זה התפקיד הראשי."
  },
  {
    "i": 229,
    "start": "00:14:01.520",
    "end": "00:14:06.400",
    "text": "אז אני לוקח כזה. ככה."
  },
  {
    "i": 230,
    "start": "00:14:06.560",
    "end": "00:14:08.680",
    "text": "אתה צריך להכניס קצת אור לעניין."
  },
  {
    "i": 231,
    "start": "00:14:08.840",
    "end": "00:14:12.120",
    "text": "-ויקטור, אתה לא תחפור?\n-אני מנהל הפרויקט."
  },
  {
    "i": 232,
    "start": "00:14:12.280",
    "end": "00:14:16.520",
    "text": "-אני אוהב איך שאתה חושב.\n-הצד שלי כבר כמעט גמור."
  },
  {
    "i": 233,
    "start": "00:14:16.680",
    "end": "00:14:19.720",
    "text": "-עבודה טובה!\n-אני ממש גאה בכם."
  },
  {
    "i": 234,
    "start": "00:14:19.880",
    "end": "00:14:23.000",
    "text": "כן, לא כל אחד יכול לגרום\nלפילי בד לנבוט."
  },
  {
    "i": 235,
    "start": "00:14:23.160",
    "end": "00:14:26.400",
    "text": "תן חמש. אולי אפילו נוכל להיכנס\nולהתחמם."
  },
  {
    "i": 236,
    "start": "00:14:26.560",
    "end": "00:14:30.000",
    "text": "נשמע כמו רעיון טוב.\nאני מתחמק למטבח."
  },
  {
    "i": 237,
    "start": "00:14:30.160",
    "end": "00:14:34.480",
    "text": "היי, מיקה! אוי אוי אוי, סליחה.\nהבהלתי אותך עכשיו?"
  },
  {
    "i": 238,
    "start": "00:14:34.640",
    "end": "00:14:36.400",
    "text": "-כן.\n-סליחה."
  },
  {
    "i": 239,
    "start": "00:14:36.560",
    "end": "00:14:39.000",
    "text": "-זה נהיה אסון?\n-יש לי עוד."
  },
  {
    "i": 240,
    "start": "00:14:39.160",
    "end": "00:14:41.840",
    "text": "אלוהים, איזה יופי!\nסליחה, אני אשתוק."
  },
  {
    "i": 241,
    "start": "00:14:42.000",
    "end": "00:14:45.920",
    "text": "אם אתם רוצים לדעת איך מבשלים את האספרגוס,\nבקרו ב-köket.se."
  },
  {
    "i": 242,
    "start": "00:14:46.080",
    "end": "00:14:48.520",
    "text": "לעומת זאת לא כתוב\nאיך מולחים את הסלמון..."
  },
  {
    "i": 243,
    "start": "00:14:48.680",
    "end": "00:14:52.080",
    "text": "או איך קולים את שקדי המרקונה...\nכי הם קנויים מוכנים."
  },
  {
    "i": 244,
    "start": "00:14:52.240",
    "end": "00:14:55.560",
    "text": "-עכשיו אני מוכן להגיש.\n-יופי! למנה ראשונה:"
  },
  {
    "i": 245,
    "start": "00:14:55.720",
    "end": "00:14:58.600",
    "text": "אספרגוס לבן ברוטב הולנדייז\nועם שקדי מרקונה..."
  },
  {
    "i": 246,
    "start": "00:14:58.760",
    "end": "00:15:01.000",
    "text": "מעליהם סלמון מלוח...\nושורטן סלע."
  },
  {
    "i": 247,
    "start": "00:15:01.160",
    "end": "00:15:04.520",
    "text": "וואו, נהדר!"
  },
  {
    "i": 248,
    "start": "00:15:04.680",
    "end": "00:15:07.240",
    "text": "כן, תשמעו.\nאני מקווה שיהיה טעים."
  },
  {
    "i": 249,
    "start": "00:15:07.400",
    "end": "00:15:09.520",
    "text": "זה נראה טעים מאוד."
  },
  {
    "i": 250,
    "start": "00:15:10.960",
    "end": "00:15:13.640",
    "text": "עכשיו אני רוצה לשמוע\nאיך זה בדרך כלל נשמע בלידינגו..."
  },
  {
    "i": 251,
    "start": "00:15:13.800",
    "end": "00:15:16.600",
    "text": "ביום רביעי רגיל בערב....\nבתיאבון."
  },
  {
    "i": 252,
    "start": "00:15:16.760",
    "end": "00:15:20.920",
    "text": "האספרגוס היה ממש מושלם.\nטעים מאוד."
  },
  {
    "i": 253,
    "start": "00:15:21.080",
    "end": "00:15:27.320",
    "text": "-אבל מבושל עד הסוף.\n-עדיף קשה מדי מאשר רך מדי."
  },
  {
    "i": 254,
    "start": "00:15:27.480",
    "end": "00:15:30.080",
    "text": "ואנחנו מדברים על אספרגוס.\n- מריה, תמשיכי."
  },
  {
    "i": 255,
    "start": "00:15:30.240",
    "end": "00:15:33.000",
    "text": "-האספרגוס היה נעים מאוד.\n-והשאר?"
  },
  {
    "i": 256,
    "start": "00:15:33.160",
    "end": "00:15:35.360",
    "text": "-אני אוהבת שקדי מרקונה.\n-נהדר."
  },
  {
    "i": 257,
    "start": "00:15:35.520",
    "end": "00:15:39.840",
    "text": "אבל אולי לא חשבתי שהם\nמתאימים כל כך לאספרגוס."
  },
  {
    "i": 258,
    "start": "00:15:40.000",
    "end": "00:15:43.080",
    "text": "אוי. - ויקטור, מה חשבת\nעל המנה הראשונה?"
  },
  {
    "i": 259,
    "start": "00:15:43.240",
    "end": "00:15:47.200",
    "text": "-זה לא היה לגמרי לטעמי.\n-למה?"
  },
  {
    "i": 260,
    "start": "00:15:47.360",
    "end": "00:15:51.040",
    "text": "חשבתי שאני אוהב אספרגוס,\nאבל זה יצא יותר מדי אספרגוס."
  },
  {
    "i": 261,
    "start": "00:15:51.200",
    "end": "00:15:54.760",
    "text": "כנראה הייתי צריך קצת יותר סלמון\nאו משהו."
  },
  {
    "i": 262,
    "start": "00:15:54.920",
    "end": "00:15:58.480",
    "text": "אז הסלמון לא הרגיש\nיותר מדי פסחאי או חגיגי?"
  },
  {
    "i": 263,
    "start": "00:15:58.640",
    "end": "00:16:02.400",
    "text": "לא, הוא היה נעים."
  },
  {
    "i": 264,
    "start": "00:16:02.560",
    "end": "00:16:07.200",
    "text": "זה היה קומבו טעים להפליא.\nטעים בטירוף באמת."
  },
  {
    "i": 265,
    "start": "00:16:07.360",
    "end": "00:16:09.640",
    "text": "מימי, נראה שאהבת את זה."
  },
  {
    "i": 266,
    "start": "00:16:09.800",
    "end": "00:16:14.720",
    "text": "המנה הראשונה הייתה קצת more is more,\nדברים טובים."
  },
  {
    "i": 267,
    "start": "00:16:14.880",
    "end": "00:16:19.120",
    "text": "השקדים האלה, מדהים.\nכמו שאמרתי, more is more."
  },
  {
    "i": 268,
    "start": "00:16:19.280",
    "end": "00:16:22.040",
    "text": "-וזה היה טעים.\n-יופי. המנה הראשונה הסתיימה."
  },
  {
    "i": 269,
    "start": "00:16:22.200",
    "end": "00:16:25.560",
    "text": "אני חושב שהאורחים רעבים\nלמנה עיקרית. מיקה, אתה מוכן?"
  },
  {
    "i": 270,
    "start": "00:16:25.720",
    "end": "00:16:29.240",
    "text": "-כן, אני מסדר.\n-יופי."
  },
  {
    "i": 271,
    "start": "00:16:30.920",
    "end": "00:16:36.000",
    "text": "-מה אתה אומר על דרגת הצלייה?\n-זה נראה אדיר."
  },
  {
    "i": 272,
    "start": "00:16:36.160",
    "end": "00:16:38.560",
    "text": "אז נשאר רק להגיש."
  },
  {
    "i": 273,
    "start": "00:16:38.720",
    "end": "00:16:44.520",
    "text": "פירה כרובית, רוטב גבינה מ-taleggio,\nגבינה כחולה, שמנת וחלב."
  },
  {
    "i": 274,
    "start": "00:16:44.680",
    "end": "00:16:51.320",
    "text": "-ועוד סלט מעורב קטן.\n-ככה. הגיע הזמן להגיש את המנה העיקרית."
  },
  {
    "i": 275,
    "start": "00:16:51.480",
    "end": "00:16:53.400",
    "text": "Go for it, man! למנה עיקרית:"
  },
  {
    "i": 276,
    "start": "00:16:53.560",
    "end": "00:16:57.960",
    "text": "פילה עגל ופירה כרובית, מוגש\nעם רוטב taleggio וגבינה כחולה."
  },
  {
    "i": 277,
    "start": "00:16:58.120",
    "end": "00:17:03.080",
    "text": "-אני מקווה שיהיה טעים.\n-אז נוכל להמשיך בקורס:"
  },
  {
    "i": 278,
    "start": "00:17:03.240",
    "end": "00:17:05.200",
    "text": "\"שיחה בלידינגו.\""
  },
  {
    "i": 279,
    "start": "00:17:05.360",
    "end": "00:17:11.520",
    "text": "-הבשר מושלם. זה כל כך טעים.\n-כן, זה באמת טוב מאוד."
  },
  {
    "i": 280,
    "start": "00:17:11.680",
    "end": "00:17:14.600",
    "text": "-ספר עוד על העגל, ויקטור.\n-הוא היה קסום."
  },
  {
    "i": 281,
    "start": "00:17:14.760",
    "end": "00:17:19.120",
    "text": "זה פשוט התפרק בפה.\nבאמת טעים, מבפנים החוצה."
  },
  {
    "i": 282,
    "start": "00:17:19.280",
    "end": "00:17:21.240",
    "text": "מבחוץ פנימה? מבפנים החוצה."
  },
  {
    "i": 283,
    "start": "00:17:21.400",
    "end": "00:17:23.360",
    "text": "כלומר כל הפילה."
  },
  {
    "i": 284,
    "start": "00:17:23.520",
    "end": "00:17:28.480",
    "text": "גם למדתי שכרובית\nלא הייתה המרכיב המרכזי שלי."
  },
  {
    "i": 285,
    "start": "00:17:28.640",
    "end": "00:17:30.760",
    "text": "למה לא?"
  },
  {
    "i": 286,
    "start": "00:17:30.920",
    "end": "00:17:35.240",
    "text": "-אני כנראה מעדיף את הכרובית שלמה.\n-אני מבין."
  },
  {
    "i": 287,
    "start": "00:17:35.400",
    "end": "00:17:40.560",
    "text": "-מריה, מה את אומרת על המנה העיקרית?\n-איזה בשר! זה היה מושלם."
  },
  {
    "i": 288,
    "start": "00:17:40.720",
    "end": "00:17:45.520",
    "text": "זה היה כל כך רך ועדין.\nזה היה טעים מאוד."
  },
  {
    "i": 289,
    "start": "00:17:45.680",
    "end": "00:17:47.720",
    "text": "-טעים מאוד!\n-הכרובית."
  },
  {
    "i": 290,
    "start": "00:17:47.880",
    "end": "00:17:52.440",
    "text": "ובמקום פירה תפוחי אדמה, זה\nיוצא קצת יותר אוורירי וטרי."
  },
  {
    "i": 291,
    "start": "00:17:52.600",
    "end": "00:17:55.760",
    "text": "כן, כרובית היא אולי\nהכרוב הכי טוב."
  },
  {
    "i": 292,
    "start": "00:17:55.920",
    "end": "00:17:59.600",
    "text": "אפשר לפרש את זה שהמנה העיקרית\nהייתה טעימה מאוד, מימי?"
  },
  {
    "i": 293,
    "start": "00:17:59.760",
    "end": "00:18:03.880",
    "text": "כן, המנה העיקרית הייתה באמת\nלטעמי."
  },
  {
    "i": 294,
    "start": "00:18:04.040",
    "end": "00:18:08.680",
    "text": "פירה הכרובית טעים בטירוף.\nהיו בו חתיכות קטנות."
  },
  {
    "i": 295,
    "start": "00:18:08.840",
    "end": "00:18:11.880",
    "text": "והרוטב היה גם טעים מאוד."
  },
  {
    "i": 296,
    "start": "00:18:12.040",
    "end": "00:18:15.760",
    "text": "מקווה שתהיה מרוצה\nמערוגת הפרחים שלנו."
  },
  {
    "i": 297,
    "start": "00:18:15.920",
    "end": "00:18:18.800",
    "text": "אם אתם מרוצים, גם אני מרוצה."
  },
  {
    "i": 298,
    "start": "00:18:18.960",
    "end": "00:18:21.280",
    "text": "אתם משאירים לי זיכרון."
  },
  {
    "i": 299,
    "start": "00:18:21.440",
    "end": "00:18:25.520",
    "text": "בכל פעם שאסתכל על זה,\nאחשוב עליכם."
  },
  {
    "i": 300,
    "start": "00:18:25.680",
    "end": "00:18:28.240",
    "text": "-על זה אני חושב שכדאי לשתות.\n-לחיים."
  },
  {
    "i": 301,
    "start": "00:18:28.400",
    "end": "00:18:31.720",
    "text": "עכשיו נשאר לראות אם הקינוח\nיהיה גם משהו לספרי הזיכרונות."
  },
  {
    "i": 302,
    "start": "00:18:31.880",
    "end": "00:18:34.360",
    "text": "והוא כבר כמעט מוכן,\nנכון?"
  },
  {
    "i": 303,
    "start": "00:18:34.520",
    "end": "00:18:39.760",
    "text": "עכשיו רק נוסיף עוד\nקצת פירורי עוגיות."
  },
  {
    "i": 304,
    "start": "00:18:39.920",
    "end": "00:18:42.360",
    "text": "זה באמת נראה מלאכי.\nתראו כמה יפה."
  },
  {
    "i": 305,
    "start": "00:18:42.520",
    "end": "00:18:45.640",
    "text": "-מקווה שיאהבו את זה.\n-בהצלחה, ידידי."
  },
  {
    "i": 306,
    "start": "00:18:45.800",
    "end": "00:18:49.600",
    "text": "לקינוח, אוכל מלאכים."
  },
  {
    "i": 307,
    "start": "00:18:53.360",
    "end": "00:18:55.080",
    "text": "אז איך זה טעים?"
  },
  {
    "i": 308,
    "start": "00:18:55.240",
    "end": "00:18:58.920",
    "text": "אני אוהבת את החמיצות של פירות היער."
  },
  {
    "i": 309,
    "start": "00:18:59.080",
    "end": "00:19:01.360",
    "text": "אלה סתם פטל רגיל\nבלי סוכר."
  },
  {
    "i": 310,
    "start": "00:19:02.480",
    "end": "00:19:04.960",
    "text": "-לא כתוב ריבה?\n-לא."
  },
  {
    "i": 311,
    "start": "00:19:06.040",
    "end": "00:19:09.320",
    "text": "-ריבה...\n-מורגן אמר ריבה."
  },
  {
    "i": 312,
    "start": "00:19:09.480",
    "end": "00:19:11.360",
    "text": "אז נלחצתי."
  },
  {
    "i": 313,
    "start": "00:19:11.520",
    "end": "00:19:17.800",
    "text": "כי חשבתי שעכשיו זה יהיה מתוק.\nאבל זה היה קסום."
  },
  {
    "i": 314,
    "start": "00:19:17.960",
    "end": "00:19:20.040",
    "text": "איזה איזון בכל העניין."
  },
  {
    "i": 315,
    "start": "00:19:20.200",
    "end": "00:19:23.280",
    "text": "זה הרגיש טרי יותר."
  },
  {
    "i": 316,
    "start": "00:19:23.440",
    "end": "00:19:25.000",
    "text": "אני לא אמרתי ריבה, נכון?"
  },
  {
    "i": 317,
    "start": "00:19:25.160",
    "end": "00:19:27.680",
    "text": "אבל כן אמרת פרלינים עם גבינה,\nשוקולד לבן ופונדו."
  },
  {
    "i": 318,
    "start": "00:19:27.840",
    "end": "00:19:30.760",
    "text": "אבל יצא פטל לא ממותק\nושמנת. מאוכזב?"
  },
  {
    "i": 319,
    "start": "00:19:30.920",
    "end": "00:19:34.720",
    "text": "לא, זה היה מהלך ממש טוב.\nוזה היה פשוט."
  },
  {
    "i": 320,
    "start": "00:19:34.880",
    "end": "00:19:40.880",
    "text": "שמנת, פטל, עוגיות. מושלם."
  },
  {
    "i": 321,
    "start": "00:19:41.040",
    "end": "00:19:44.840",
    "text": "חשבתי שזה מרגיש ממש אתה."
  },
  {
    "i": 322,
    "start": "00:19:45.000",
    "end": "00:19:49.000",
    "text": "כי במקרה אני יודע שאתה\nמעריץ גדול של עוגיות."
  },
  {
    "i": 323,
    "start": "00:19:49.160",
    "end": "00:19:53.760",
    "text": "כן, אני אוכל קופסה שלמה של עוגיות\nכל ערב."
  },
  {
    "i": 324,
    "start": "00:19:53.920",
    "end": "00:19:55.840",
    "text": "-ואז אתה נרדם?\n-לא."
  },
  {
    "i": 325,
    "start": "00:19:56.000",
    "end": "00:20:01.000",
    "text": "העוגיות ואני מתאימים\nכל כך טוב."
  },
  {
    "i": 326,
    "start": "00:20:01.160",
    "end": "00:20:03.920",
    "text": "אז זה מפחיד."
  },
  {
    "i": 327,
    "start": "00:20:04.080",
    "end": "00:20:07.360",
    "text": "אני מוציא את רוב הכסף על עוגיות."
  },
  {
    "i": 328,
    "start": "00:20:07.520",
    "end": "00:20:11.160",
    "text": "הכי הרבה בצק על עוגיות, זה היה טוב!"
  },
  {
    "i": 329,
    "start": "00:20:11.320",
    "end": "00:20:14.920",
    "text": "מימי, מה את אומרת על הקינוח\nשל מפלצת העוגיות?"
  },
  {
    "i": 330,
    "start": "00:20:15.080",
    "end": "00:20:17.800",
    "text": "אני לא כזאת מעריצה גדולה\nשל שמנת."
  },
  {
    "i": 331,
    "start": "00:20:17.960",
    "end": "00:20:24.720",
    "text": "ועוגיות זה בסדר, אבל אני גם לא\nאוהבת עוגיות כמו מיקה."
  },
  {
    "i": 332,
    "start": "00:20:24.880",
    "end": "00:20:30.320",
    "text": "אני חושבת שהיה טעים,\nאבל בשבילי זה לא היה חלום."
  },
  {
    "i": 333,
    "start": "00:20:30.480",
    "end": "00:20:33.240",
    "text": "אני רוצה להרים כוסית\nלארוחת הערב היום."
  },
  {
    "i": 334,
    "start": "00:20:33.400",
    "end": "00:20:35.960",
    "text": "תודה רבה. נעים שאתם כאן."
  },
  {
    "i": 335,
    "start": "00:20:36.120",
    "end": "00:20:39.120",
    "text": "היה נעים מאוד להיות כאן.\nתודה. לחיים."
  },
  {
    "i": 336,
    "start": "00:20:39.280",
    "end": "00:20:42.880",
    "text": "ובזה הושלם נושא הלימוד האחרון\nבשיחת לידינגו."
  },
  {
    "i": 337,
    "start": "00:20:43.040",
    "end": "00:20:46.000",
    "text": "והאורחים שלנו יכולים לצאת הביתה."
  },
  {
    "i": 338,
    "start": "00:20:46.160",
    "end": "00:20:49.200",
    "text": "ויקטור, איך היה הערב שלך\nואיך היה האוכל?"
  },
  {
    "i": 339,
    "start": "00:20:49.360",
    "end": "00:20:51.800",
    "text": "היה לי ערב נעים מאוד\nאצל מיקה."
  },
  {
    "i": 340,
    "start": "00:20:51.960",
    "end": "00:20:56.960",
    "text": "המנה הראשונה,\nשם האספרגוס קצת השתלט."
  },
  {
    "i": 341,
    "start": "00:20:57.120",
    "end": "00:21:00.080",
    "text": "לכן אני נותן למיקה שש."
  },
  {
    "i": 342,
    "start": "00:21:00.240",
    "end": "00:21:04.080",
    "text": "-ואת, מריה?\n-הבשר היה קסום."
  },
  {
    "i": 343,
    "start": "00:21:04.240",
    "end": "00:21:06.360",
    "text": "אבל אולי קצת יותר מדי עוגיות\nבקינוח."
  },
  {
    "i": 344,
    "start": "00:21:06.520",
    "end": "00:21:09.960",
    "text": "לכן מיקה מקבל ממני שבע."
  },
  {
    "i": 345,
    "start": "00:21:10.120",
    "end": "00:21:12.040",
    "text": "וואו, פעם ראשונה שמישהו מקבל\nהורדת נקודות בגלל..."
  },
  {
    "i": 346,
    "start": "00:21:12.200",
    "end": "00:21:17.200",
    "text": "יותר מדי עוגיות. 13 נקודות עד כה...\nוהמקום הראשון מחוץ להישג יד."
  },
  {
    "i": 347,
    "start": "00:21:17.360",
    "end": "00:21:20.960",
    "text": "אבל זה יכול להיות מקום שני.\nמימי, איזה מספר יש לך?"
  },
  {
    "i": 348,
    "start": "00:21:21.120",
    "end": "00:21:22.960",
    "text": "שמונה."
  },
  {
    "i": 349,
    "start": "00:21:23.120",
    "end": "00:21:26.040",
    "text": "21 נקודות מקבל הערב,\nומיקה תופס את המקום השני..."
  },
  {
    "i": 350,
    "start": "00:21:26.200",
    "end": "00:21:29.040",
    "text": "ונשארה רק הארוחה של מריה....\nהישארו איתנו עד מחר..."
  },
  {
    "i": 351,
    "start": "00:21:29.200",
    "end": "00:21:32.880",
    "text": "אם אתם רוצים לדעת את התוצאה, או...\nשתעשו תנומה של 23.5 שעות..."
  },
  {
    "i": 352,
    "start": "00:21:33.040",
    "end": "00:21:36.920",
    "text": "ותדליקו שוב את הטלוויזיה....\nהבחירה בידיכם. נתראה."
  },
  {
    "i": 353,
    "start": "00:21:37.080",
    "end": "00:21:39.000",
    "text": "קדימה!"
  },
  {
    "i": 354,
    "start": "00:21:39.160",
    "end": "00:21:42.320",
    "text": "זה יהיה בישול\nעם אזהרת טינטון."
  },
  {
    "i": 355,
    "start": "00:21:42.480",
    "end": "00:21:45.600",
    "text": "שמים אטמי אוזניים\nוחושבים על הקיץ."
  },
  {
    "i": 356,
    "start": "00:21:45.760",
    "end": "00:21:47.960",
    "text": "האורחים מגישים תעלולי קרקס."
  },
  {
    "i": 357,
    "start": "00:21:48.120",
    "end": "00:21:50.720",
    "text": "זה בסדר גמור, לא?"
  },
  {
    "i": 358,
    "start": "00:21:50.880",
    "end": "00:21:55.360",
    "text": "ומי עושה תעלול על צלחת הכסף?"
  },
  {
    "i": 359,
    "start": "00:21:57.240",
    "end": "00:22:02.160",
    "text": "לא יודע אם אני מעז.\nמה אם אני אריץ ספריי על הכול?"
  },
  {
    "i": 360,
    "start": "00:22:03.760",
    "end": "00:22:05.800",
    "text": "אני הולך לקנות פחיות ספריי."
  },
  {
    "i": 361,
    "start": "00:22:05.960",
    "end": "00:22:08.760",
    "text": "כתוביות: פבלו דיאז ברנל\nIyuno"
  }
]