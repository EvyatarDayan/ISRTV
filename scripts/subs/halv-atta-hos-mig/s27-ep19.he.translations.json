[
  {
    "i": 0,
    "start": "00:00:02.440",
    "end": "00:00:05.160",
    "text": "ב-\"Halv åtta hos mig\"\nמתחרים ארבעה טבחים ביתיים על-"
  },
  {
    "i": 1,
    "start": "00:00:05.320",
    "end": "00:00:08.000",
    "text": "-מי מבשל\nאת ארוחת הערב הכי טעימה."
  },
  {
    "i": 2,
    "start": "00:00:08.160",
    "end": "00:00:12.080",
    "text": "כל שבוע נבחר זוכה חדש.\nברוכים הבאים."
  },
  {
    "i": 3,
    "start": "00:00:26.520",
    "end": "00:00:30.000",
    "text": "ברוכים הבאים ל\nמבצר הריקוד, סקרבורג."
  },
  {
    "i": 4,
    "start": "00:00:30.160",
    "end": "00:00:33.920",
    "text": "ברט קרלסון בנה את\nאימפריית להקות הריקוד באזורים האלה."
  },
  {
    "i": 5,
    "start": "00:00:34.080",
    "end": "00:00:39.480",
    "text": "כל אביב מתאספים עשרות אלפי\nעגורים באגם הורנבורגה-"
  },
  {
    "i": 6,
    "start": "00:00:39.640",
    "end": "00:00:44.160",
    "text": "-שנמצא מרחק אבן זריקה\nמעיר המארחים של השבוע - פלקופינג."
  },
  {
    "i": 7,
    "start": "00:00:44.320",
    "end": "00:00:47.280",
    "text": "פתחנו את השבוע אצל הרוקר מרקוס-"
  },
  {
    "i": 8,
    "start": "00:00:47.440",
    "end": "00:00:52.680",
    "text": "-שהגיש טרטר מצבי דמה\nושניצל מחזיר בר."
  },
  {
    "i": 9,
    "start": "00:00:52.840",
    "end": "00:00:56.120",
    "text": "תפריט שנתן לו 23 נקודות."
  },
  {
    "i": 10,
    "start": "00:00:56.280",
    "end": "00:00:59.840",
    "text": "אתמול ערך מנהל העירייה\nמגנוס ארוחת חגיגה-"
  },
  {
    "i": 11,
    "start": "00:01:00.000",
    "end": "00:01:06.920",
    "text": "-עם סלט שרימפס, סטייק מקומי\nוסמיפרדו פטל."
  },
  {
    "i": 12,
    "start": "00:01:07.080",
    "end": "00:01:09.520",
    "text": "גם מגנוס נחת על 23 נקודות."
  },
  {
    "i": 13,
    "start": "00:01:09.680",
    "end": "00:01:13.120",
    "text": "מחר הגמר\nאצל השחקנית אידה."
  },
  {
    "i": 14,
    "start": "00:01:13.280",
    "end": "00:01:16.680",
    "text": "השתתפתי\nביותר מ-300 הפקות."
  },
  {
    "i": 15,
    "start": "00:01:16.840",
    "end": "00:01:20.160",
    "text": "איך ילך לה\nכנראה כתוב בקלפים."
  },
  {
    "i": 16,
    "start": "00:01:20.320",
    "end": "00:01:24.680",
    "text": "עכשיו נפגוש\nאת מארחת הערב, אריקה."
  },
  {
    "i": 17,
    "start": "00:01:24.840",
    "end": "00:01:30.400",
    "text": "היא בדיוק\nמתחילה את קורס הציור שלה."
  },
  {
    "i": 18,
    "start": "00:01:30.560",
    "end": "00:01:36.840",
    "text": "-למה ללכת לקורסי הציור שלך?\n-קורסי הציור שלי נפלאים."
  },
  {
    "i": 19,
    "start": "00:01:37.000",
    "end": "00:01:43.400",
    "text": "יש לכם מושג\nמה יהיה המוטיב היום?"
  },
  {
    "i": 20,
    "start": "00:01:43.560",
    "end": "00:01:48.680",
    "text": "אני מנחש ספל מול\nחלון עם טיפות גשם על הזכוכית."
  },
  {
    "i": 21,
    "start": "00:01:48.840",
    "end": "00:01:54.880",
    "text": "היום נצייר את זה."
  },
  {
    "i": 22,
    "start": "00:01:56.520",
    "end": "00:02:00.600",
    "text": "אני חייבת להיות חוזה\nאו שהצצתי..."
  },
  {
    "i": 23,
    "start": "00:02:00.760",
    "end": "00:02:05.360",
    "text": "-אריקה, מתי התחלת כאמנית?\n-אני אמנית."
  },
  {
    "i": 24,
    "start": "00:02:05.520",
    "end": "00:02:08.080",
    "text": "התחלתי לצייר\nכשהגעתי לשוודיה."
  },
  {
    "i": 25,
    "start": "00:02:08.240",
    "end": "00:02:12.280",
    "text": "-מאיפה את?\n-בלו הוריזונטה."
  },
  {
    "i": 26,
    "start": "00:02:12.440",
    "end": "00:02:15.040",
    "text": "עיר גדולה בברזיל."
  },
  {
    "i": 27,
    "start": "00:02:15.200",
    "end": "00:02:22.040",
    "text": "היא הייתה קטנה מדי לאריקה\nשחיפשה הרפתקה בפלקופינג."
  },
  {
    "i": 28,
    "start": "00:02:22.200",
    "end": "00:02:27.080",
    "text": "-מה הרגשת כשהגעת לכאן?\n-זו הייתה אהבה."
  },
  {
    "i": 29,
    "start": "00:02:27.240",
    "end": "00:02:30.760",
    "text": "אבל אם משווים את פלקופינג\nלבלו הוריזונטה?"
  },
  {
    "i": 30,
    "start": "00:02:30.920",
    "end": "00:02:33.840",
    "text": "יש הרי... כמה שזה קשה."
  },
  {
    "i": 31,
    "start": "00:02:34.000",
    "end": "00:02:36.880",
    "text": "נוכל לעשות את זה בפורטוגזית?"
  },
  {
    "i": 32,
    "start": "00:02:37.040",
    "end": "00:02:41.640",
    "text": "-אל תנסי להתחמק עכשיו.\n-יש אנשים נפלאים."
  },
  {
    "i": 33,
    "start": "00:02:41.800",
    "end": "00:02:45.280",
    "text": "יש גבינה ופיצה."
  },
  {
    "i": 34,
    "start": "00:02:45.440",
    "end": "00:02:48.960",
    "text": "עם גבינה ופיצה\nאפשר להסתדר רחוק."
  },
  {
    "i": 35,
    "start": "00:02:49.120",
    "end": "00:02:54.920",
    "text": "-אריקה טובה גם במטבח?\n-אנחנו לא יודעים איך היא במטבח."
  },
  {
    "i": 36,
    "start": "00:02:55.080",
    "end": "00:02:59.440",
    "text": "בדיוק, את זה נראה."
  },
  {
    "i": 37,
    "start": "00:02:59.600",
    "end": "00:03:03.680",
    "text": "מה פבלו פיקאסו היה מגיש\nב-\"Halv åtta hos mig\"?"
  },
  {
    "i": 38,
    "start": "00:03:03.840",
    "end": "00:03:09.840",
    "text": "פיקאסו היה מגיש נקניקייה,\nאני חושבת."
  },
  {
    "i": 39,
    "start": "00:03:10.000",
    "end": "00:03:15.000",
    "text": "-אל תשאל למה.\n-נקניקיית גרינקה קיוביסטית אולי?"
  },
  {
    "i": 40,
    "start": "00:03:15.160",
    "end": "00:03:19.160",
    "text": "-אני רוצה לראות איך את גרה, אריקה.\n-כאן אני גרה."
  },
  {
    "i": 41,
    "start": "00:03:19.320",
    "end": "00:03:23.720",
    "text": "איך היית מתארת\nאת סגנון העיצוב שלך?"
  },
  {
    "i": 42,
    "start": "00:03:23.880",
    "end": "00:03:28.840",
    "text": "מיקס קטן\nשל טרופי ושוודי."
  },
  {
    "i": 43,
    "start": "00:03:29.000",
    "end": "00:03:33.560",
    "text": "-כמו הוואי בפיצרייה.\n-כן, שילוב נפלא."
  },
  {
    "i": 44,
    "start": "00:03:33.720",
    "end": "00:03:38.360",
    "text": "אננס על פיצה?\nקלאסיקה שוודית."
  },
  {
    "i": 45,
    "start": "00:03:38.520",
    "end": "00:03:42.120",
    "text": "-איזה דקל יפה.\n-נכון שהוא יפה?"
  },
  {
    "i": 46,
    "start": "00:03:42.280",
    "end": "00:03:46.120",
    "text": "אני אוהבת דקלים.\nמרגישים שהיא רוצה לספר משהו."
  },
  {
    "i": 47,
    "start": "00:03:46.280",
    "end": "00:03:50.400",
    "text": "-מה היא אומרת?\n-זו הייתה שאלה קשה."
  },
  {
    "i": 48,
    "start": "00:03:50.560",
    "end": "00:03:56.280",
    "text": "חשבתי שהיא אמרה: \"זה יהיה\nטלוויזיה עץ. כדאי שנמשיך הלאה.\""
  },
  {
    "i": 49,
    "start": "00:03:56.440",
    "end": "00:03:59.920",
    "text": "-נקשיב לדקל?\n-בהחלט."
  },
  {
    "i": 50,
    "start": "00:04:00.080",
    "end": "00:04:04.280",
    "text": "-נוכל לבדוק הלאה.\n-מה אלה הציורים האלה?"
  },
  {
    "i": 51,
    "start": "00:04:04.440",
    "end": "00:04:09.000",
    "text": "אלה שני ציורים\nשאני משתמשת בהם בירידי חתונות."
  },
  {
    "i": 52,
    "start": "00:04:09.160",
    "end": "00:04:14.240",
    "text": "-ירידי חתונות?\n-אני אמנית חתונות."
  },
  {
    "i": 53,
    "start": "00:04:14.400",
    "end": "00:04:17.000",
    "text": "בחתונות אני עומדת עם כן הציור שלי-"
  },
  {
    "i": 54,
    "start": "00:04:17.160",
    "end": "00:04:20.880",
    "text": "-ומציירת\nאת כל האווירה והאהבה."
  },
  {
    "i": 55,
    "start": "00:04:21.040",
    "end": "00:04:25.320",
    "text": "-תרצי לצייר אותי כשאתחתן?\n-בשמחה."
  },
  {
    "i": 56,
    "start": "00:04:25.480",
    "end": "00:04:29.040",
    "text": "תוכלי גם לסדר חתן?"
  },
  {
    "i": 57,
    "start": "00:04:29.200",
    "end": "00:04:34.760",
    "text": "ברזילאים, אנשי סקרבורג...\nאו הגבר בציור שם אולי?"
  },
  {
    "i": 58,
    "start": "00:04:34.920",
    "end": "00:04:38.040",
    "text": "נוכל לפתור את זה איכשהו."
  },
  {
    "i": 59,
    "start": "00:04:38.200",
    "end": "00:04:43.880",
    "text": "-יש עוד משהו בלתי צפוי שאת יודעת?\n-כאן אפשר גם לנגן בפסנתר."
  },
  {
    "i": 60,
    "start": "00:04:44.040",
    "end": "00:04:47.680",
    "text": "עכשיו ארגיש\nאת הדופק של אורחי הערב."
  },
  {
    "i": 61,
    "start": "00:04:47.840",
    "end": "00:04:53.240",
    "text": "-לאיזה תפריט את מקווה, אידה?\n-קצת whoa."
  },
  {
    "i": 62,
    "start": "00:04:53.400",
    "end": "00:04:57.520",
    "text": "-זה היה תיאור טוב?\n-כן, אבל קצת יותר מדי קצר."
  },
  {
    "i": 63,
    "start": "00:04:57.680",
    "end": "00:05:00.360",
    "text": "אני פותחת את התפריט וקוראת."
  },
  {
    "i": 64,
    "start": "00:05:04.400",
    "end": "00:05:08.800",
    "text": "-זה נותן לך תחושת whoa?\n-מאה אחוז."
  },
  {
    "i": 65,
    "start": "00:05:08.960",
    "end": "00:05:15.240",
    "text": "דווקא שרימפס מצופים נשמעים נחמדים. גם הסלט יכול להיות."
  },
  {
    "i": 66,
    "start": "00:05:15.400",
    "end": "00:05:18.880",
    "text": "אני יותר חיובית\nלפירות מאשר לירקות."
  },
  {
    "i": 67,
    "start": "00:05:19.040",
    "end": "00:05:21.960",
    "text": "מקווה שיש קצת\nמנגו או פפאיה."
  },
  {
    "i": 68,
    "start": "00:05:22.120",
    "end": "00:05:26.080",
    "text": "בלי פפאיה או coconut\nלטעמה הגדול של קיקי."
  },
  {
    "i": 69,
    "start": "00:05:26.240",
    "end": "00:05:29.240",
    "text": "מנגו ייכנס לסלט. איך זה נשמע?"
  },
  {
    "i": 70,
    "start": "00:05:29.400",
    "end": "00:05:34.400",
    "text": "נשמע טוב. המנגו משמיע משהו?"
  },
  {
    "i": 71,
    "start": "00:05:34.560",
    "end": "00:05:37.760",
    "text": "-גם הוא מדבר?\n-לא."
  },
  {
    "i": 72,
    "start": "00:05:37.920",
    "end": "00:05:42.800",
    "text": "אריקה מערבבת כוסברה,\nאבל מחכה עם המנגו. ועכשיו?"
  },
  {
    "i": 73,
    "start": "00:05:42.960",
    "end": "00:05:46.600",
    "text": "-נתחיל עם הג'לי.\n-נכון, ג'לי פלפל צ'ילי."
  },
  {
    "i": 74,
    "start": "00:05:46.760",
    "end": "00:05:51.360",
    "text": "-מרקוס, מה אתה חושב עליו?\n-אני מקווה שהוא..."
  },
  {
    "i": 75,
    "start": "00:05:51.520",
    "end": "00:05:54.600",
    "text": "שיש בו קצת עוקץ."
  },
  {
    "i": 76,
    "start": "00:05:54.760",
    "end": "00:05:58.360",
    "text": "-ברור שיהיה חריף.\n-הוא לא יהיה חריף מדי."
  },
  {
    "i": 77,
    "start": "00:05:58.520",
    "end": "00:06:01.240",
    "text": "אבל ג'לי וטעם אננס?"
  },
  {
    "i": 78,
    "start": "00:06:01.400",
    "end": "00:06:04.760",
    "text": "אקח\nאננס אחר."
  },
  {
    "i": 79,
    "start": "00:06:04.920",
    "end": "00:06:08.080",
    "text": "זה לא היה טוב. יש לי שלושה."
  },
  {
    "i": 80,
    "start": "00:06:08.240",
    "end": "00:06:11.320",
    "text": "איזה מזל, אולי אחד טוב."
  },
  {
    "i": 81,
    "start": "00:06:11.480",
    "end": "00:06:15.080",
    "text": "מברזיל אולי."
  },
  {
    "i": 82,
    "start": "00:06:15.240",
    "end": "00:06:19.760",
    "text": "אריקה מחממת צ'ילי, סוכר\nואת האננס-"
  },
  {
    "i": 83,
    "start": "00:06:19.920",
    "end": "00:06:23.640",
    "text": "-בסיר עד\nלמרקם \"ג'לי\"."
  },
  {
    "i": 84,
    "start": "00:06:23.800",
    "end": "00:06:28.520",
    "text": "-איך נשמעת המנה הראשונה, מאנגה?\n-די טרופית."
  },
  {
    "i": 85,
    "start": "00:06:28.680",
    "end": "00:06:33.760",
    "text": "-זה מפחיד בן סקרבורג?\n-בשום אופן לא."
  },
  {
    "i": 86,
    "start": "00:06:33.920",
    "end": "00:06:38.800",
    "text": "-איפה אנחנו עומדים, אריקה?\n-אז המנה הראשונה מוכנה עד כאן."
  },
  {
    "i": 87,
    "start": "00:06:38.960",
    "end": "00:06:44.680",
    "text": "בטוחה לגמרי?\nאז אבקש ממאנגה לקרוא את העיקרית."
  },
  {
    "i": 88,
    "start": "00:06:49.520",
    "end": "00:06:52.600",
    "text": "-איך זה נשמע?\n-קצת נשי."
  },
  {
    "i": 89,
    "start": "00:06:52.760",
    "end": "00:06:58.080",
    "text": "-איך אתה חושב?\n-ריזוטו, סלמון לימון והכול."
  },
  {
    "i": 90,
    "start": "00:06:58.240",
    "end": "00:07:01.680",
    "text": "יש נגיעה רכה על זה."
  },
  {
    "i": 91,
    "start": "00:07:01.840",
    "end": "00:07:05.680",
    "text": "הייתי אומרת יותר \"אקזוטי\"."
  },
  {
    "i": 92,
    "start": "00:07:05.840",
    "end": "00:07:09.480",
    "text": "-מה אומרת השפית עצמה?\n-זה יהיה אקזוטי, תמיד."
  },
  {
    "i": 93,
    "start": "00:07:09.640",
    "end": "00:07:13.760",
    "text": "מה האורחים חושבים\nעל רוטב פסיפלורה?"
  },
  {
    "i": 94,
    "start": "00:07:13.920",
    "end": "00:07:17.000",
    "text": "מרקוס, מה אתה חושב\nעל רוטב פסיפלורה?"
  },
  {
    "i": 95,
    "start": "00:07:17.160",
    "end": "00:07:21.200",
    "text": "זה מרגש\nאם המתיקות לא משתלטת יותר מדי."
  },
  {
    "i": 96,
    "start": "00:07:21.360",
    "end": "00:07:24.760",
    "text": "זה לא יהיה מעולה\nאם הדג יהיה מתוק מדי."
  },
  {
    "i": 97,
    "start": "00:07:24.920",
    "end": "00:07:28.720",
    "text": "דגים מכוערים פגשתי,\nאבל דג מתוק זו תהיה הפעם הראשונה."
  },
  {
    "i": 98,
    "start": "00:07:28.880",
    "end": "00:07:33.080",
    "text": "אריקה, את יכולה להגיד\n\"שש סלמונים בקופסת סלמון\"?"
  },
  {
    "i": 99,
    "start": "00:07:33.240",
    "end": "00:07:37.800",
    "text": "שש סלמונים בקופסה...\nאני אפילו לא יכולה להגיד את זה."
  },
  {
    "i": 100,
    "start": "00:07:37.960",
    "end": "00:07:40.680",
    "text": "עכשיו נתמקד באוכל."
  },
  {
    "i": 101,
    "start": "00:07:40.840",
    "end": "00:07:44.160",
    "text": "הסלמון יקבל מלח ופלפל\nויושרה בלימון."
  },
  {
    "i": 102,
    "start": "00:07:44.320",
    "end": "00:07:49.280",
    "text": "-הסלמון צריך לנוח, הוא עייף.\n-עייף? הוא מת לגמרי."
  },
  {
    "i": 103,
    "start": "00:07:49.440",
    "end": "00:07:54.920",
    "text": "-אידה, איך את רוצה את הסלמון?\n-אני קצת מטומטמת."
  },
  {
    "i": 104,
    "start": "00:07:55.080",
    "end": "00:07:59.200",
    "text": "אני אוהבת כשזה מאוד מבושל."
  },
  {
    "i": 105,
    "start": "00:07:59.360",
    "end": "00:08:06.120",
    "text": "אשמח לקחת את הסלמון כמעט יבש,\nבקושי ניתן לחיתוך."
  },
  {
    "i": 106,
    "start": "00:08:06.280",
    "end": "00:08:10.240",
    "text": "עכשיו בכל מקרה\nנבשל את הריזוטו."
  },
  {
    "i": 107,
    "start": "00:08:10.400",
    "end": "00:08:13.800",
    "text": "-אריקה, איזו תוכנית זו?\n-\"Så ska det låta\"."
  },
  {
    "i": 108,
    "start": "00:08:13.960",
    "end": "00:08:19.400",
    "text": "-\"Halv åtta\". לא שכחת משהו?\n-היין, הדבר הכי חשוב."
  },
  {
    "i": 109,
    "start": "00:08:19.560",
    "end": "00:08:23.320",
    "text": "אפשר ליהנות בלי אלכוהול,\nאבל בריזוטו זה חשוב."
  },
  {
    "i": 110,
    "start": "00:08:23.480",
    "end": "00:08:27.280",
    "text": "אם זו הייתה \"Så ska det låta\",\nמה היית שרה?"
  },
  {
    "i": 111,
    "start": "00:08:31.040",
    "end": "00:08:34.160",
    "text": "אה, \"Lambada\"."
  },
  {
    "i": 112,
    "start": "00:08:36.400",
    "end": "00:08:39.160",
    "text": "-הצטרף, מקן!\n-לא, לא."
  },
  {
    "i": 113,
    "start": "00:08:39.320",
    "end": "00:08:41.960",
    "text": "לפחות תוכל לקרוא\nאת הקינוח?"
  },
  {
    "i": 114,
    "start": "00:08:45.360",
    "end": "00:08:48.040",
    "text": "-אכלת את זה קודם?\n-לא פאווה."
  },
  {
    "i": 115,
    "start": "00:08:48.200",
    "end": "00:08:51.080",
    "text": "פאווה, מישהו\nיודע מה זה?"
  },
  {
    "i": 116,
    "start": "00:08:51.240",
    "end": "00:08:54.560",
    "text": "-פרי.\n-יכול להיות מאפה?"
  },
  {
    "i": 117,
    "start": "00:08:54.720",
    "end": "00:08:57.120",
    "text": "-אתה חושב?\n-לא, אני רק מנחש."
  },
  {
    "i": 118,
    "start": "00:08:57.280",
    "end": "00:09:01.080",
    "text": "מפליא שזה נכון."
  },
  {
    "i": 119,
    "start": "00:09:01.240",
    "end": "00:09:04.800",
    "text": "פאווה הוא מאפה\nשמורכב משכבות ביסקוויטים-"
  },
  {
    "i": 120,
    "start": "00:09:04.960",
    "end": "00:09:07.720",
    "text": "-שמשתלבות עם מילוי,\nכמו טירמיסו."
  },
  {
    "i": 121,
    "start": "00:09:07.880",
    "end": "00:09:11.400",
    "text": "-מה אסור לשכוח?\n-הרבה אהבה."
  },
  {
    "i": 122,
    "start": "00:09:11.560",
    "end": "00:09:16.960",
    "text": "אידה, זו הפעם הראשונה\nשמישהו מגיש פאווה בפלקופינג?"
  },
  {
    "i": 123,
    "start": "00:09:17.120",
    "end": "00:09:20.480",
    "text": "כיף שהכניסה\nקצת ברזילאי."
  },
  {
    "i": 124,
    "start": "00:09:20.640",
    "end": "00:09:24.960",
    "text": "אריקה מחממת חלמונים וחלב\nעד שזה מסמיך."
  },
  {
    "i": 125,
    "start": "00:09:25.120",
    "end": "00:09:28.000",
    "text": "-איך זה יוצא?\n-זה יהיה כל כך טעים."
  },
  {
    "i": 126,
    "start": "00:09:28.160",
    "end": "00:09:32.160",
    "text": "בתחתית שמים ביסקוויטי סבויארדי\nלפני שהמילוי עולה."
  },
  {
    "i": 127,
    "start": "00:09:32.320",
    "end": "00:09:37.520",
    "text": "-ואז עוד שכבת ביסקוויטים.\n-אז זמן לקרם."
  },
  {
    "i": 128,
    "start": "00:09:37.680",
    "end": "00:09:41.880",
    "text": "אידה, איך זה צריך לטעום\nכדי להצליח באזור הזה?"
  },
  {
    "i": 129,
    "start": "00:09:42.040",
    "end": "00:09:44.200",
    "text": "-טעים!\n-נכון?"
  },
  {
    "i": 130,
    "start": "00:09:44.360",
    "end": "00:09:48.000",
    "text": "אריקה מערבבת קרם פרש\nופסיפלורה לבלילה."
  },
  {
    "i": 131,
    "start": "00:09:48.160",
    "end": "00:09:52.200",
    "text": "-יהיה טעים או טעים?\n-רק טעים."
  },
  {
    "i": 132,
    "start": "00:09:52.360",
    "end": "00:09:54.920",
    "text": "הבלילה מטפטפת מעל העוגה."
  },
  {
    "i": 133,
    "start": "00:09:55.080",
    "end": "00:09:58.200",
    "text": "-ועכשיו?\n-השכבה האחרונה."
  },
  {
    "i": 134,
    "start": "00:09:58.360",
    "end": "00:10:04.080",
    "text": "שמורכבת מחלבון מוקצף\nעם סוכר ושמנת."
  },
  {
    "i": 135,
    "start": "00:10:04.240",
    "end": "00:10:07.240",
    "text": "אלגנטי, אריקה."
  },
  {
    "i": 136,
    "start": "00:10:07.400",
    "end": "00:10:10.920",
    "text": "אז הקינוח מוכן. ככה הוא נראה."
  },
  {
    "i": 137,
    "start": "00:10:11.080",
    "end": "00:10:13.560",
    "text": "נראה ממש טעים."
  },
  {
    "i": 138,
    "start": "00:10:13.720",
    "end": "00:10:18.160",
    "text": "למה את מקווה\nלקראת ארוחת הערב הערב, אידה?"
  },
  {
    "i": 139,
    "start": "00:10:18.320",
    "end": "00:10:23.960",
    "text": "יותר פירות מירקות\nשזה מעולה ודג."
  },
  {
    "i": 140,
    "start": "00:10:24.120",
    "end": "00:10:29.720",
    "text": "עכשיו אני עושה הפסקה\nומרכלת עם הדקל של אריקה."
  },
  {
    "i": 141,
    "start": "00:10:31.000",
    "end": "00:10:35.760",
    "text": "נלמד\nאת השעון הברזילאי."
  },
  {
    "i": 142,
    "start": "00:10:35.920",
    "end": "00:10:39.600",
    "text": "הקלע הטוב ביותר במשטרה\nמציג את הכישורים שלו."
  },
  {
    "i": 143,
    "start": "00:10:39.760",
    "end": "00:10:43.680",
    "text": "-מרקוס דורך במקום הלא נכון.\n-אתם רוקדים הרבה, את ובעלך?"
  },
  {
    "i": 144,
    "start": "00:10:43.840",
    "end": "00:10:46.280",
    "text": "בעלי?"
  },
  {
    "i": 145,
    "start": "00:10:58.520",
    "end": "00:11:01.160",
    "text": "ברוכים השבים לפלקופינג."
  },
  {
    "i": 146,
    "start": "00:11:01.320",
    "end": "00:11:05.760",
    "text": "מגנוס, אידה ומרקוס\nבדרך הביתה לאריקה."
  },
  {
    "i": 147,
    "start": "00:11:05.920",
    "end": "00:11:10.080",
    "text": "-הכול בשליטה?\n-כן, האורחים מגיעים בקרוב."
  },
  {
    "i": 148,
    "start": "00:11:10.240",
    "end": "00:11:13.280",
    "text": "-עכשיו את מתכוונת?\n-היי!"
  },
  {
    "i": 149,
    "start": "00:11:13.440",
    "end": "00:11:19.120",
    "text": "ברוכים הבאים. איזה כיף שאתם כאן. לחיים אז."
  },
  {
    "i": 150,
    "start": "00:11:19.280",
    "end": "00:11:21.840",
    "text": "אל תשימי את הפטל בגרון עכשיו."
  },
  {
    "i": 151,
    "start": "00:11:22.000",
    "end": "00:11:26.480",
    "text": "יש לי עוד קצת לעשות. אתם מוזמנים להסתובב קצת."
  },
  {
    "i": 152,
    "start": "00:11:26.640",
    "end": "00:11:29.760",
    "text": "-נתראה.\n-כיף."
  },
  {
    "i": 153,
    "start": "00:11:29.920",
    "end": "00:11:31.720",
    "text": "-נלך לבדוק?\n-כן."
  },
  {
    "i": 154,
    "start": "00:11:31.880",
    "end": "00:11:34.720",
    "text": "תתחילו קומה למטה."
  },
  {
    "i": 155,
    "start": "00:11:36.800",
    "end": "00:11:38.680",
    "text": "אוי, אוי, תראו כאן."
  },
  {
    "i": 156,
    "start": "00:11:38.840",
    "end": "00:11:42.560",
    "text": "-מרקוס, אתה אוהב אקדחי צעצוע?\n-מאה אחוז."
  },
  {
    "i": 157,
    "start": "00:11:42.720",
    "end": "00:11:47.520",
    "text": "הייתה שם ארסנל\nששווה לפלקופינג."
  },
  {
    "i": 158,
    "start": "00:11:47.680",
    "end": "00:11:51.440",
    "text": "יש לנו שלושה כדורים, הטוב מתוך שלושה."
  },
  {
    "i": 159,
    "start": "00:11:51.600",
    "end": "00:11:56.200",
    "text": "-איפה מותר להיות?\n-עכשיו באמת תפסיק."
  },
  {
    "i": 160,
    "start": "00:11:56.360",
    "end": "00:12:00.440",
    "text": "-ירי בשכיבה.\n-מה, תחרותי?"
  },
  {
    "i": 161,
    "start": "00:12:00.600",
    "end": "00:12:04.360",
    "text": "ברור.\nאתה לא אדם תחרותי?"
  },
  {
    "i": 162,
    "start": "00:12:04.520",
    "end": "00:12:07.800",
    "text": "כיף להתחרות,\nאבל זה לא צריך להגיע לקיצוניות."
  },
  {
    "i": 163,
    "start": "00:12:07.960",
    "end": "00:12:11.560",
    "text": "-כן, אני חושב שכן.\n-זה לא בדיוק מרטין בק."
  },
  {
    "i": 164,
    "start": "00:12:11.720",
    "end": "00:12:16.400",
    "text": "למרטין בק יש אקדח אחר. התחרות עוד לא התחילה."
  },
  {
    "i": 165,
    "start": "00:12:16.560",
    "end": "00:12:19.120",
    "text": "רציתי לירות לניסיון."
  },
  {
    "i": 166,
    "start": "00:12:19.280",
    "end": "00:12:24.120",
    "text": "אז תוכל להראות\nבאמת איך זה הולך."
  },
  {
    "i": 167,
    "start": "00:12:25.480",
    "end": "00:12:29.200",
    "text": "חשבתי שהמשטרה תהיה\nיותר טובה בירי."
  },
  {
    "i": 168,
    "start": "00:12:29.360",
    "end": "00:12:34.440",
    "text": "אם הוא יוצא\nלעזאזל אם שורדים."
  },
  {
    "i": 169,
    "start": "00:12:34.600",
    "end": "00:12:38.280",
    "text": "אתם בלי הכשרת משטרה\nיותר טובים במכוון?"
  },
  {
    "i": 170,
    "start": "00:12:38.440",
    "end": "00:12:41.000",
    "text": "Make my day."
  },
  {
    "i": 171,
    "start": "00:12:41.160",
    "end": "00:12:44.640",
    "text": "מה לעזאזל זה?"
  },
  {
    "i": 172,
    "start": "00:12:44.800",
    "end": "00:12:48.960",
    "text": "-אידה, מה את אומרת?\n-אקדח הנרף היה כיף."
  },
  {
    "i": 173,
    "start": "00:12:49.120",
    "end": "00:12:54.200",
    "text": "-לא הייתם טובים בירי.\n-זה לא הלך ממש טוב."
  },
  {
    "i": 174,
    "start": "00:12:54.360",
    "end": "00:12:57.280",
    "text": "עדיף\nשנעזוב את מטווח הירי."
  },
  {
    "i": 175,
    "start": "00:12:57.440",
    "end": "00:13:03.000",
    "text": "כאן יש דברים. היא משלבת\nחדר כביסה עם קצת אחר."
  },
  {
    "i": 176,
    "start": "00:13:03.160",
    "end": "00:13:07.600",
    "text": "ציוד ציור כדי להיות מדויקים. אידה, מה את חושבת על האמנות של אריקה?"
  },
  {
    "i": 177,
    "start": "00:13:07.760",
    "end": "00:13:12.880",
    "text": "יש לה אמנות יפה על הקירות. ציורים יפים מאוד."
  },
  {
    "i": 178,
    "start": "00:13:13.040",
    "end": "00:13:14.920",
    "text": "כמעט קצת צרפתי."
  },
  {
    "i": 179,
    "start": "00:13:15.080",
    "end": "00:13:20.160",
    "text": "ספל תה צרפתי, עץ חג מולד צרפתי\nעם שלג צרפתי, magnifique."
  },
  {
    "i": 180,
    "start": "00:13:20.320",
    "end": "00:13:24.760",
    "text": "-אילו צבעים יש לנו?\n-Glow in the dark."
  },
  {
    "i": 181,
    "start": "00:13:24.920",
    "end": "00:13:28.600",
    "text": "-צבע זוהר בחושך.\n-נבדוק את זה, נכון?"
  },
  {
    "i": 182,
    "start": "00:13:28.760",
    "end": "00:13:31.960",
    "text": "-אקח את הוורוד.\n-ברור."
  },
  {
    "i": 183,
    "start": "00:13:32.120",
    "end": "00:13:36.800",
    "text": "Think pink, זה הוביל לעונש,\nאבל תתחילו לצייר עכשיו."
  },
  {
    "i": 184,
    "start": "00:13:39.120",
    "end": "00:13:41.920",
    "text": "מהצבע שלי לא יוצא כלום."
  },
  {
    "i": 185,
    "start": "00:13:42.080",
    "end": "00:13:45.600",
    "text": "-אתם מוציאים דברים.\n-יש לנו את זה בנו."
  },
  {
    "i": 186,
    "start": "00:13:45.760",
    "end": "00:13:49.640",
    "text": "-גם קיבלתם צבע עם צבע.\n-דיסקו!"
  },
  {
    "i": 187,
    "start": "00:13:49.800",
    "end": "00:13:53.680",
    "text": "-יצא ציור דיסקו.\n-אתם משקיעים יותר מדי זמן."
  },
  {
    "i": 188,
    "start": "00:13:56.640",
    "end": "00:14:02.040",
    "text": "אתה לא רואה את הצבע שלך. תנחש קצת פשוט."
  },
  {
    "i": 189,
    "start": "00:14:02.200",
    "end": "00:14:07.400",
    "text": "נבדוק ונכבה את האור\nונראה אם זה זוהר בחושך?"
  },
  {
    "i": 190,
    "start": "00:14:07.560",
    "end": "00:14:11.400",
    "text": "קצת זה זוהר."
  },
  {
    "i": 191,
    "start": "00:14:11.560",
    "end": "00:14:14.200",
    "text": "בערך באותה הצלחה\nכמו תחרות הירי."
  },
  {
    "i": 192,
    "start": "00:14:14.360",
    "end": "00:14:18.520",
    "text": "אני הולכת למטבח לפני שהם\nיסגרו את רישיון השידור של TV4."
  },
  {
    "i": 193,
    "start": "00:14:18.680",
    "end": "00:14:21.880",
    "text": "כאן עומדת אריקה ומסדרת\nאת המנה הראשונה."
  },
  {
    "i": 194,
    "start": "00:14:22.040",
    "end": "00:14:25.280",
    "text": "ג'לי פלפל הצ'ילי נכנס לקעריות קטנות."
  },
  {
    "i": 195,
    "start": "00:14:25.440",
    "end": "00:14:29.360",
    "text": "עליו סלט ומנגו\nשמקבלים ויניגרט מעל."
  },
  {
    "i": 196,
    "start": "00:14:29.520",
    "end": "00:14:33.720",
    "text": "עכשיו השרימפסים יטוגנו בשמן. סולר."
  },
  {
    "i": 197,
    "start": "00:14:33.880",
    "end": "00:14:38.440",
    "text": "סליחה, ניסיתי לצחוק. זה הלך ככה ככה. שמן טיגון."
  },
  {
    "i": 198,
    "start": "00:14:40.320",
    "end": "00:14:46.080",
    "text": "-הולך טוב?\n-כן, זה קצת crazy."
  },
  {
    "i": 199,
    "start": "00:14:46.240",
    "end": "00:14:50.960",
    "text": "כל המתכונים, כולל זה\nנמצאים ב-köket.se."
  },
  {
    "i": 200,
    "start": "00:14:51.120",
    "end": "00:14:54.080",
    "text": "זה נראה סופר טעים."
  },
  {
    "i": 201,
    "start": "00:14:54.240",
    "end": "00:14:56.920",
    "text": "אני מקווה שהם יאהבו."
  },
  {
    "i": 202,
    "start": "00:14:57.080",
    "end": "00:15:01.760",
    "text": "שרימפס מצופים עם ג'לי פלפל צ'ילי\nוסלט טרופי."
  },
  {
    "i": 203,
    "start": "00:15:01.920",
    "end": "00:15:05.320",
    "text": "-ככה.\n-אוי, איזה טעים."
  },
  {
    "i": 204,
    "start": "00:15:08.800",
    "end": "00:15:14.560",
    "text": "-מרקוס, איך זה טעים?\n-מה יש לך בג'לי?"
  },
  {
    "i": 205,
    "start": "00:15:14.720",
    "end": "00:15:20.280",
    "text": "-זה אננס ופלפל צ'ילי.\n-טעים מאוד."
  },
  {
    "i": 206,
    "start": "00:15:20.440",
    "end": "00:15:25.640",
    "text": "מגנוס, מה אתה אומר\nעל ג'לי פלפל הצ'ילי?"
  },
  {
    "i": 207,
    "start": "00:15:25.800",
    "end": "00:15:29.560",
    "text": "איך קוראים לזה שאתה קונה בבקבוק-"
  },
  {
    "i": 208,
    "start": "00:15:29.720",
    "end": "00:15:33.760",
    "text": "-שיש לך כשאתה מכין מנות סיניות?"
  },
  {
    "i": 209,
    "start": "00:15:33.920",
    "end": "00:15:36.960",
    "text": "-לא sweet sour...\n-Sweet chili?"
  },
  {
    "i": 210,
    "start": "00:15:37.120",
    "end": "00:15:42.400",
    "text": "כן, חשבתי על\nקצת יותר עוקץ צ'ילי בו."
  },
  {
    "i": 211,
    "start": "00:15:42.560",
    "end": "00:15:45.520",
    "text": "אבל עכשיו זה לא היה sweet chili\nאלא רוטב ביתי."
  },
  {
    "i": 212,
    "start": "00:15:45.680",
    "end": "00:15:50.080",
    "text": "-איך היו השרימפסים?\n-היא השקיעה בהם עבודה."
  },
  {
    "i": 213,
    "start": "00:15:50.240",
    "end": "00:15:56.000",
    "text": "לגמרי אחר ממה שחשבו. חשבתי שתבוא חריפות."
  },
  {
    "i": 214,
    "start": "00:15:56.160",
    "end": "00:15:58.560",
    "text": "ממש מרגישים אננס."
  },
  {
    "i": 215,
    "start": "00:15:58.720",
    "end": "00:16:01.760",
    "text": "השרימפסים היו פנטסטיים\nומנגו טעים."
  },
  {
    "i": 216,
    "start": "00:16:01.920",
    "end": "00:16:04.800",
    "text": "אולי השארתי קצת סלט..."
  },
  {
    "i": 217,
    "start": "00:16:04.960",
    "end": "00:16:07.440",
    "text": "אוכל הארנבים לא חייבים לאכול."
  },
  {
    "i": 218,
    "start": "00:16:07.600",
    "end": "00:16:12.200",
    "text": "מה מאפיין\nברזילאי?"
  },
  {
    "i": 219,
    "start": "00:16:12.360",
    "end": "00:16:15.560",
    "text": "זה מישהו שמדבר בקול רם."
  },
  {
    "i": 220,
    "start": "00:16:15.720",
    "end": "00:16:18.960",
    "text": "ואולי מחייך המון."
  },
  {
    "i": 221,
    "start": "00:16:19.120",
    "end": "00:16:21.720",
    "text": "הם אוהבים בעיקר לרקוד."
  },
  {
    "i": 222,
    "start": "00:16:21.880",
    "end": "00:16:26.040",
    "text": "-את ובעלך רוקדים הרבה?\n-בעלי?"
  },
  {
    "i": 223,
    "start": "00:16:26.200",
    "end": "00:16:31.280",
    "text": "-הוא היה שוודי.\n-הוא יכול לרקוד בכל זאת?"
  },
  {
    "i": 224,
    "start": "00:16:31.440",
    "end": "00:16:34.320",
    "text": "הוא עושה ככה לפעמים."
  },
  {
    "i": 225,
    "start": "00:16:34.480",
    "end": "00:16:37.480",
    "text": "הוא צוחק\nומסתכל עליי ככה."
  },
  {
    "i": 226,
    "start": "00:16:37.640",
    "end": "00:16:42.880",
    "text": "-זה בכל זאת hip movement.\n-אנחנו השוודים נוקשים להפליא."
  },
  {
    "i": 227,
    "start": "00:16:43.040",
    "end": "00:16:47.840",
    "text": "חוץ ממסיבת העובדים,\nאז השוודי משתחרר."
  },
  {
    "i": 228,
    "start": "00:16:48.000",
    "end": "00:16:50.720",
    "text": "עכשיו זמן\nלפנות את צלחות המנה הראשונה."
  },
  {
    "i": 229,
    "start": "00:16:50.880",
    "end": "00:16:56.600",
    "text": "-אריקה, זה הצליח, לא?\n-אני חושבת שאהבו."
  },
  {
    "i": 230,
    "start": "00:16:56.760",
    "end": "00:17:01.480",
    "text": "באמת, ועכשיו הסלמון\nשאריקה תיבלה."
  },
  {
    "i": 231,
    "start": "00:17:01.640",
    "end": "00:17:05.000",
    "text": "הוא ייאפה בתנור רבע שעה\nב-175 מעלות."
  },
  {
    "i": 232,
    "start": "00:17:05.160",
    "end": "00:17:10.960",
    "text": "-כמה זמן הריזוטו צריך?\n-חמש דקות ברזילאיות, עשר."
  },
  {
    "i": 233,
    "start": "00:17:11.120",
    "end": "00:17:15.080",
    "text": "יש דקה על מכונת הכביסה\nכשהיא בכל זאת מסחררת."
  },
  {
    "i": 234,
    "start": "00:17:15.240",
    "end": "00:17:18.520",
    "text": "פרמזן ושמיר\nמערבבים לתוך הריזוטו."
  },
  {
    "i": 235,
    "start": "00:17:18.680",
    "end": "00:17:23.440",
    "text": "-מה משמיע קול?\n-הסלמון, הוא מוכן."
  },
  {
    "i": 236,
    "start": "00:17:23.600",
    "end": "00:17:26.000",
    "text": "כל כך טוב."
  },
  {
    "i": 237,
    "start": "00:17:26.160",
    "end": "00:17:29.480",
    "text": "-איזה ריח נפלא.\n-זה מריח סלמון."
  },
  {
    "i": 238,
    "start": "00:17:29.640",
    "end": "00:17:33.560",
    "text": "אם יהיה מספיק טוב\nזה יכול להוביל ל-15 סלמון."
  },
  {
    "i": 239,
    "start": "00:17:33.720",
    "end": "00:17:38.280",
    "text": "הרוטב מבהיק עם חמאה\nואז הגשה."
  },
  {
    "i": 240,
    "start": "00:17:38.440",
    "end": "00:17:41.320",
    "text": "ריזוטו, סלמון ורוטב פסיפלורה."
  },
  {
    "i": 241,
    "start": "00:17:41.480",
    "end": "00:17:44.560",
    "text": "עכשיו יוגש."
  },
  {
    "i": 242,
    "start": "00:17:44.720",
    "end": "00:17:47.240",
    "text": "למנה העיקרית..."
  },
  {
    "i": 243,
    "start": "00:17:47.400",
    "end": "00:17:52.440",
    "text": "ריזוטו פרמזן עם סלמון אפוי בלימון\nורוטב פסיפלורה."
  },
  {
    "i": 244,
    "start": "00:17:52.600",
    "end": "00:17:56.000",
    "text": "-בבקשה.\n-תודה רבה מאוד."
  },
  {
    "i": 245,
    "start": "00:17:56.160",
    "end": "00:17:59.640",
    "text": "מגנוס, סלמון ופסיפלורה?"
  },
  {
    "i": 246,
    "start": "00:17:59.800",
    "end": "00:18:02.520",
    "text": "זו הייתה חוויית טעם\nשונה."
  },
  {
    "i": 247,
    "start": "00:18:02.680",
    "end": "00:18:06.600",
    "text": "אני לא רגיל\nלשים רוטב פרי לסלמון."
  },
  {
    "i": 248,
    "start": "00:18:06.760",
    "end": "00:18:10.080",
    "text": "שילוב חדש. מה אתה אומר על זה, מרקוס?"
  },
  {
    "i": 249,
    "start": "00:18:10.240",
    "end": "00:18:14.520",
    "text": "-מה היה ברוטב הפסיפלורה?\n-פסיפלורה."
  },
  {
    "i": 250,
    "start": "00:18:14.680",
    "end": "00:18:17.720",
    "text": "נו באמת, זה נכון?"
  },
  {
    "i": 251,
    "start": "00:18:17.880",
    "end": "00:18:22.200",
    "text": "-זה עבד עם הסלמון?\n-הוא היה קצת יותר מדי מתוק."
  },
  {
    "i": 252,
    "start": "00:18:22.360",
    "end": "00:18:25.920",
    "text": "הוא לא ממש התחתן\nעם הדג."
  },
  {
    "i": 253,
    "start": "00:18:26.080",
    "end": "00:18:29.240",
    "text": "זה הרי שונה\nלפי הטעם של כל אחד."
  },
  {
    "i": 254,
    "start": "00:18:29.400",
    "end": "00:18:35.400",
    "text": "כמו אקסל רוז. חלק חושבים\nשהוא מתוק מדי, אחרים מושלם."
  },
  {
    "i": 255,
    "start": "00:18:35.560",
    "end": "00:18:41.240",
    "text": "-והריזוטו?\n-הוא היה טעים מאוד."
  },
  {
    "i": 256,
    "start": "00:18:41.400",
    "end": "00:18:45.600",
    "text": "אידה, מה את אומרת על הסלמון?"
  },
  {
    "i": 257,
    "start": "00:18:45.760",
    "end": "00:18:48.680",
    "text": "הייתי ממשיכה אותו עוד קצת."
  },
  {
    "i": 258,
    "start": "00:18:48.840",
    "end": "00:18:52.280",
    "text": "אני רוצה שזה יהיה מאוד מבושל."
  },
  {
    "i": 259,
    "start": "00:18:52.440",
    "end": "00:18:56.960",
    "text": "-מה את אומרת על המנה העיקרית?\n-היא הייתה פנטסטית."
  },
  {
    "i": 260,
    "start": "00:18:57.120",
    "end": "00:19:00.920",
    "text": "-על זה נרים כוסית.\n-לחיים."
  },
  {
    "i": 261,
    "start": "00:19:01.080",
    "end": "00:19:06.680",
    "text": "-אריקה, איך זה מרגיש?\n-אני חושבת שחשבו שזה טעים."
  },
  {
    "i": 262,
    "start": "00:19:06.840",
    "end": "00:19:11.360",
    "text": "עכשיו קינוח,\nאז האננס יוצא שוב."
  },
  {
    "i": 263,
    "start": "00:19:11.520",
    "end": "00:19:15.600",
    "text": "הפאווה מוגשת בזהירות. אה, איזו הגשה יפה."
  },
  {
    "i": 264,
    "start": "00:19:15.760",
    "end": "00:19:19.200",
    "text": "זה חשוב במיוחד לך\nכאמנית?"
  },
  {
    "i": 265,
    "start": "00:19:19.360",
    "end": "00:19:24.360",
    "text": "חשוב\nאיך הקינוח נראה, ברור."
  },
  {
    "i": 266,
    "start": "00:19:24.520",
    "end": "00:19:29.240",
    "text": "-עכשיו אני מרגישה מוכנה.\n-עכשיו יישאו פנימה לאורחים."
  },
  {
    "i": 267,
    "start": "00:19:29.400",
    "end": "00:19:33.560",
    "text": "פאווה ברזילאית עם\nקרם פסיפלורה."
  },
  {
    "i": 268,
    "start": "00:19:33.720",
    "end": "00:19:37.080",
    "text": "זה היה יפה, מרגש."
  },
  {
    "i": 269,
    "start": "00:19:37.240",
    "end": "00:19:40.760",
    "text": "מגנוס, איך היית מתאר את הפאווה?"
  },
  {
    "i": 270,
    "start": "00:19:40.920",
    "end": "00:19:42.840",
    "text": "היא הייתה טעימה."
  },
  {
    "i": 271,
    "start": "00:19:43.000",
    "end": "00:19:46.840",
    "text": "היא הייתה בין טירמיסו\nלעוגת בודפשט."
  },
  {
    "i": 272,
    "start": "00:19:47.000",
    "end": "00:19:50.760",
    "text": "הברזילאי נוחת\nבין הונגריה לאיטליה."
  },
  {
    "i": 273,
    "start": "00:19:50.920",
    "end": "00:19:54.160",
    "text": "אריקה, מה\nהופך את הפאווה לברזילאית?"
  },
  {
    "i": 274,
    "start": "00:19:54.320",
    "end": "00:19:58.160",
    "text": "אנחנו משתמשים בהרבה\nחלב מרוכז בברזיל."
  },
  {
    "i": 275,
    "start": "00:19:58.320",
    "end": "00:20:01.880",
    "text": "זה מה שגורם\nלזה להיות כל כך טעים."
  },
  {
    "i": 276,
    "start": "00:20:02.040",
    "end": "00:20:05.320",
    "text": "אידה, מה אומרות\nבלוטות הטעם שלך על פאווה?"
  },
  {
    "i": 277,
    "start": "00:20:05.480",
    "end": "00:20:08.400",
    "text": "אני אוהבת דברים מתוקים, טעים."
  },
  {
    "i": 278,
    "start": "00:20:08.560",
    "end": "00:20:12.600",
    "text": "-למה זה כל כך טעים?\n-כי אני חזירה של ממתקים."
  },
  {
    "i": 279,
    "start": "00:20:12.760",
    "end": "00:20:17.360",
    "text": "איך כוכב הרוק הכי מתוק של פלקופינג\nיתאר את הקינוח?"
  },
  {
    "i": 280,
    "start": "00:20:17.520",
    "end": "00:20:22.600",
    "text": "-הרגיש חו\"ל, קיצי.\n-איזה טוב."
  },
  {
    "i": 281,
    "start": "00:20:22.760",
    "end": "00:20:25.360",
    "text": "אז נכוון לקיץ."
  },
  {
    "i": 282,
    "start": "00:20:25.520",
    "end": "00:20:31.120",
    "text": "אתם לא כאן רק\nכדי ליהנות, נכון?"
  },
  {
    "i": 283,
    "start": "00:20:31.280",
    "end": "00:20:35.000",
    "text": "אנחנו גם מתחרים. אפילו לא חשבתי על זה עדיין."
  },
  {
    "i": 284,
    "start": "00:20:35.160",
    "end": "00:20:40.000",
    "text": "אתם יודעים מה, כולנו מנצחים בכל זאת. נכון?"
  },
  {
    "i": 285,
    "start": "00:20:40.160",
    "end": "00:20:43.840",
    "text": "כמו שזלאטן אף פעם לא אמר. זמן לסגור את הערב."
  },
  {
    "i": 286,
    "start": "00:20:44.000",
    "end": "00:20:47.880",
    "text": "תודה רבה מאוד\nשבראתם, לחיים."
  },
  {
    "i": 287,
    "start": "00:20:48.040",
    "end": "00:20:52.760",
    "text": "-מגנוס, איך היה הערב?\n-יפהפה."
  },
  {
    "i": 288,
    "start": "00:20:52.920",
    "end": "00:20:59.400",
    "text": "-כמו אגדה קטנה.\n-שבה רוקדים סמבה בקרנבל."
  },
  {
    "i": 289,
    "start": "00:21:01.920",
    "end": "00:21:04.560",
    "text": "ביי!"
  },
  {
    "i": 290,
    "start": "00:21:04.720",
    "end": "00:21:09.880",
    "text": "הם הלכו? הרי היינו צריכים גם ציון. - מרקוס, מה הנימוק שלך?"
  },
  {
    "i": 291,
    "start": "00:21:10.040",
    "end": "00:21:15.160",
    "text": "אריקה הייתה מארחת פנטסטית. האוכל\nהיה קצת מתוק, אז אריקה מקבלת שבע."
  },
  {
    "i": 292,
    "start": "00:21:15.320",
    "end": "00:21:18.640",
    "text": "-מגנוס?\n-אריקה מקבלת ממני שבע."
  },
  {
    "i": 293,
    "start": "00:21:18.800",
    "end": "00:21:22.040",
    "text": "אז אריקה צריכה מקסימום מאידה\nכדי לקחת את ההובלה."
  },
  {
    "i": 294,
    "start": "00:21:22.200",
    "end": "00:21:25.640",
    "text": "-מה יוצא?\n-אריקה מקבלת ממני שמונה."
  },
  {
    "i": 295,
    "start": "00:21:25.800",
    "end": "00:21:29.440",
    "text": "עם 22 נקודות אריקה נוחתת\nבעקבי מרקוס ומגנוס-"
  },
  {
    "i": 296,
    "start": "00:21:29.600",
    "end": "00:21:33.520",
    "text": "-שמובילים על 23 נקודות. מחר הגמר."
  },
  {
    "i": 297,
    "start": "00:21:33.680",
    "end": "00:21:37.200",
    "text": "אז אידה תראה\nמה יש לה בשרוול הסינר."
  },
  {
    "i": 298,
    "start": "00:21:37.360",
    "end": "00:21:41.200",
    "text": "האורחים מעלים את \"Raskens\"."
  },
  {
    "i": 299,
    "start": "00:21:41.360",
    "end": "00:21:44.160",
    "text": "\"אני הולך לעזאזל\nלאיזה כיוון שאני רוצה!\""
  },
  {
    "i": 300,
    "start": "00:21:44.320",
    "end": "00:21:49.400",
    "text": "-זו תהיה ארוחה רומנטית צרפתית.\n-הגבינה צרפתית, שום דבר אחר."
  },
  {
    "i": 301,
    "start": "00:21:49.560",
    "end": "00:21:53.680",
    "text": "נגלה מי ימלא\nאת מרתף הגבינות בזהב של פלביגדן."
  },
  {
    "i": 302,
    "start": "00:21:53.840",
    "end": "00:21:57.040",
    "text": "-אוי.\n-זהירות, זה היה קרוב מאוד."
  },
  {
    "i": 303,
    "start": "00:21:57.200",
    "end": "00:21:59.920",
    "text": "-נהייתי כל כך...\n-כל כך מה?"
  },
  {
    "i": 304,
    "start": "00:22:00.080",
    "end": "00:22:02.760",
    "text": "כתוביות: פטר למפינן\nIyuno"
  }
]