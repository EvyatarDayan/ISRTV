c680b5907b51428885112a82890afb87
00:23:25.520 --> 00:23:26.680 align:left position:22%
<c.teletext>Det är det jag inte vet.</c>

6846d7cdeb464aa2867ffecf06a1b4f0
00:23:26.840 --> 00:23:29.600 align:left position:22%
