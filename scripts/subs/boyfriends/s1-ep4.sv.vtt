d05a87862f294d3a9af3d55a5b1075af
00:27:19.920 --> 00:27:23.760 align:left position:22%
<c.teletext>–Va?!
–Riktiga kille... Men första gången.</c>

fa9635c4c5084e3fa7cfc4c2551a4da5
00:27:23.920 --> 00:27:26.320 align:left position:22%
<c.teletext>Precis här!</c>

fa069fbdf9ad45ed96b8b5784b11a4c0
00:27:26.480 --> 00:27:28.240 align:left position:22%
