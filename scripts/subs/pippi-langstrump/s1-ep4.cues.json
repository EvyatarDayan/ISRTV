[
  {
    "i": 0,
    "start": "00:00:21.320",
    "end": "00:00:23.440",
    "text": "Bra!"
  },
  {
    "i": 1,
    "start": "00:00:35.320",
    "end": "00:00:42.160",
    "text": "Hej! Kastar ni pil? Hämta pilarna,\nså ska jag ge er en snabblektion."
  },
  {
    "i": 2,
    "start": "00:00:57.560",
    "end": "00:01:03.080",
    "text": "–Så där!\n–Äh, det var väl inget vidare."
  },
  {
    "i": 3,
    "start": "00:01:04.680",
    "end": "00:01:06.280",
    "text": "Äh!"
  },
  {
    "i": 4,
    "start": "00:01:16.840",
    "end": "00:01:22.480",
    "text": "Tommy och Annika! TOMMY OCH ANNIKA!"
  },
  {
    "i": 5,
    "start": "00:01:23.120",
    "end": "00:01:30.680",
    "text": "Det där gick inte bra. Jag ska visa\nett trick. Så här: ett, två, tre..."
  },
  {
    "i": 6,
    "start": "00:01:32.560",
    "end": "00:01:37.240",
    "text": "–Äh!\n–Ja, det är jättebra."
  },
  {
    "i": 7,
    "start": "00:01:37.400",
    "end": "00:01:41.400",
    "text": "–Inte så dåligt, va?\n–TOMMY OCH ANNIKA!"
  },
  {
    "i": 8,
    "start": "00:01:41.560",
    "end": "00:01:48.480",
    "text": "–Hej, Pippi. Vilka fina drakar!\n–Har du gjort dem själv?"
  },
  {
    "i": 9,
    "start": "00:01:48.640",
    "end": "00:01:51.880",
    "text": "Ja. Vill ni segla med dem?"
  },
  {
    "i": 10,
    "start": "00:01:52.040",
    "end": "00:01:58.040",
    "text": "–En utflykt? En drak-utflykt?\n–Jag ska fråga mamma om vi får."
  },
  {
    "i": 11,
    "start": "00:01:58.200",
    "end": "00:02:01.960",
    "text": "–Mamma!\n–Ja?"
  },
  {
    "i": 12,
    "start": "00:02:02.120",
    "end": "00:02:05.080",
    "text": "Mamma?"
  },
  {
    "i": 13,
    "start": "00:02:06.760",
    "end": "00:02:11.080",
    "text": "–Var är du, mamma?\n–Jag är här."
  },
  {
    "i": 14,
    "start": "00:02:13.400",
    "end": "00:02:21.480",
    "text": "Pippi har gjort drakar, och vi ska ut\nmed hästen och göra en massa saker."
  },
  {
    "i": 15,
    "start": "00:02:21.640",
    "end": "00:02:26.840",
    "text": "–Det kan vi väl få?\n–Rida på DEN stora hästen?"
  },
  {
    "i": 16,
    "start": "00:02:27.000",
    "end": "00:02:31.200",
    "text": "Ja. Den är\njättesnäll. Pippi har lärt oss rida."
  },
  {
    "i": 17,
    "start": "00:02:39.520",
    "end": "00:02:43.440",
    "text": "Lilla gubben, vart ska du ta vägen?"
  },
  {
    "i": 18,
    "start": "00:02:45.840",
    "end": "00:02:49.840",
    "text": "Stå här och beta. Vi kommer strax."
  },
  {
    "i": 19,
    "start": "00:03:02.920",
    "end": "00:03:07.800",
    "text": "–Hej, Pippi. Ska vi ta en match?\n–Ja."
  },
  {
    "i": 20,
    "start": "00:03:15.880",
    "end": "00:03:24.200",
    "text": "Nu ska vi se... Man ställer sig\nmed vänster fot så och höger så."
  },
  {
    "i": 21,
    "start": "00:03:24.360",
    "end": "00:03:31.200",
    "text": "Håll pilen med pekfingret och tummen.\nSen har man en liten ceremoni."
  },
  {
    "i": 22,
    "start": "00:03:31.360",
    "end": "00:03:34.560",
    "text": "En, två, tre..."
  },
  {
    "i": 23,
    "start": "00:03:34.720",
    "end": "00:03:38.480",
    "text": "Äsch! En, två, tre..."
  },
  {
    "i": 24,
    "start": "00:03:42.840",
    "end": "00:03:49.960",
    "text": "Äh! Beror det på vinden, månntro?\nJag försöker igen. En, två, tre..."
  },
  {
    "i": 25,
    "start": "00:03:52.640",
    "end": "00:03:57.160",
    "text": "–Vi får följa med!\n–Då ger vi oss i väg."
  },
  {
    "i": 26,
    "start": "00:03:57.320",
    "end": "00:04:02.600",
    "text": "–Pippi, ska du inte kasta?\n–Det kan jag väl."
  },
  {
    "i": 27,
    "start": "00:04:19.800",
    "end": "00:04:23.840",
    "text": "–Hej då!\n–Hej, hej..."
  },
  {
    "i": 28,
    "start": "00:04:27.880",
    "end": "00:04:31.680",
    "text": "Sven! Sven lille!"
  },
  {
    "i": 29,
    "start": "00:04:33.560",
    "end": "00:04:39.960",
    "text": "–Tror du Pippi kan ta hand om barnen?\n–Ja. Tänk, det tror jag!"
  },
  {
    "i": 30,
    "start": "00:06:38.880",
    "end": "00:06:45.280",
    "text": "Jag drömmer i dess skugga\nså mången vacker dröm"
  },
  {
    "i": 31,
    "start": "00:06:48.720",
    "end": "00:06:56.880",
    "text": "Jag såg i hennes...la la laaa\nla laaaa la la...mig då"
  },
  {
    "i": 32,
    "start": "00:07:06.800",
    "end": "00:07:10.120",
    "text": "...så mången vacker dröm"
  },
  {
    "i": 33,
    "start": "00:07:10.280",
    "end": "00:07:17.600",
    "text": "La laaa la la la laaa\nså mången vacker dröm"
  },
  {
    "i": 34,
    "start": "00:07:19.960",
    "end": "00:07:26.120",
    "text": "När du och jag blir gamla\noch livet är förbi"
  },
  {
    "i": 35,
    "start": "00:07:26.280",
    "end": "00:07:32.600",
    "text": "jag drömmer om den våren\nmed mandelblom uti"
  },
  {
    "i": 36,
    "start": "00:07:32.760",
    "end": "00:07:39.160",
    "text": "Jag såg i hennes ögon\ntra laaa tra la la laaa..."
  },
  {
    "i": 37,
    "start": "00:07:43.400",
    "end": "00:07:47.160",
    "text": "...med mandelblom uti"
  },
  {
    "i": 38,
    "start": "00:07:48.200",
    "end": "00:07:52.520",
    "text": "När du och jag har stuckit"
  },
  {
    "i": 39,
    "start": "00:07:52.680",
    "end": "00:07:57.080",
    "text": "och snuten, han är kvar..."
  },
  {
    "i": 40,
    "start": "00:08:07.320",
    "end": "00:08:09.600",
    "text": "Stanna!"
  },
  {
    "i": 41,
    "start": "00:08:16.120",
    "end": "00:08:22.440",
    "text": "Vänta! Stanna – annars ska ni\nfå se på annat! I lagens namn..."
  },
  {
    "i": 42,
    "start": "00:09:17.280",
    "end": "00:09:25.280",
    "text": "–Å, om man kunde flyga!\n–Det kan väl inte vara så omöjligt."
  },
  {
    "i": 43,
    "start": "00:09:25.440",
    "end": "00:09:30.760",
    "text": "–Flyga kan man ju inte!\n–Jag har aldrig försökt."
  },
  {
    "i": 44,
    "start": "00:09:30.920",
    "end": "00:09:34.760",
    "text": "Jag kanske flyger som en örn."
  },
  {
    "i": 45,
    "start": "00:09:39.520",
    "end": "00:09:44.720",
    "text": "–Nej, du får inte!\n–Låt bli, Pippi!"
  },
  {
    "i": 46,
    "start": "00:09:44.880",
    "end": "00:09:52.160",
    "text": "Flyg, fula fluga, flyg!\nOch den fula flugan flög..."
  },
  {
    "i": 47,
    "start": "00:10:05.520",
    "end": "00:10:09.160",
    "text": "Hej, hej! Det gick inte."
  },
  {
    "i": 48,
    "start": "00:10:11.760",
    "end": "00:10:14.840",
    "text": "Det är svårt att flyga som en örn."
  },
  {
    "i": 49,
    "start": "00:10:15.000",
    "end": "00:10:21.840",
    "text": "Man måste nog öva mycket och\nflaxa fortare, som en LITEN fågel."
  },
  {
    "i": 50,
    "start": "00:10:25.440",
    "end": "00:10:29.600",
    "text": "Hur är det där uppe, Herr Nilsson?"
  },
  {
    "i": 51,
    "start": "00:10:30.960",
    "end": "00:10:35.840",
    "text": "Vad sa du? Du måste skrika högre!"
  },
  {
    "i": 52,
    "start": "00:10:36.800",
    "end": "00:10:42.040",
    "text": "Är det härligt?"
  },
  {
    "i": 53,
    "start": "00:10:36.800",
    "end": "00:10:42.040",
    "text": "APAN TJATTRAR"
  },
  {
    "i": 54,
    "start": "00:10:47.240",
    "end": "00:10:51.120",
    "text": "Ja, han säger att det är härligt."
  },
  {
    "i": 55,
    "start": "00:10:59.520",
    "end": "00:11:06.480",
    "text": "Du flyger mycket bättre än jag,\nHerr Nilsson. Som en örn..."
  },
  {
    "i": 56,
    "start": "00:11:09.920",
    "end": "00:11:14.720",
    "text": "Det bodde en drake\ninne i den här grottan."
  },
  {
    "i": 57,
    "start": "00:11:24.720",
    "end": "00:11:30.720",
    "text": "Det var en RIKTIG drake\n– en sån som sprutar eld."
  },
  {
    "i": 58,
    "start": "00:11:39.160",
    "end": "00:11:45.920",
    "text": "Nånstans inne i grottan skulle\ndraken fånga oss och äta upp oss."
  },
  {
    "i": 59,
    "start": "00:12:15.680",
    "end": "00:12:19.760",
    "text": "–AAAAAAH!\n–Hjälp!"
  },
  {
    "i": 60,
    "start": "00:12:19.920",
    "end": "00:12:25.040",
    "text": "–Mamma, hjälp!\n–OAAAAAAH OAAAAAAH!"
  },
  {
    "i": 61,
    "start": "00:12:42.760",
    "end": "00:12:45.800",
    "text": "OAAAAUUU..."
  },
  {
    "i": 62,
    "start": "00:12:46.640",
    "end": "00:12:52.240",
    "text": "Vi låtsas att när jag är\npå den här stenen kan du inte ta mig."
  },
  {
    "i": 63,
    "start": "00:12:52.400",
    "end": "00:12:56.480",
    "text": "Ja, det kan vi låtsas. OAAAA..."
  },
  {
    "i": 64,
    "start": "00:12:56.640",
    "end": "00:13:01.680",
    "text": "Dumma lilla drake\nsom inte kan ta mig! Ha ha!"
  },
  {
    "i": 65,
    "start": "00:13:05.560",
    "end": "00:13:08.480",
    "text": "Du kan inte ta mig!"
  },
  {
    "i": 66,
    "start": "00:13:11.960",
    "end": "00:13:17.480",
    "text": "Dumma lilla drake\nsom inte kan ta mig!"
  },
  {
    "i": 67,
    "start": "00:13:25.000",
    "end": "00:13:29.640",
    "text": "–Mjaaau, mjaaau...\n–Hej, gamla drake!"
  },
  {
    "i": 68,
    "start": "00:13:29.800",
    "end": "00:13:33.960",
    "text": "MOÄÄÄÄÄH!"
  },
  {
    "i": 69,
    "start": "00:13:36.640",
    "end": "00:13:40.960",
    "text": "Vi låtsas\natt du inte kan ta oss här uppe."
  },
  {
    "i": 70,
    "start": "00:13:41.120",
    "end": "00:13:44.920",
    "text": "Var KAN jag ta er, då?"
  },
  {
    "i": 71,
    "start": "00:13:53.280",
    "end": "00:13:55.680",
    "text": "Bjä bjä bjä..."
  },
  {
    "i": 72,
    "start": "00:13:55.840",
    "end": "00:13:58.920",
    "text": "SSSSSSSCH!"
  },
  {
    "i": 73,
    "start": "00:14:05.720",
    "end": "00:14:08.320",
    "text": "Nu klättrar jag ner."
  },
  {
    "i": 74,
    "start": "00:14:08.480",
    "end": "00:14:11.120",
    "text": "OOOAAAAUH!"
  },
  {
    "i": 75,
    "start": "00:14:11.280",
    "end": "00:14:13.720",
    "text": "Dumma, dumma drake!"
  },
  {
    "i": 76,
    "start": "00:14:24.040",
    "end": "00:14:30.000",
    "text": "–Låtsas somna, så vi kan rymma.\n–Ja..."
  },
  {
    "i": 77,
    "start": "00:15:02.200",
    "end": "00:15:04.400",
    "text": "MOAAAH!"
  },
  {
    "i": 78,
    "start": "00:15:17.000",
    "end": "00:15:19.080",
    "text": "Näää!"
  },
  {
    "i": 79,
    "start": "00:15:27.320",
    "end": "00:15:33.160",
    "text": "Varför kommer hon aldrig?\nVi går och ser efter."
  },
  {
    "i": 80,
    "start": "00:15:35.880",
    "end": "00:15:39.600",
    "text": "Vad är det, Pippi?"
  },
  {
    "i": 81,
    "start": "00:15:39.760",
    "end": "00:15:43.400",
    "text": "Vad är det?"
  },
  {
    "i": 82,
    "start": "00:15:43.560",
    "end": "00:15:46.920",
    "text": "Titta – han är död."
  },
  {
    "i": 83,
    "start": "00:15:49.840",
    "end": "00:15:51.680",
    "text": "Ååå!"
  },
  {
    "i": 84,
    "start": "00:15:51.840",
    "end": "00:15:56.000",
    "text": "Om jag kunde göra honom levande..."
  },
  {
    "i": 85,
    "start": "00:15:56.160",
    "end": "00:16:00.280",
    "text": "Det går inte. Är man död, så är man."
  },
  {
    "i": 86,
    "start": "00:16:00.440",
    "end": "00:16:03.680",
    "text": "Vi måste begrava honom."
  },
  {
    "i": 87,
    "start": "00:16:39.440",
    "end": "00:16:43.560",
    "text": "Så där, ja – nu är han begravd."
  },
  {
    "i": 88,
    "start": "00:16:43.720",
    "end": "00:16:49.040",
    "text": "Det ska egentligen\nvara ett kors på graven."
  },
  {
    "i": 89,
    "start": "00:16:49.200",
    "end": "00:16:53.560",
    "text": "–Han kan få min drake som kors.\n–Min med!"
  },
  {
    "i": 90,
    "start": "00:16:53.720",
    "end": "00:16:57.080",
    "text": "Min med. Men sen har vi ju inga..."
  },
  {
    "i": 91,
    "start": "00:16:57.240",
    "end": "00:17:00.960",
    "text": "Äh, jag kan göra nya."
  },
  {
    "i": 92,
    "start": "00:17:18.240",
    "end": "00:17:22.360",
    "text": "Man ska ju sjunga på begravningar."
  },
  {
    "i": 93,
    "start": "00:17:22.520",
    "end": "00:17:27.920",
    "text": "Något sorgligt då – inte Gubben Noak."
  },
  {
    "i": 94,
    "start": "00:17:28.080",
    "end": "00:17:33.800",
    "text": "Jag kan ingen sorglig sång.\nKan du, Pippi?"
  },
  {
    "i": 95,
    "start": "00:17:35.600",
    "end": "00:17:40.200",
    "text": "VEMODIG MELODI"
  },
  {
    "i": 96,
    "start": "00:18:32.120",
    "end": "00:18:38.920",
    "text": "Adjö, fågel. När du ser drakarna,\nminns du hur det var att flyga."
  },
  {
    "i": 97,
    "start": "00:18:42.880",
    "end": "00:18:47.800",
    "text": "–Vart tog din pinne vägen, Tommy?\n–Jag vet inte."
  },
  {
    "i": 98,
    "start": "00:18:57.000",
    "end": "00:19:01.840",
    "text": "Titta – där är Tommys!\nMin är borta."
  },
  {
    "i": 99,
    "start": "00:19:16.600",
    "end": "00:19:19.600",
    "text": "Där kommer den ju!"
  },
  {
    "i": 100,
    "start": "00:19:26.680",
    "end": "00:19:29.720",
    "text": "Där kommer din, Annika!"
  },
  {
    "i": 101,
    "start": "00:19:45.560",
    "end": "00:19:49.080",
    "text": "Oj! Den klarade sig."
  },
  {
    "i": 102,
    "start": "00:19:50.800",
    "end": "00:19:55.640",
    "text": "Hallå där! Har ni några mackor över?"
  },
  {
    "i": 103,
    "start": "00:19:55.800",
    "end": "00:20:01.080",
    "text": "–Är ni hungriga?\n–Ja, vi vill så gärna ha en macka."
  },
  {
    "i": 104,
    "start": "00:20:01.240",
    "end": "00:20:05.080",
    "text": "–Eller två...\n–Vänta lite då."
  },
  {
    "i": 105,
    "start": "00:20:10.160",
    "end": "00:20:14.080",
    "text": "–Det är väl HON...?\n–Visst."
  },
  {
    "i": 106,
    "start": "00:20:14.240",
    "end": "00:20:20.440",
    "text": "–Är det du som är Pippi Långstrump?\n–Ja. Känner ni inte igen mig?"
  },
  {
    "i": 107,
    "start": "00:20:22.840",
    "end": "00:20:27.920",
    "text": "Jag sa ju att ni kunde hälsa på,\nom ni ville."
  },
  {
    "i": 108,
    "start": "00:20:29.920",
    "end": "00:20:33.760",
    "text": "–Ett skepp kommer lastat!\n–Vad då med?"
  },
  {
    "i": 109,
    "start": "00:20:33.920",
    "end": "00:20:36.560",
    "text": "Prickig korv!"
  },
  {
    "i": 110,
    "start": "00:20:43.920",
    "end": "00:20:47.240",
    "text": "Mmmm... Det ska bli gott."
  },
  {
    "i": 111,
    "start": "00:21:04.680",
    "end": "00:21:09.320",
    "text": "–Ett skepp kommer lastat!\n–Vad då med?"
  },
  {
    "i": 112,
    "start": "00:21:09.480",
    "end": "00:21:12.040",
    "text": "Pannkakor!"
  },
  {
    "i": 113,
    "start": "00:21:24.920",
    "end": "00:21:29.880",
    "text": "–Ett skepp kommer lastat!\n–Det är min tur! – Med vad?"
  },
  {
    "i": 114,
    "start": "00:21:30.040",
    "end": "00:21:34.200",
    "text": "–Med pägg!\n–Vad är det?"
  },
  {
    "i": 115,
    "start": "00:21:34.360",
    "end": "00:21:40.120",
    "text": "Ägg som tuppar värper.\nDet hörs väl? Pägg..."
  },
  {
    "i": 116,
    "start": "00:21:46.480",
    "end": "00:21:51.720",
    "text": "–Tack! Det var bussigt.\n–Ja, det var PUSSigt."
  },
  {
    "i": 117,
    "start": "00:21:55.200",
    "end": "00:22:00.080",
    "text": "Herr Nilsson! Herr Nilsson!"
  },
  {
    "i": 118,
    "start": "00:22:01.880",
    "end": "00:22:06.240",
    "text": "HERR NILSSON!"
  },
  {
    "i": 119,
    "start": "00:22:06.400",
    "end": "00:22:09.520",
    "text": "Herr Nilsson!"
  },
  {
    "i": 120,
    "start": "00:22:27.680",
    "end": "00:22:30.080",
    "text": "Herr Nilsson!"
  },
  {
    "i": 121,
    "start": "00:22:32.280",
    "end": "00:22:38.720",
    "text": "–Herr Nilsson!\n–HERR NILSSON!"
  },
  {
    "i": 122,
    "start": "00:22:42.120",
    "end": "00:22:45.360",
    "text": "Herr Nilsson!"
  },
  {
    "i": 123,
    "start": "00:22:50.280",
    "end": "00:22:54.360",
    "text": "HERR NIIILSSOOON!"
  },
  {
    "i": 124,
    "start": "00:23:12.320",
    "end": "00:23:15.040",
    "text": "Herr Nilsson!"
  },
  {
    "i": 125,
    "start": "00:23:18.400",
    "end": "00:23:24.360",
    "text": "Vi hittar honom ALDRIG.\nDet finns minst tusen träd i skogen."
  },
  {
    "i": 126,
    "start": "00:23:25.880",
    "end": "00:23:28.840",
    "text": "HERR NILSSON!"
  },
  {
    "i": 127,
    "start": "00:23:40.720",
    "end": "00:23:43.760",
    "text": "HERR NIIILSSOOON!"
  },
  {
    "i": 128,
    "start": "00:23:46.640",
    "end": "00:23:50.960",
    "text": "Herr Nilsson, kom fram!"
  },
  {
    "i": 129,
    "start": "00:23:51.120",
    "end": "00:23:55.360",
    "text": "–Oj!\n–Pippi, vad ska vi göra?"
  },
  {
    "i": 130,
    "start": "00:24:27.480",
    "end": "00:24:31.560",
    "text": "–Bra, Pippi!\n–Heja, Pippi!"
  },
  {
    "i": 131,
    "start": "00:24:59.680",
    "end": "00:25:04.840",
    "text": "–Sven, ska du hålla på hela dagen?\n–Ja, det ska jag!"
  },
  {
    "i": 132,
    "start": "00:25:09.920",
    "end": "00:25:15.520",
    "text": "–Hej! Är ni äntligen hemma nu?\n–Vi har haft jättekul!"
  },
  {
    "i": 133,
    "start": "00:25:17.680",
    "end": "00:25:24.040",
    "text": "–Håller du på och kastar pil ÄN?\n–Ja, tänk att jag gör det!"
  },
  {
    "i": 134,
    "start": "00:25:25.560",
    "end": "00:25:31.240",
    "text": "Pippi...det där du gjorde i morse\nvar väl en ren tillfällighet?"
  },
  {
    "i": 135,
    "start": "00:25:31.400",
    "end": "00:25:38.560",
    "text": "–Kan du inte visa mig en gång till?\n–Jo då. Jag bara gjorde så här..."
  },
  {
    "i": 136,
    "start": "00:25:50.560",
    "end": "00:25:53.440",
    "text": "Näää!"
  },
  {
    "i": 137,
    "start": "00:26:00.320",
    "end": "00:26:04.360",
    "text": "Här kommer Pippi Långstrump!\nTjolahopp, tjolahej, tjolahoppsansa"
  },
  {
    "i": 138,
    "start": "00:26:04.520",
    "end": "00:26:08.720",
    "text": "Här kommer Pippi Långstrump,\nhär kommer faktiskt jag"
  },
  {
    "i": 139,
    "start": "00:26:08.880",
    "end": "00:26:12.880",
    "text": "Har du sett min apa,\nmin fina söta lilla apa?"
  },
  {
    "i": 140,
    "start": "00:26:13.040",
    "end": "00:26:17.520",
    "text": "Har du sett Herr Nilsson?\nJa, han heter faktiskt så"
  },
  {
    "i": 141,
    "start": "00:26:17.680",
    "end": "00:26:21.480",
    "text": "Har du sett min villa,\nmin Villa Villekulla-villa?"
  },
  {
    "i": 142,
    "start": "00:26:21.640",
    "end": "00:26:25.720",
    "text": "Vill du, vill du veta\nvarför villan heter så?"
  },
  {
    "i": 143,
    "start": "00:26:25.880",
    "end": "00:26:30.080",
    "text": "Där bor ju Pippi Långstrump!\nTjolahopp, tjolahej, tjolahoppsansa"
  },
  {
    "i": 144,
    "start": "00:26:30.240",
    "end": "00:26:34.360",
    "text": "Där bor ju Pippi Långstrump,\nja, där bor faktiskt jag"
  },
  {
    "i": 145,
    "start": "00:26:34.520",
    "end": "00:26:38.520",
    "text": "Det är inte illa\n– jag har ju apa, häst och villa"
  },
  {
    "i": 146,
    "start": "00:26:38.680",
    "end": "00:26:43.000",
    "text": "Kappsäck full med pengar,\ndet är också bra att ha"
  },
  {
    "i": 147,
    "start": "00:26:43.160",
    "end": "00:26:47.440",
    "text": "Kom nu, alla vänner,\nvarenda kotte som jag känner!"
  },
  {
    "i": 148,
    "start": "00:26:47.600",
    "end": "00:26:52.040",
    "text": "Nu ska vi leva loppan!\nTjolahej, tjolahoppsansa..."
  },
  {
    "i": 149,
    "start": "00:26:56.600",
    "end": "00:26:59.920",
    "text": "Textning: Inger Sjöstrand\nSveriges Television AB"
  }
]