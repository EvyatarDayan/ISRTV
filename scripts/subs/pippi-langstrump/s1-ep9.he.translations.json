[
  {
    "i": 0,
    "start": "00:00:00.560",
    "end": "00:00:05.240",
    "text": "היי לך, סוסיק!\nעכשיו בבת אחת על הגדם"
  },
  {
    "i": 1,
    "start": "00:00:05.400",
    "end": "00:00:10.000",
    "text": "תהיה ממש יפה ומסופר,\nכי ככה אני רוצה שתהיה"
  },
  {
    "i": 2,
    "start": "00:00:10.160",
    "end": "00:00:15.080",
    "text": "סינקדוס בכוכב,\nקצת סטירה בבצק הפנקייקס"
  },
  {
    "i": 3,
    "start": "00:00:15.240",
    "end": "00:00:19.640",
    "text": "פרץ בקולי-קוליפייס,\nאוי אוי, כמה שזה טוב!"
  },
  {
    "i": 4,
    "start": "00:00:19.800",
    "end": "00:00:24.000",
    "text": "הנה טיקה טוקה לייבן,\nצ'ולהופ, צ'ולהיי, צ'ולהופסנסה"
  },
  {
    "i": 5,
    "start": "00:00:24.160",
    "end": "00:00:28.960",
    "text": "הנה טיקה טוקה לייבן\nוהנה אתה ואני"
  },
  {
    "i": 6,
    "start": "00:00:29.120",
    "end": "00:00:33.800",
    "text": "היי לך, סוס קטן!\nאתה די מתוק, בכלל"
  },
  {
    "i": 7,
    "start": "00:00:33.960",
    "end": "00:00:38.720",
    "text": "אתה חבר מעולה\n– הכי טוב שיש"
  },
  {
    "i": 8,
    "start": "00:00:38.880",
    "end": "00:00:43.280",
    "text": "סינקדוס בכוכב,\nקצת סטירה בבצק הפנקייקס"
  },
  {
    "i": 9,
    "start": "00:00:43.440",
    "end": "00:00:48.080",
    "text": "פרץ בקולי-קוליפייס,\nאוי אוי, כמה שזה טוב!"
  },
  {
    "i": 10,
    "start": "00:00:48.240",
    "end": "00:00:52.560",
    "text": "הנה טיקה טוקה לייבן,\nצ'ולהופ, צ'ולהיי, צ'ולהופסנסה"
  },
  {
    "i": 11,
    "start": "00:00:52.720",
    "end": "00:00:57.280",
    "text": "הנה טיקה טוקה לייבן\nוהנה אתה ואני"
  },
  {
    "i": 12,
    "start": "00:00:57.440",
    "end": "00:01:01.640",
    "text": "היי לך, נער קטן!\nהנה תקבל שקית"
  },
  {
    "i": 13,
    "start": "00:01:01.800",
    "end": "00:01:06.160",
    "text": "שקית מלאה שיבולת שועל,\nכי ככה אני רוצה שיהיה לך"
  },
  {
    "i": 14,
    "start": "00:01:06.320",
    "end": "00:01:10.760",
    "text": "סינקדוס בכוכב,\nקצת סטירה בבצק הפנקייקס"
  },
  {
    "i": 15,
    "start": "00:01:10.920",
    "end": "00:01:15.280",
    "text": "פרץ בקולי-קוליפייס,\nאוי אוי, כמה שזה טוב!"
  },
  {
    "i": 16,
    "start": "00:01:15.440",
    "end": "00:01:19.720",
    "text": "הנה טיקה טוקה לייבן,\nצ'ולהופ, צ'ולהיי, צ'ולהופסנסה"
  },
  {
    "i": 17,
    "start": "00:01:19.880",
    "end": "00:01:24.720",
    "text": "הנה טיקה טוקה לייבן\nוהנה אתה ואני..."
  },
  {
    "i": 18,
    "start": "00:01:27.160",
    "end": "00:01:31.840",
    "text": "בוקר טוב, מר נילסון.\nהנה הארוחת בוקר שלך."
  },
  {
    "i": 19,
    "start": "00:01:35.000",
    "end": "00:01:39.560",
    "text": "פיפי, הנה הארוחת בוקר שלך."
  },
  {
    "i": 20,
    "start": "00:01:54.160",
    "end": "00:01:58.600",
    "text": "עוגת שמנת בבוקר זה פצצה!"
  },
  {
    "i": 21,
    "start": "00:02:19.120",
    "end": "00:02:22.320",
    "text": "מה? לא שבעת?"
  },
  {
    "i": 22,
    "start": "00:02:22.480",
    "end": "00:02:29.280",
    "text": "קח קצת דייסה אז. יש\nבסיר על השיש."
  },
  {
    "i": 23,
    "start": "00:02:57.680",
    "end": "00:03:01.320",
    "text": "זו הייתה ארוחת בוקר לא רעה!"
  },
  {
    "i": 24,
    "start": "00:03:05.280",
    "end": "00:03:09.920",
    "text": "מוזיקה אסיאתית"
  },
  {
    "i": 25,
    "start": "00:03:38.720",
    "end": "00:03:42.400",
    "text": "מאיפה הבאתי את זה?"
  },
  {
    "i": 26,
    "start": "00:03:45.840",
    "end": "00:03:49.280",
    "text": "מיוקוהמה, אני חושבת."
  },
  {
    "i": 27,
    "start": "00:03:56.360",
    "end": "00:04:00.440",
    "text": "חכה, תראה משהו כיף!"
  },
  {
    "i": 28,
    "start": "00:04:21.840",
    "end": "00:04:28.520",
    "text": "מה אמרת עכשיו? זה לא\nיפה עם... דבר כזה..."
  },
  {
    "i": 29,
    "start": "00:04:30.200",
    "end": "00:04:33.000",
    "text": "אה, אני לא יודעת איך קוראים להם."
  },
  {
    "i": 30,
    "start": "00:04:33.160",
    "end": "00:04:37.960",
    "text": "פרח יקוהמה... או ורד-פנוסק..."
  },
  {
    "i": 31,
    "start": "00:04:38.120",
    "end": "00:04:41.040",
    "text": "או ספאנק......"
  },
  {
    "i": 32,
    "start": "00:04:41.200",
    "end": "00:04:44.920",
    "text": "ספאנק... ספאנק?"
  },
  {
    "i": 33,
    "start": "00:04:49.000",
    "end": "00:04:54.000",
    "text": "מה את חושבת, חולדה? זה ספאנק?"
  },
  {
    "i": 34,
    "start": "00:04:55.360",
    "end": "00:04:57.600",
    "text": "לא!"
  },
  {
    "i": 35,
    "start": "00:05:05.080",
    "end": "00:05:10.320",
    "text": "–ספאנק... משהו חייב להיות.\n–היי, פיפי!"
  },
  {
    "i": 36,
    "start": "00:05:10.480",
    "end": "00:05:17.520",
    "text": "–ספאנק... ספאנק... ספאנק...\n–מה קורה איתך? את חולה?"
  },
  {
    "i": 37,
    "start": "00:05:17.680",
    "end": "00:05:21.760",
    "text": "המצאתי מילה חדשה!"
  },
  {
    "i": 38,
    "start": "00:05:21.920",
    "end": "00:05:26.720",
    "text": "–איזו מילה?\n–ספאנק!"
  },
  {
    "i": 39,
    "start": "00:05:26.880",
    "end": "00:05:33.040",
    "text": "אם את לא יודעת מה זה אומר\nאז אין בזה תועלת, לא?"
  },
  {
    "i": 40,
    "start": "00:05:33.200",
    "end": "00:05:39.520",
    "text": "–מי החליט מה מילים אומרות?\n–כמה פרופסורים, כמובן."
  },
  {
    "i": 41,
    "start": "00:05:39.680",
    "end": "00:05:46.840",
    "text": "אילו מילים הם ממציאים!\nאגן ותקע עץ... וחוט."
  },
  {
    "i": 42,
    "start": "00:05:47.000",
    "end": "00:05:52.960",
    "text": "אילו מילים! אבל ספאנק\nהם נמנעים מלהמציא..."
  },
  {
    "i": 43,
    "start": "00:05:56.160",
    "end": "00:05:59.480",
    "text": "הפרופסורים האלה...."
  },
  {
    "i": 44,
    "start": "00:06:02.640",
    "end": "00:06:04.880",
    "text": "ספאנק..."
  },
  {
    "i": 45,
    "start": "00:06:08.120",
    "end": "00:06:13.800",
    "text": "איזה מזל שחשבתי על זה!\nספאנק..."
  },
  {
    "i": 46,
    "start": "00:06:13.960",
    "end": "00:06:18.280",
    "text": "–ואולי זה משהו מסוכן!\n–מה מסוכן?"
  },
  {
    "i": 47,
    "start": "00:06:18.440",
    "end": "00:06:21.760",
    "text": "חיה פראית עם ניבים..."
  },
  {
    "i": 48,
    "start": "00:06:21.920",
    "end": "00:06:25.920",
    "text": "מפלצת...\nשאוכלת ילדים וקופים!"
  },
  {
    "i": 49,
    "start": "00:06:26.080",
    "end": "00:06:27.920",
    "text": "אה!"
  },
  {
    "i": 50,
    "start": "00:06:28.080",
    "end": "00:06:31.240",
    "text": "\"אה\" אתה לא תגיד–"
  },
  {
    "i": 51,
    "start": "00:06:31.400",
    "end": "00:06:36.040",
    "text": "–אם ספאנק\nייכנס וינעץ בך שיניים!"
  },
  {
    "i": 52,
    "start": "00:06:36.200",
    "end": "00:06:38.720",
    "text": "אל תגידי ככה!"
  },
  {
    "i": 53,
    "start": "00:06:38.880",
    "end": "00:06:45.720",
    "text": "גם מר נילסון מפחד.\nאני יודעת: נבנה מלכודת ספאנק!"
  },
  {
    "i": 54,
    "start": "00:09:07.640",
    "end": "00:09:14.560",
    "text": "צ'ולהופ! כשהספאנק יפתח את הדלת\n– פאם – הכול ייפול לו על הראש."
  },
  {
    "i": 55,
    "start": "00:09:14.720",
    "end": "00:09:20.760",
    "text": "–ואיך את תצאי בעצמך?\n–יש חלונות."
  },
  {
    "i": 56,
    "start": "00:09:20.920",
    "end": "00:09:27.120",
    "text": "קצת טרחה צריך, אם רוצים\nלהציל את חייו של מר נילסון."
  },
  {
    "i": 57,
    "start": "00:09:27.280",
    "end": "00:09:31.400",
    "text": "הוא יצחק עד מוות\nכשהספאנק ייפול בפח."
  },
  {
    "i": 58,
    "start": "00:09:47.720",
    "end": "00:09:50.120",
    "text": "ספאנק..."
  },
  {
    "i": 59,
    "start": "00:09:52.240",
    "end": "00:09:54.640",
    "text": "ספאנק......"
  },
  {
    "i": 60,
    "start": "00:09:59.920",
    "end": "00:10:05.760",
    "text": "–ואולי זה לא חיה פראית...\n–אז למה עשית מלכודת?"
  },
  {
    "i": 61,
    "start": "00:10:05.920",
    "end": "00:10:11.160",
    "text": "כדי להיות בטוחה\n– אבל אני חושבת שזה משהו אחר."
  },
  {
    "i": 62,
    "start": "00:10:12.960",
    "end": "00:10:15.760",
    "text": "ספאאאנק..."
  },
  {
    "i": 63,
    "start": "00:10:17.480",
    "end": "00:10:21.400",
    "text": "ראו, אילני ספאנק יפים כאלה!"
  },
  {
    "i": 64,
    "start": "00:10:29.720",
    "end": "00:10:34.160",
    "text": "מרגישים איך עשב הספאנק מריח?"
  },
  {
    "i": 65,
    "start": "00:10:53.520",
    "end": "00:10:55.800",
    "text": "ספאנק, ספאנק..."
  },
  {
    "i": 66,
    "start": "00:10:55.960",
    "end": "00:10:59.800",
    "text": "ואולי זה משהו שמשמיע קול!"
  },
  {
    "i": 67,
    "start": "00:10:59.960",
    "end": "00:11:02.440",
    "text": "ספאנק! ספאנק!"
  },
  {
    "i": 68,
    "start": "00:11:02.600",
    "end": "00:11:07.480",
    "text": "לא, זה נשמע\nצ'יפ... צ'יפ..."
  },
  {
    "i": 69,
    "start": "00:11:11.080",
    "end": "00:11:16.960",
    "text": "לא, הטיפות אומרות\nפלופ-פלופ, פלופ, פלופ-פלופ."
  },
  {
    "i": 70,
    "start": "00:11:31.080",
    "end": "00:11:38.440",
    "text": "–זה נשמע ספאנקי.\n–לא, זה נשמע רק קלה, קלה, קלה."
  },
  {
    "i": 71,
    "start": "00:11:44.240",
    "end": "00:11:49.680",
    "text": "גם כאן אין ספאנק.\nזה נשמע רק סלאש, סלאש..."
  },
  {
    "i": 72,
    "start": "00:11:52.440",
    "end": "00:11:55.080",
    "text": "בע!"
  },
  {
    "i": 73,
    "start": "00:12:08.520",
    "end": "00:12:14.440",
    "text": "למה אתה לא יכול להגיד\nספאאנק... ספאאנק...?"
  },
  {
    "i": 74,
    "start": "00:12:17.040",
    "end": "00:12:20.000",
    "text": "בע"
  },
  {
    "i": 75,
    "start": "00:12:20.160",
    "end": "00:12:24.800",
    "text": "–בואו, תראו!\n–מה זה?"
  },
  {
    "i": 76,
    "start": "00:12:31.440",
    "end": "00:12:39.120",
    "text": "–תראו! ואולי אלה ביצי ספאנק...\n–לא, אלה ביצי קיכלי."
  },
  {
    "i": 77,
    "start": "00:12:43.600",
    "end": "00:12:47.680",
    "text": "אולי בכלל אין \"ספאנק\"."
  },
  {
    "i": 78,
    "start": "00:12:47.840",
    "end": "00:12:52.640",
    "text": "יש, יש,\nאבל אולי לא בדיוק כאן."
  },
  {
    "i": 79,
    "start": "00:12:52.800",
    "end": "00:12:56.440",
    "text": "–אז איפה?\n–נראה."
  },
  {
    "i": 80,
    "start": "00:12:57.600",
    "end": "00:13:03.040",
    "text": "–בעיר אולי נמצא אחד.\n–נראה..."
  },
  {
    "i": 81,
    "start": "00:13:24.920",
    "end": "00:13:29.880",
    "text": "רגע תראו, איזה ספאנק קטן ומתוק!"
  },
  {
    "i": 82,
    "start": "00:13:30.040",
    "end": "00:13:34.320",
    "text": "הכי חמוד שראיתי אי פעם."
  },
  {
    "i": 83,
    "start": "00:13:34.480",
    "end": "00:13:40.720",
    "text": "–הם גדלים די גדולים, נכון? עשרה מטר?\n–שטויות!"
  },
  {
    "i": 84,
    "start": "00:13:40.880",
    "end": "00:13:45.280",
    "text": "אהה, לא? יכולתי לטעות ככה?"
  },
  {
    "i": 85,
    "start": "00:13:55.520",
    "end": "00:13:59.760",
    "text": "אוי אוי!\nמסוכן לשתות ספאנק."
  },
  {
    "i": 86,
    "start": "00:14:03.680",
    "end": "00:14:09.240",
    "text": "סליחה רבה.\nגם הפעם זה היה טעות."
  },
  {
    "i": 87,
    "start": "00:14:20.880",
    "end": "00:14:28.200",
    "text": "כןןן! – תומי ואניקה,\nהיה טעים קצת ספאנק?"
  },
  {
    "i": 88,
    "start": "00:14:28.360",
    "end": "00:14:31.440",
    "text": "בחנות הממתקים?"
  },
  {
    "i": 89,
    "start": "00:14:35.960",
    "end": "00:14:41.160",
    "text": "אוי, הנה באה לקוחה ותיקה טובה!\n– עוד משהו?"
  },
  {
    "i": 90,
    "start": "00:14:41.320",
    "end": "00:14:44.160",
    "text": "שתי סוכריות על מקל."
  },
  {
    "i": 91,
    "start": "00:14:45.760",
    "end": "00:14:48.600",
    "text": "בבקשה."
  },
  {
    "i": 92,
    "start": "00:15:00.200",
    "end": "00:15:04.480",
    "text": "–מה תרצו כאן?\n–שקית גדולה של ספאנק."
  },
  {
    "i": 93,
    "start": "00:15:04.640",
    "end": "00:15:07.720",
    "text": "שיהיה פריך."
  },
  {
    "i": 94,
    "start": "00:15:07.880",
    "end": "00:15:11.480",
    "text": "ספאנק? לצערי אין לנו."
  },
  {
    "i": 95,
    "start": "00:15:11.640",
    "end": "00:15:16.000",
    "text": "יש את זה בכל חנויות הממתקים הטובות."
  },
  {
    "i": 96,
    "start": "00:15:16.160",
    "end": "00:15:19.080",
    "text": "נגמר להיום."
  },
  {
    "i": 97,
    "start": "00:15:19.240",
    "end": "00:15:22.680",
    "text": "היה לכם אתמול?"
  },
  {
    "i": 98,
    "start": "00:15:22.840",
    "end": "00:15:27.720",
    "text": "–כן, היה.\n–למה לא באתי אז?"
  },
  {
    "i": 99,
    "start": "00:15:27.880",
    "end": "00:15:34.400",
    "text": "איך נראה ספאנק? מעולם לא\nראיתי כזה. הוא היה פסים אדומים?"
  },
  {
    "i": 100,
    "start": "00:15:34.560",
    "end": "00:15:38.400",
    "text": "פסים אדומים?\nאיכ, אני לא יודעת מה זה."
  },
  {
    "i": 101,
    "start": "00:15:38.560",
    "end": "00:15:42.360",
    "text": "אולי משהו אחר\nבמקום?"
  },
  {
    "i": 102,
    "start": "00:15:42.520",
    "end": "00:15:48.840",
    "text": "–לא, אם אין ספאנק, אז...\n–בבקשה, משהו אפשר לקנות?"
  },
  {
    "i": 103,
    "start": "00:15:49.000",
    "end": "00:15:52.240",
    "text": "שלוש סוכריות, אז."
  },
  {
    "i": 104,
    "start": "00:15:54.640",
    "end": "00:15:58.480",
    "text": "–עודף...\n–זה יצא בדיוק."
  },
  {
    "i": 105,
    "start": "00:15:58.640",
    "end": "00:16:01.040",
    "text": "ברוכים השבים!"
  },
  {
    "i": 106,
    "start": "00:16:01.200",
    "end": "00:16:07.560",
    "text": "–ספאנק? מה זה?\n–אתה אמור לדעת. אל תשאל אותי!"
  },
  {
    "i": 107,
    "start": "00:16:22.560",
    "end": "00:16:30.240",
    "text": "–באמת ספאנק את רוצה?\n–אם אני אומרת ספאנק אני מתכוונת לספאנק!"
  },
  {
    "i": 108,
    "start": "00:16:30.400",
    "end": "00:16:33.720",
    "text": "כן כן... זה נכון."
  },
  {
    "i": 109,
    "start": "00:16:38.880",
    "end": "00:16:42.800",
    "text": "בואו נראה. ס... ס..."
  },
  {
    "i": 110,
    "start": "00:16:42.960",
    "end": "00:16:46.480",
    "text": "מזמרה..."
  },
  {
    "i": 111,
    "start": "00:16:46.640",
    "end": "00:16:48.760",
    "text": "שבלונות......"
  },
  {
    "i": 112,
    "start": "00:16:48.920",
    "end": "00:16:52.720",
    "text": "מקדחי קונכיות......"
  },
  {
    "i": 113,
    "start": "00:16:52.880",
    "end": "00:16:56.080",
    "text": "מנוף עם ידית......"
  },
  {
    "i": 114,
    "start": "00:16:56.240",
    "end": "00:16:59.200",
    "text": "קפיצים ספירליים......"
  },
  {
    "i": 115,
    "start": "00:16:59.360",
    "end": "00:17:02.680",
    "text": "תראו שיהיה להם!"
  },
  {
    "i": 116,
    "start": "00:17:02.840",
    "end": "00:17:04.840",
    "text": "ספו... ספו..."
  },
  {
    "i": 117,
    "start": "00:17:05.000",
    "end": "00:17:09.600",
    "text": "לא... למה את צריכה את זה?"
  },
  {
    "i": 118,
    "start": "00:17:09.760",
    "end": "00:17:14.200",
    "text": "להרוג אריות איתו, ברור."
  },
  {
    "i": 119,
    "start": "00:17:14.360",
    "end": "00:17:22.160",
    "text": "–אז קחי את זה.\n–ספאנק? לזה קוראים מגרפה."
  },
  {
    "i": 120,
    "start": "00:17:22.320",
    "end": "00:17:27.680",
    "text": "אז אני יודע:\nנסו בחנות התפירה מעבר לפינה."
  },
  {
    "i": 121,
    "start": "00:17:27.840",
    "end": "00:17:30.680",
    "text": "תודה ולהתראות!"
  },
  {
    "i": 122,
    "start": "00:17:37.160",
    "end": "00:17:40.120",
    "text": "שני חבל דילוג, בבקשה."
  },
  {
    "i": 123,
    "start": "00:17:46.840",
    "end": "00:17:52.160",
    "text": "חנות תפירה!\nמעולם לא שמעתי משהו כל כך מטופש."
  },
  {
    "i": 124,
    "start": "00:17:53.960",
    "end": "00:18:00.600",
    "text": "אם היה לי מיוּם – אז\nהייתי שואלת בחנות התפירה!"
  },
  {
    "i": 125,
    "start": "00:18:03.880",
    "end": "00:18:08.920",
    "text": "–מיוּם? מה זה?\n–תשאלו את הפרופסורים!"
  },
  {
    "i": 126,
    "start": "00:18:09.080",
    "end": "00:18:14.600",
    "text": "זו מילה אחרת\nשהם שכחו להמציא."
  },
  {
    "i": 127,
    "start": "00:18:21.960",
    "end": "00:18:28.600",
    "text": "לא, בלי ספאנק אני לא חוזרת הביתה.\nואולי יש אחד שם למעלה!"
  },
  {
    "i": 128,
    "start": "00:18:30.000",
    "end": "00:18:38.520",
    "text": "–אתם לא תאמינו... זה שערורייה!\n–לאנשים אין מוסר בימים אלה."
  },
  {
    "i": 129,
    "start": "00:18:38.680",
    "end": "00:18:42.000",
    "text": "בבקשה, קחו!"
  },
  {
    "i": 130,
    "start": "00:18:43.760",
    "end": "00:18:50.480",
    "text": "–שלום שלום!\n–פיפי, איך הגעת לשם?!"
  },
  {
    "i": 131,
    "start": "00:18:50.640",
    "end": "00:18:56.240",
    "text": "–יש כאן איזה ספאנק?\n–מישהו ברח?"
  },
  {
    "i": 132,
    "start": "00:18:56.400",
    "end": "00:19:02.000",
    "text": "–אני חושבת שכן, לצערי.\n–מה זה? זה נחש?"
  },
  {
    "i": 133,
    "start": "00:19:02.160",
    "end": "00:19:08.000",
    "text": "ייתכן. זה יכול להיות גם\nשואב אבק זול."
  },
  {
    "i": 134,
    "start": "00:19:08.160",
    "end": "00:19:12.000",
    "text": "שואב אבק? את לא בסדר?"
  },
  {
    "i": 135,
    "start": "00:19:12.160",
    "end": "00:19:18.600",
    "text": "רק רציתי לשמוע\nאם אתן מרכלות ספאנק על אנשים. להתראות!"
  },
  {
    "i": 136,
    "start": "00:19:24.240",
    "end": "00:19:27.120",
    "text": "היא פצועה?"
  },
  {
    "i": 137,
    "start": "00:19:27.280",
    "end": "00:19:31.400",
    "text": "–היי היי!\n–רק חכי, פיפי!"
  },
  {
    "i": 138,
    "start": "00:19:31.560",
    "end": "00:19:37.960",
    "text": "–אוי, פיפי הורסת לי את העצבים!\n–כן, כמה שאת אוהבת ילדים..."
  },
  {
    "i": 139,
    "start": "00:19:38.120",
    "end": "00:19:46.800",
    "text": "כן! היא חייבת להיכנס לבית הילדים. היא יכולה\nלהרוג את עצמה עם השגעונות שלה."
  },
  {
    "i": 140,
    "start": "00:19:48.200",
    "end": "00:19:50.680",
    "text": "אבעבועות רוח..."
  },
  {
    "i": 141,
    "start": "00:19:52.080",
    "end": "00:19:54.800",
    "text": "שעלת......"
  },
  {
    "i": 142,
    "start": "00:19:54.960",
    "end": "00:19:59.080",
    "text": "דבר... וספאנק...."
  },
  {
    "i": 143,
    "start": "00:19:59.240",
    "end": "00:20:02.120",
    "text": "חום כחול..."
  },
  {
    "i": 144,
    "start": "00:20:02.280",
    "end": "00:20:04.680",
    "text": "מחלת פנטס......"
  },
  {
    "i": 145,
    "start": "00:20:04.840",
    "end": "00:20:08.360",
    "text": "חצבת... וספאנק...."
  },
  {
    "i": 146,
    "start": "00:20:08.520",
    "end": "00:20:15.600",
    "text": "אוי, כמה שאני מרגישה רע!\nקיבלתי ספאנק. ספאנק, ספאנק..."
  },
  {
    "i": 147,
    "start": "00:21:01.640",
    "end": "00:21:05.880",
    "text": "נו... מה לא בסדר איתך?"
  },
  {
    "i": 148,
    "start": "00:21:06.040",
    "end": "00:21:11.880",
    "text": "–אני חוששת שקיבלתי ספאנק.\n–ספאנק??"
  },
  {
    "i": 149,
    "start": "00:21:12.040",
    "end": "00:21:20.120",
    "text": "כן. מגרד לי בכל הגוף, והעיניים\nנסגרות כשאני ישנה."
  },
  {
    "i": 150,
    "start": "00:21:20.280",
    "end": "00:21:26.160",
    "text": "–אהה, ככה?\n–ולפעמים יש לי שיהוקים."
  },
  {
    "i": 151,
    "start": "00:21:28.560",
    "end": "00:21:35.600",
    "text": "וביום ראשון לא הרגשתי טוב\nכשאכלתי משחת נעליים וחלב."
  },
  {
    "i": 152,
    "start": "00:21:35.760",
    "end": "00:21:38.920",
    "text": "זה היה מוזר."
  },
  {
    "i": 153,
    "start": "00:21:39.080",
    "end": "00:21:43.760",
    "text": "נבדוק אותך.\nתשכבי שם."
  },
  {
    "i": 154,
    "start": "00:21:54.880",
    "end": "00:22:01.440",
    "text": "את בטח טובה בהוצאת\nלשון. עשי את זה – ותגידי \"אהה\"."
  },
  {
    "i": 155,
    "start": "00:22:01.600",
    "end": "00:22:04.600",
    "text": "אהההה..."
  },
  {
    "i": 156,
    "start": "00:22:12.240",
    "end": "00:22:19.160",
    "text": "מספיק. פתחי את השמלה,\nונקשיב ללב הקטן."
  },
  {
    "i": 157,
    "start": "00:22:25.640",
    "end": "00:22:32.360",
    "text": "–הוא פועם?\n–כן כן... הוא פועם יפה."
  },
  {
    "i": 158,
    "start": "00:22:32.520",
    "end": "00:22:36.840",
    "text": "אני בטוחה שקיבלתי ספאנק.\nזה מדבק?"
  },
  {
    "i": 159,
    "start": "00:22:37.000",
    "end": "00:22:44.800",
    "text": "–לא... וכנראה אין לך ספאנק.\n–יש מחלה שנקראת ככה?"
  },
  {
    "i": 160,
    "start": "00:22:44.960",
    "end": "00:22:51.000",
    "text": "לא... אבל גם אם הייתה,\nהיא כנראה לא הייתה תופסת עלייך."
  },
  {
    "i": 161,
    "start": "00:22:51.160",
    "end": "00:22:58.240",
    "text": "–אני בריאה שוב? כמה זה עולה?\n–בדיקות ספאנק בחינם."
  },
  {
    "i": 162,
    "start": "00:22:58.400",
    "end": "00:23:03.400",
    "text": "–תודה, זה היה נחמד!\n–להתראות."
  },
  {
    "i": 163,
    "start": "00:23:08.080",
    "end": "00:23:15.840",
    "text": "–פיפי, אני חושב שנתייאש.\n–כן, אין ספאנק בעיר."
  },
  {
    "i": 164,
    "start": "00:23:16.000",
    "end": "00:23:23.160",
    "text": "–אני חושב שנלך הביתה.\n–כן, ואולי תפסנו ספאנק במלכודת!"
  },
  {
    "i": 165,
    "start": "00:23:45.720",
    "end": "00:23:48.360",
    "text": "פיפי!"
  },
  {
    "i": 166,
    "start": "00:23:50.040",
    "end": "00:23:54.080",
    "text": "פיפי? פיפי!"
  },
  {
    "i": 167,
    "start": "00:23:57.000",
    "end": "00:24:01.840",
    "text": "צרחות ורעש"
  },
  {
    "i": 168,
    "start": "00:24:05.240",
    "end": "00:24:10.200",
    "text": "–הספאנק בא?\n–ורץ ישר למלכודת?"
  },
  {
    "i": 169,
    "start": "00:24:12.000",
    "end": "00:24:17.680",
    "text": "אוווה... פיפי! אוווה..."
  },
  {
    "i": 170,
    "start": "00:24:20.040",
    "end": "00:24:24.400",
    "text": "זו הייתה רק פרוסילוסקן רגילה."
  },
  {
    "i": 171,
    "start": "00:24:45.880",
    "end": "00:24:49.320",
    "text": "אוי, זהירות מהחיפושית!"
  },
  {
    "i": 172,
    "start": "00:24:52.960",
    "end": "00:24:59.760",
    "text": "–איזה יפה! איזה סוג זה?\n–בכל אופן לא חיפושית מאי."
  },
  {
    "i": 173,
    "start": "00:24:59.920",
    "end": "00:25:05.080",
    "text": "–לא... וגם לא זבלן.\n–וגם לא איילון."
  },
  {
    "i": 174,
    "start": "00:25:05.240",
    "end": "00:25:11.120",
    "text": "–אני יודעת מה זה: ספאנק!\n–את בטוחה?"
  },
  {
    "i": 175,
    "start": "00:25:11.280",
    "end": "00:25:16.920",
    "text": "אתה חושב שאני לא מזהה\nספאנק כשאני רואה אחד?"
  },
  {
    "i": 176,
    "start": "00:25:20.960",
    "end": "00:25:26.440",
    "text": "–הספאנק הקטן והמתוק שלי...\n–סוף סוף מצאנו אחד."
  },
  {
    "i": 177,
    "start": "00:25:26.600",
    "end": "00:25:32.000",
    "text": "מוזר... חיפשנו כל היום\nאחרי ספאנק–"
  },
  {
    "i": 178,
    "start": "00:25:32.160",
    "end": "00:25:37.400",
    "text": "–והנה הוא היה\nליד וילה וילהקולה!"
  },
  {
    "i": 179,
    "start": "00:26:00.800",
    "end": "00:26:04.840",
    "text": "הנה באה Pippi Långstrump!\nצ'ולהופ, צ'ולהיי, צ'ולהופסנסה"
  },
  {
    "i": 180,
    "start": "00:26:05.000",
    "end": "00:26:09.160",
    "text": "הנה באה Pippi Långstrump,\nהנה באמת אני!"
  },
  {
    "i": 181,
    "start": "00:26:09.320",
    "end": "00:26:13.560",
    "text": "ראית את הקוף שלי,\nאת הקוף הקטן המתוק והיפה שלי?"
  },
  {
    "i": 182,
    "start": "00:26:13.720",
    "end": "00:26:18.000",
    "text": "ראית את מר נילסון?\nכן, ככה באמת קוראים לו"
  },
  {
    "i": 183,
    "start": "00:26:18.160",
    "end": "00:26:22.080",
    "text": "ראית את הווילה שלי,\nאת וילת וילהקולה שלי?"
  },
  {
    "i": 184,
    "start": "00:26:22.240",
    "end": "00:26:26.400",
    "text": "רוצה, רוצה לדעת\nלמה הווילה נקראת כך?"
  },
  {
    "i": 185,
    "start": "00:26:26.560",
    "end": "00:26:30.760",
    "text": "כי שם גרה Pippi Långstrump!\nצ'ולהופ, צ'ולהיי, צ'ולהופסנסה"
  },
  {
    "i": 186,
    "start": "00:26:30.920",
    "end": "00:26:35.040",
    "text": "כי שם גרה Pippi Långstrump,\nכן, שם באמת גרה אני!"
  },
  {
    "i": 187,
    "start": "00:26:35.200",
    "end": "00:26:39.280",
    "text": "זה לא רע\n– יש לי קוף, סוס ווילה"
  },
  {
    "i": 188,
    "start": "00:26:39.440",
    "end": "00:26:43.480",
    "text": "מזוודה מלאה כסף,\nגם זה טוב שיהיה"
  },
  {
    "i": 189,
    "start": "00:26:43.640",
    "end": "00:26:47.960",
    "text": "בואו עכשיו, כל החברים,\nכל אחד שאני מכירה!"
  },
  {
    "i": 190,
    "start": "00:26:48.120",
    "end": "00:26:52.200",
    "text": "עכשיו נחיה את החיים!\nצ'ולהיי, צ'ולהופסנסה..."
  },
  {
    "i": 191,
    "start": "00:26:57.320",
    "end": "00:27:00.560",
    "text": "כתוביות: Inger Sjöstrand\n(c) Sveriges Television AB 2010"
  }
]