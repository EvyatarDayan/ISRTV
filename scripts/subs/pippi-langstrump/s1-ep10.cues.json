[
  {
    "i": 0,
    "start": "00:00:22.200",
    "end": "00:00:27.920",
    "text": "...för i alla tider\nett löfte...la la laaa..."
  },
  {
    "i": 1,
    "start": "00:00:34.320",
    "end": "00:00:39.760",
    "text": "Jag drömmer om den våren,\npa-paaa..."
  },
  {
    "i": 2,
    "start": "00:00:39.920",
    "end": "00:00:46.520",
    "text": "–Hej! Är det så fina tjuvar på stan?\n–Bjä bjä bjä... Stick!"
  },
  {
    "i": 3,
    "start": "00:00:46.680",
    "end": "00:00:51.240",
    "text": "–Hur går tjuveriet? Lönar det sig?\n–Stick!"
  },
  {
    "i": 4,
    "start": "00:00:51.400",
    "end": "00:00:57.440",
    "text": "Här får ni var sin guldpeng\nför att ni sjunger så vackert."
  },
  {
    "i": 5,
    "start": "00:01:07.640",
    "end": "00:01:10.080",
    "text": "Du – titta här!"
  },
  {
    "i": 6,
    "start": "00:01:11.360",
    "end": "00:01:17.880",
    "text": "–Tänk, hon har en hel kappsäck full!\n–Som VI skulle behöva bättre."
  },
  {
    "i": 7,
    "start": "00:01:18.040",
    "end": "00:01:21.000",
    "text": "La la..."
  },
  {
    "i": 8,
    "start": "00:01:23.640",
    "end": "00:01:28.480",
    "text": "–Ska vi passa på nu när hon är ute?\n–Hon är ju så stark."
  },
  {
    "i": 9,
    "start": "00:01:28.640",
    "end": "00:01:34.360",
    "text": "Hon är inte där när vi tar väskan.\nLa la..."
  },
  {
    "i": 10,
    "start": "00:01:37.560",
    "end": "00:01:40.400",
    "text": "Här, lilla gubben!"
  },
  {
    "i": 11,
    "start": "00:01:48.160",
    "end": "00:01:52.000",
    "text": "–Vem vill ha sockerdricka?\n–JAG!"
  },
  {
    "i": 12,
    "start": "00:01:52.160",
    "end": "00:01:55.560",
    "text": "–Här...\n–Å, så gott!"
  },
  {
    "i": 13,
    "start": "00:02:53.680",
    "end": "00:02:58.400",
    "text": "Å, om man kunde flyga!"
  },
  {
    "i": 14,
    "start": "00:02:58.560",
    "end": "00:03:05.120",
    "text": "Pippi försökte flyga, hon\n– men det gick pladask i backen."
  },
  {
    "i": 15,
    "start": "00:03:06.680",
    "end": "00:03:09.960",
    "text": "Ballongen!"
  },
  {
    "i": 16,
    "start": "00:03:10.120",
    "end": "00:03:16.360",
    "text": "–Vad då för ballong?\n–Pappas ballong. Den är på vinden."
  },
  {
    "i": 17,
    "start": "00:03:26.800",
    "end": "00:03:30.920",
    "text": "–Tänk om hon är hemma...\n–Sällan!"
  },
  {
    "i": 18,
    "start": "00:03:31.080",
    "end": "00:03:33.440",
    "text": "En häst!"
  },
  {
    "i": 19,
    "start": "00:03:41.560",
    "end": "00:03:43.880",
    "text": "Kom nu!"
  },
  {
    "i": 20,
    "start": "00:04:04.240",
    "end": "00:04:09.480",
    "text": "Pippi, din pappa är ju kung.\nHan är väl ingen ballongflygare?"
  },
  {
    "i": 21,
    "start": "00:04:09.640",
    "end": "00:04:14.720",
    "text": "Han var det för länge, länge sen."
  },
  {
    "i": 22,
    "start": "00:04:14.880",
    "end": "00:04:20.720",
    "text": "Han gjorde en luftballong\nför att flyga till nordpolen..."
  },
  {
    "i": 23,
    "start": "00:04:20.880",
    "end": "00:04:27.880",
    "text": "...men han kom bara till Alingsås.\nDå slutade han med ballongflygeriet."
  },
  {
    "i": 24,
    "start": "00:04:29.040",
    "end": "00:04:31.600",
    "text": "Nej!"
  },
  {
    "i": 25,
    "start": "00:04:50.520",
    "end": "00:04:53.360",
    "text": "Ouiii-äääh!"
  },
  {
    "i": 26,
    "start": "00:04:59.160",
    "end": "00:05:06.680",
    "text": "–Det var den förbaskade apan.\n–\"Herr Nilsson, om jag får be!\""
  },
  {
    "i": 27,
    "start": "00:05:13.440",
    "end": "00:05:17.840",
    "text": "–Blom...titta!\n–HA HA HA!"
  },
  {
    "i": 28,
    "start": "00:05:18.000",
    "end": "00:05:23.160",
    "text": "–Ska du slänga ner ballongkorgen?\n–Jajamänsan!"
  },
  {
    "i": 29,
    "start": "00:05:33.640",
    "end": "00:05:37.360",
    "text": "Fantastiskt... Vi har pengarna!"
  },
  {
    "i": 30,
    "start": "00:05:53.720",
    "end": "00:05:59.560",
    "text": "Jag tar med guldpengar, ifall\nvi måste ta tåget från Alingsås."
  },
  {
    "i": 31,
    "start": "00:05:59.720",
    "end": "00:06:03.560",
    "text": "–Hittar du dem inte?\n–Vad sa du?"
  },
  {
    "i": 32,
    "start": "00:06:03.720",
    "end": "00:06:09.040",
    "text": "–Hittar du dem inte?\n–Äsch, jag hittar dem nog sen."
  },
  {
    "i": 33,
    "start": "00:06:16.280",
    "end": "00:06:21.280",
    "text": "Blom – nu får du bära!\nJag orkar inte längre."
  },
  {
    "i": 34,
    "start": "00:06:55.960",
    "end": "00:07:00.360",
    "text": "–Nämen Pippi!\n–Tänker du flyga ifrån oss?"
  },
  {
    "i": 35,
    "start": "00:07:00.520",
    "end": "00:07:05.000",
    "text": "Nej, jag förtöjer vid balkongräcket."
  },
  {
    "i": 36,
    "start": "00:07:06.280",
    "end": "00:07:12.520",
    "text": "Glöm inte smörgåsar och läsk.\nOch ta med båts-haken!"
  },
  {
    "i": 37,
    "start": "00:07:14.160",
    "end": "00:07:20.480",
    "text": "Jag vill ha prickig korv\npå tre smörgåsar och ost på två!"
  },
  {
    "i": 38,
    "start": "00:07:22.840",
    "end": "00:07:26.080",
    "text": "Tjocka korvskivor!"
  },
  {
    "i": 39,
    "start": "00:08:27.640",
    "end": "00:08:31.400",
    "text": "Nu åker vi."
  },
  {
    "i": 40,
    "start": "00:08:31.560",
    "end": "00:08:34.080",
    "text": "Hej, lilla gubben!"
  },
  {
    "i": 41,
    "start": "00:08:35.520",
    "end": "00:08:39.080",
    "text": "Hej då, Villa Villekulla!"
  },
  {
    "i": 42,
    "start": "00:08:44.960",
    "end": "00:08:48.680",
    "text": "Hej, lilla mamma!"
  },
  {
    "i": 43,
    "start": "00:08:48.840",
    "end": "00:08:51.800",
    "text": "Vi är i luften!"
  },
  {
    "i": 44,
    "start": "00:08:51.960",
    "end": "00:08:56.480",
    "text": "–Hej, mamma!\n–Här uppe!"
  },
  {
    "i": 45,
    "start": "00:08:56.640",
    "end": "00:09:00.200",
    "text": "Uppe i luften!"
  },
  {
    "i": 46,
    "start": "00:09:01.200",
    "end": "00:09:06.720",
    "text": "–Vi ska göra en liten tur.\n–Vi kommer snart tillbaka."
  },
  {
    "i": 47,
    "start": "00:09:06.880",
    "end": "00:09:12.440",
    "text": "Ballongen går bara till Alingsås,\nså var inte orolig."
  },
  {
    "i": 48,
    "start": "00:09:12.600",
    "end": "00:09:19.120",
    "text": "Jo då, Dunder-Karlsson och Blom\när på rymmen – men vi ska hitta dem!"
  },
  {
    "i": 49,
    "start": "00:09:19.280",
    "end": "00:09:27.080",
    "text": "–Att tjuvar går lösa är obehagligt.\n–De kommer inte undan motorcykeln!"
  },
  {
    "i": 50,
    "start": "00:09:34.640",
    "end": "00:09:38.520",
    "text": "Titta, Pippi – Prussiluskan!"
  },
  {
    "i": 51,
    "start": "00:09:38.680",
    "end": "00:09:44.960",
    "text": "–Hej, hej, Prussiluskan!\n–God dag, tant Prysselius!"
  },
  {
    "i": 52,
    "start": "00:09:45.120",
    "end": "00:09:47.480",
    "text": "Hej, hej!"
  },
  {
    "i": 53,
    "start": "00:09:49.720",
    "end": "00:09:57.360",
    "text": "Hoppsan... – Klang, fort! Herregud,\nvad tog det åt tanten? Gör något!"
  },
  {
    "i": 54,
    "start": "00:09:58.920",
    "end": "00:10:02.080",
    "text": "Oj, vad hände?"
  },
  {
    "i": 55,
    "start": "00:10:05.200",
    "end": "00:10:07.640",
    "text": "Där...där..."
  },
  {
    "i": 56,
    "start": "00:10:07.800",
    "end": "00:10:12.960",
    "text": "Är det inte Pippi Långstrump?\nKlang, utryckning!"
  },
  {
    "i": 57,
    "start": "00:10:13.120",
    "end": "00:10:17.840",
    "text": "Hejda henne!\nRädda Tommy och Annika!"
  },
  {
    "i": 58,
    "start": "00:11:15.560",
    "end": "00:11:19.560",
    "text": "Vad det är härligt att flyga ballong!"
  },
  {
    "i": 59,
    "start": "00:11:21.960",
    "end": "00:11:24.360",
    "text": "Nämen titta!"
  },
  {
    "i": 60,
    "start": "00:11:25.960",
    "end": "00:11:29.440",
    "text": "Det är ju Kling och Klang!"
  },
  {
    "i": 61,
    "start": "00:11:31.560",
    "end": "00:11:34.200",
    "text": "STANNA!"
  },
  {
    "i": 62,
    "start": "00:11:35.360",
    "end": "00:11:39.120",
    "text": "–Gå av med detsamma!\n–Vad sa du?"
  },
  {
    "i": 63,
    "start": "00:11:39.280",
    "end": "00:11:44.440",
    "text": "–Gå av med detsamma!\n–Nej, jag har inte sett din mamma."
  },
  {
    "i": 64,
    "start": "00:11:44.600",
    "end": "00:11:51.480",
    "text": "Jag säger STANNA! Ni får inte flyga\nså där. Hör du inte vad jag säger?"
  },
  {
    "i": 65,
    "start": "00:11:51.640",
    "end": "00:11:57.880",
    "text": "–Jag hör inte vad du säger.\n–STANNA...annars får du smörj!"
  },
  {
    "i": 66,
    "start": "00:11:58.040",
    "end": "00:12:01.880",
    "text": "Nej, inte Göteborg. Till Alingsås!"
  },
  {
    "i": 67,
    "start": "00:12:02.040",
    "end": "00:12:07.960",
    "text": "–Unge, hör du ingenting?\n–Jaså, ni ser er omkring?"
  },
  {
    "i": 68,
    "start": "00:12:08.120",
    "end": "00:12:13.560",
    "text": "–Pippi, de jagar OSS.\n–Vi har väl inte gjort nånting?"
  },
  {
    "i": 69,
    "start": "00:12:17.280",
    "end": "00:12:19.960",
    "text": "KOM TILLBAKA!"
  },
  {
    "i": 70,
    "start": "00:12:25.240",
    "end": "00:12:32.680",
    "text": "Nu förstår jag: de vill leka kull\nigen. Vilka nöjeslystna poliser!"
  },
  {
    "i": 71,
    "start": "00:12:45.120",
    "end": "00:12:49.320",
    "text": "Alingsås...Alingsås..."
  },
  {
    "i": 72,
    "start": "00:12:51.360",
    "end": "00:12:57.800",
    "text": "Varför hittar jag det inte?\nAlingsås..."
  },
  {
    "i": 73,
    "start": "00:13:03.560",
    "end": "00:13:06.480",
    "text": "Ta den, Herr Nilsson!"
  },
  {
    "i": 74,
    "start": "00:13:09.680",
    "end": "00:13:13.600",
    "text": "Alingsås... Konstigt!"
  },
  {
    "i": 75,
    "start": "00:13:23.040",
    "end": "00:13:26.840",
    "text": "...1 999...2 000...2 001..."
  },
  {
    "i": 76,
    "start": "00:13:27.000",
    "end": "00:13:30.920",
    "text": "...2 002...2 003...2 004..."
  },
  {
    "i": 77,
    "start": "00:13:31.080",
    "end": "00:13:37.160",
    "text": "–Vi är stenrika!\n–Undrar om Pippi vet var pengarna är."
  },
  {
    "i": 78,
    "start": "00:13:38.560",
    "end": "00:13:43.480",
    "text": "Alingsås... Nu vet jag\nvarför jag inte hittar det."
  },
  {
    "i": 79,
    "start": "00:13:43.640",
    "end": "00:13:47.600",
    "text": "Sjökortet är över Karibiska havet!"
  },
  {
    "i": 80,
    "start": "00:14:02.600",
    "end": "00:14:06.640",
    "text": "–Var kom den ifrån?\n–Den liknar Pippi!"
  },
  {
    "i": 81,
    "start": "00:14:06.800",
    "end": "00:14:14.280",
    "text": "–Det är nåt djävulskap. Kappsäcken...\n–Är du skraj för en docka, dummer?"
  },
  {
    "i": 82,
    "start": "00:14:28.680",
    "end": "00:14:35.280",
    "text": "TRUMPET-SOLO:\nHÄR ÄR GUDAGOTT ATT VARA"
  },
  {
    "i": 83,
    "start": "00:14:51.520",
    "end": "00:14:59.520",
    "text": "Så här är rätt så skönt att fara\nÅ, vad livet dock är kul!"
  },
  {
    "i": 84,
    "start": "00:14:59.680",
    "end": "00:15:07.200",
    "text": "Kling och Klang, de är ju så rara\n– de ska få var sin puss till jul"
  },
  {
    "i": 85,
    "start": "00:15:07.360",
    "end": "00:15:14.560",
    "text": "Kling är korkad så det smäller\noch förstår just ingenting"
  },
  {
    "i": 86,
    "start": "00:15:14.720",
    "end": "00:15:22.480",
    "text": "Klang är inte dum han heller\n– han är lika klok som Kling"
  },
  {
    "i": 87,
    "start": "00:15:22.640",
    "end": "00:15:29.720",
    "text": "Kling och Klang och jubel bara,\nKling och Klang och Klang och Kling"
  },
  {
    "i": 88,
    "start": "00:15:29.880",
    "end": "00:15:34.720",
    "text": "Kling och Klang\noch Klang och Kling-Kling"
  },
  {
    "i": 89,
    "start": "00:15:34.880",
    "end": "00:15:39.800",
    "text": "–Där... De flyger ditåt!\n–Hoppa i!"
  },
  {
    "i": 90,
    "start": "00:15:39.960",
    "end": "00:15:44.360",
    "text": "De vill ut och se sig kring..."
  },
  {
    "i": 91,
    "start": "00:16:04.600",
    "end": "00:16:08.240",
    "text": "Ööööh – bort! Ööööh!"
  },
  {
    "i": 92,
    "start": "00:16:11.960",
    "end": "00:16:15.000",
    "text": "Ta bort dem!"
  },
  {
    "i": 93,
    "start": "00:16:15.160",
    "end": "00:16:19.720",
    "text": "–Hjälp!\n–I lagens namn...skingra er!"
  },
  {
    "i": 94,
    "start": "00:16:34.160",
    "end": "00:16:39.000",
    "text": "Akta dig – du kan ramla ner, Tommy!"
  },
  {
    "i": 95,
    "start": "00:16:41.800",
    "end": "00:16:46.360",
    "text": "Så här är rätt så skönt att fara"
  },
  {
    "i": 96,
    "start": "00:16:46.520",
    "end": "00:16:50.840",
    "text": "Å, vad livet dock är kul!"
  },
  {
    "i": 97,
    "start": "00:16:54.720",
    "end": "00:16:58.520",
    "text": "Puh... Fy farao!"
  },
  {
    "i": 98,
    "start": "00:16:58.680",
    "end": "00:17:01.880",
    "text": "Jag är hungrig!"
  },
  {
    "i": 99,
    "start": "00:17:02.040",
    "end": "00:17:06.880",
    "text": "Det är inget att göra åt.\nSov i stället!"
  },
  {
    "i": 100,
    "start": "00:17:24.120",
    "end": "00:17:31.600",
    "text": "–Pippi, kan vi inte landa ett tag?\n–Oj...min macka!"
  },
  {
    "i": 101,
    "start": "00:17:47.920",
    "end": "00:17:52.000",
    "text": "Blom! Här har du."
  },
  {
    "i": 102,
    "start": "00:17:54.240",
    "end": "00:17:59.080",
    "text": "–Var har du fått den?\n–Av en ängel, gissar jag."
  },
  {
    "i": 103,
    "start": "00:17:59.240",
    "end": "00:18:03.800",
    "text": "BARNEN SJUNGER"
  },
  {
    "i": 104,
    "start": "00:17:59.240",
    "end": "00:18:03.800",
    "text": "Ja...jag hör änglakören."
  },
  {
    "i": 105,
    "start": "00:18:03.960",
    "end": "00:18:09.800",
    "text": "Ett par öl hade de också\nkunnat slänga ner, änglarna."
  },
  {
    "i": 106,
    "start": "00:18:15.360",
    "end": "00:18:19.680",
    "text": "Maka på er – vi ska landa!"
  },
  {
    "i": 107,
    "start": "00:18:24.400",
    "end": "00:18:28.440",
    "text": "Släpp ut mer gas, är du bussig."
  },
  {
    "i": 108,
    "start": "00:18:38.040",
    "end": "00:18:41.840",
    "text": "Lilla lamm, flytta på dig!"
  },
  {
    "i": 109,
    "start": "00:18:51.720",
    "end": "00:18:54.800",
    "text": "Ta det här, Tommy!"
  },
  {
    "i": 110,
    "start": "00:18:57.480",
    "end": "00:19:02.920",
    "text": "–Raka vägen?\n–Nej, till höger! Sväng!"
  },
  {
    "i": 111,
    "start": "00:19:07.120",
    "end": "00:19:11.200",
    "text": "Titta, de kommer!"
  },
  {
    "i": 112,
    "start": "00:19:11.360",
    "end": "00:19:14.200",
    "text": "Då åker vi."
  },
  {
    "i": 113,
    "start": "00:19:24.840",
    "end": "00:19:28.880",
    "text": "Vill ni också upp och flyga?"
  },
  {
    "i": 114,
    "start": "00:19:29.040",
    "end": "00:19:35.760",
    "text": "–Vänta på oss!\n–Hoppa ombord, om ni vill följa med!"
  },
  {
    "i": 115,
    "start": "00:19:35.920",
    "end": "00:19:39.040",
    "text": "Nej, hoppa högre!"
  },
  {
    "i": 116,
    "start": "00:19:41.440",
    "end": "00:19:46.320",
    "text": "Duktiga pojkar! Bättre kan ni."
  },
  {
    "i": 117,
    "start": "00:19:46.480",
    "end": "00:19:48.640",
    "text": "Kom ner!"
  },
  {
    "i": 118,
    "start": "00:19:48.800",
    "end": "00:19:55.240",
    "text": "Ni kan inte ta oss,\nni kan inte ta oss, haha haha haha!"
  },
  {
    "i": 119,
    "start": "00:19:55.400",
    "end": "00:20:01.200",
    "text": "Ni kan inte ta oss...\nHej, hej – nu åker vi!"
  },
  {
    "i": 120,
    "start": "00:20:21.800",
    "end": "00:20:24.640",
    "text": "Där... Kör då!"
  },
  {
    "i": 121,
    "start": "00:20:47.200",
    "end": "00:20:53.120",
    "text": "–Titta, en gubbe!\n–En kyrkvaktmästare... Bra!"
  },
  {
    "i": 122,
    "start": "00:20:53.280",
    "end": "00:20:56.680",
    "text": "Hallå! HALLÅ!"
  },
  {
    "i": 123,
    "start": "00:20:59.000",
    "end": "00:21:02.520",
    "text": "Var är vi nånstans?"
  },
  {
    "i": 124,
    "start": "00:21:02.680",
    "end": "00:21:06.000",
    "text": "–Var är vi?\n–Där uppe."
  },
  {
    "i": 125,
    "start": "00:21:06.160",
    "end": "00:21:12.000",
    "text": "Jaså, här?\nDet var bara det jag ville veta."
  },
  {
    "i": 126,
    "start": "00:21:17.640",
    "end": "00:21:21.240",
    "text": "Tack ska du ha!"
  },
  {
    "i": 127,
    "start": "00:21:34.160",
    "end": "00:21:40.120",
    "text": "–Pippi, ballongen åker i väg!\n–Jag hoppar!"
  },
  {
    "i": 128,
    "start": "00:21:41.480",
    "end": "00:21:44.720",
    "text": "–Nej!\n–Håll i dig!"
  },
  {
    "i": 129,
    "start": "00:22:10.080",
    "end": "00:22:13.400",
    "text": "Pippi, du klarar det!"
  },
  {
    "i": 130,
    "start": "00:22:17.640",
    "end": "00:22:22.200",
    "text": "Ja, du klarar det. Bara LITE till."
  },
  {
    "i": 131,
    "start": "00:22:32.040",
    "end": "00:22:34.360",
    "text": "Bravo!"
  },
  {
    "i": 132,
    "start": "00:22:37.040",
    "end": "00:22:39.920",
    "text": "Prosten!"
  },
  {
    "i": 133,
    "start": "00:22:40.080",
    "end": "00:22:43.920",
    "text": "–Prosten!\n–Brinner det nånstans?"
  },
  {
    "i": 134,
    "start": "00:22:44.080",
    "end": "00:22:48.760",
    "text": "Nej,\ndet sitter tre barn i kyrkspiran."
  },
  {
    "i": 135,
    "start": "00:22:48.920",
    "end": "00:22:55.080",
    "text": "–Har kyrkspiran fått trillingar?\n–Nej, de sitter i en ballong."
  },
  {
    "i": 136,
    "start": "00:22:55.240",
    "end": "00:23:03.840",
    "text": "–Ballong? Har Persson supit nu igen?\n–Nej... Kom själv och se!"
  },
  {
    "i": 137,
    "start": "00:23:05.400",
    "end": "00:23:10.240",
    "text": "J-jag tyckte...jag trodde\natt kanske...jag såg..."
  },
  {
    "i": 138,
    "start": "00:23:10.400",
    "end": "00:23:17.680",
    "text": "Kom inte med fler såna dumheter! Då\nmåste jag kontakta nykterhetsnämnden."
  },
  {
    "i": 139,
    "start": "00:23:17.840",
    "end": "00:23:23.520",
    "text": "–Jag ska ALDRIG mer säga så.\n–Bra, Persson!"
  },
  {
    "i": 140,
    "start": "00:23:23.680",
    "end": "00:23:26.080",
    "text": "Tack, prosten."
  },
  {
    "i": 141,
    "start": "00:23:28.160",
    "end": "00:23:31.400",
    "text": "Vi frågar där framme."
  },
  {
    "i": 142,
    "start": "00:23:31.560",
    "end": "00:23:37.440",
    "text": "Stanna då! – Har ni sett\ntre barn i en luftballong?"
  },
  {
    "i": 143,
    "start": "00:23:37.600",
    "end": "00:23:41.920",
    "text": "Tänk att jag inte har det!\nFörsök inte!"
  },
  {
    "i": 144,
    "start": "00:23:42.080",
    "end": "00:23:43.920",
    "text": "Tack då."
  },
  {
    "i": 145,
    "start": "00:23:46.960",
    "end": "00:23:51.720",
    "text": "Stanna! Jag HAR sett en ballong."
  },
  {
    "i": 146,
    "start": "00:23:51.880",
    "end": "00:23:55.720",
    "text": "Prosten är en idiot. Stanna!"
  },
  {
    "i": 147,
    "start": "00:24:23.800",
    "end": "00:24:28.360",
    "text": "De ger inte upp. Duktiga pojkar!"
  },
  {
    "i": 148,
    "start": "00:24:37.000",
    "end": "00:24:44.000",
    "text": "–Där har vi två duktiga pojkar till.\n–Dunder-Karlsson och Blom?"
  },
  {
    "i": 149,
    "start": "00:24:44.160",
    "end": "00:24:50.160",
    "text": "Ja. Jag sa att jag skulle hitta\nkappsäcken – och det gjorde jag."
  },
  {
    "i": 150,
    "start": "00:25:02.040",
    "end": "00:25:08.000",
    "text": "Jag har släpat på väskan hela dan.\nNu är det din tur!"
  },
  {
    "i": 151,
    "start": "00:25:10.920",
    "end": "00:25:13.800",
    "text": "–Kappsäcken!\n–Guldpengarna..."
  },
  {
    "i": 152,
    "start": "00:25:13.960",
    "end": "00:25:17.400",
    "text": "Snuten! Kvickt i väg!"
  },
  {
    "i": 153,
    "start": "00:25:27.520",
    "end": "00:25:29.840",
    "text": "Där är de!"
  },
  {
    "i": 154,
    "start": "00:25:31.200",
    "end": "00:25:34.640",
    "text": "Stopp! Hallå där!"
  },
  {
    "i": 155,
    "start": "00:25:38.800",
    "end": "00:25:43.920",
    "text": "Dunder-Karlsson, du är igenkänd!\nGe upp!"
  },
  {
    "i": 156,
    "start": "00:26:28.840",
    "end": "00:26:34.840",
    "text": "–I väg fort! Gasa på!\n–Jag skjuter på."
  },
  {
    "i": 157,
    "start": "00:26:41.680",
    "end": "00:26:44.000",
    "text": "Stopp!"
  },
  {
    "i": 158,
    "start": "00:26:46.400",
    "end": "00:26:50.080",
    "text": "Kling och Klang och Klang och Kling"
  },
  {
    "i": 159,
    "start": "00:26:50.240",
    "end": "00:26:57.720",
    "text": "Klang och Kling vill ut och fara,\nKlang och Kling vill se sig kring..."
  },
  {
    "i": 160,
    "start": "00:27:09.960",
    "end": "00:27:13.200",
    "text": "Svensktextning: Inger Sjöstrand\n(c) Sveriges Television AB 2010"
  }
]