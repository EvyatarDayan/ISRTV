[
  {
    "i": 0,
    "start": "00:00:19.520",
    "end": "00:00:23.360",
    "text": "SNARKNINGAR"
  },
  {
    "i": 1,
    "start": "00:00:27.640",
    "end": "00:00:31.680",
    "text": "Hon är inte vaken. Synd..."
  },
  {
    "i": 2,
    "start": "00:00:47.600",
    "end": "00:00:51.320",
    "text": "–God morgon.\n–God middag. Klockan är två!"
  },
  {
    "i": 3,
    "start": "00:00:51.480",
    "end": "00:00:57.960",
    "text": "Jag var uppe i natt och dansade\nschottis. Ni skulle inte väckt mig!"
  },
  {
    "i": 4,
    "start": "00:00:58.120",
    "end": "00:01:03.640",
    "text": "Jag drömde att pappa kom\nför att se om jag hade liktornar."
  },
  {
    "i": 5,
    "start": "00:01:03.800",
    "end": "00:01:10.760",
    "text": "-Längtar du efter din pappa?\n-Ibland. Nu tänker vi inte på det."
  },
  {
    "i": 6,
    "start": "00:01:17.080",
    "end": "00:01:22.200",
    "text": "Den här dagen tyckte Pippi\natt vi skulle gå i affärer..."
  },
  {
    "i": 7,
    "start": "00:01:22.360",
    "end": "00:01:26.680",
    "text": "...om hon kunde hitta\nsina guldpengar."
  },
  {
    "i": 8,
    "start": "00:01:27.680",
    "end": "00:01:31.960",
    "text": "Var är min kappsäck?\nVar är mina guldpengar?"
  },
  {
    "i": 9,
    "start": "00:01:32.120",
    "end": "00:01:35.600",
    "text": "Inte där."
  },
  {
    "i": 10,
    "start": "00:01:35.760",
    "end": "00:01:40.080",
    "text": "Var är mina guldpengar? Inte där..."
  },
  {
    "i": 11,
    "start": "00:01:40.240",
    "end": "00:01:44.840",
    "text": "Var är mina guldpengar? Inte där."
  },
  {
    "i": 12,
    "start": "00:01:48.800",
    "end": "00:01:53.280",
    "text": "Inte där...och inte där."
  },
  {
    "i": 13,
    "start": "00:01:53.440",
    "end": "00:01:57.160",
    "text": "DET TICKAR"
  },
  {
    "i": 14,
    "start": "00:02:07.960",
    "end": "00:02:12.040",
    "text": "KLOCKAN RINGER"
  },
  {
    "i": 15,
    "start": "00:02:19.560",
    "end": "00:02:25.440",
    "text": "Det är ingen ordning på allting!\nMan hittar inte vartenda dugg."
  },
  {
    "i": 16,
    "start": "00:02:29.720",
    "end": "00:02:33.160",
    "text": "Skönt! Där har vi den."
  },
  {
    "i": 17,
    "start": "00:02:39.480",
    "end": "00:02:43.560",
    "text": "Det är inte klokt vad Pippi är rik!"
  },
  {
    "i": 18,
    "start": "00:02:43.720",
    "end": "00:02:48.280",
    "text": "Det är ganska bra\nnär man ska gå i affärer."
  },
  {
    "i": 19,
    "start": "00:02:49.440",
    "end": "00:02:53.200",
    "text": "En sjö! Tuuut..."
  },
  {
    "i": 20,
    "start": "00:02:53.360",
    "end": "00:02:57.240",
    "text": "Jag är en ångbåt!"
  },
  {
    "i": 21,
    "start": "00:02:57.400",
    "end": "00:03:01.320",
    "text": "TUUUT TUUUT"
  },
  {
    "i": 22,
    "start": "00:03:01.480",
    "end": "00:03:05.680",
    "text": "TUT-TUT TUUUT"
  },
  {
    "i": 23,
    "start": "00:03:09.520",
    "end": "00:03:14.560",
    "text": "–Pippi, varför blundar du?\n–Det är dimma på havet."
  },
  {
    "i": 24,
    "start": "00:03:14.720",
    "end": "00:03:18.040",
    "text": "TUUUUT"
  },
  {
    "i": 25,
    "start": "00:03:18.200",
    "end": "00:03:21.240",
    "text": "Var är jag?"
  },
  {
    "i": 26,
    "start": "00:03:23.960",
    "end": "00:03:29.520",
    "text": "TUUUUUUUUUUT"
  },
  {
    "i": 27,
    "start": "00:03:35.040",
    "end": "00:03:38.360",
    "text": "Det blev röda spår efter Pippi."
  },
  {
    "i": 28,
    "start": "00:03:38.520",
    "end": "00:03:44.280",
    "text": "Hennes pappa hade köpt skorna\nav en indianhövding."
  },
  {
    "i": 29,
    "start": "00:03:58.640",
    "end": "00:04:01.200",
    "text": "Blod?!"
  },
  {
    "i": 30,
    "start": "00:04:01.360",
    "end": "00:04:05.600",
    "text": "Ja, sannerligen. Blod!"
  },
  {
    "i": 31,
    "start": "00:04:10.560",
    "end": "00:04:15.400",
    "text": "–En mördare, kanske?\n–Ja, en mördare."
  },
  {
    "i": 32,
    "start": "00:04:15.560",
    "end": "00:04:20.120",
    "text": "–Med stora hemska fötter.\n–Blodiga..."
  },
  {
    "i": 33,
    "start": "00:04:23.760",
    "end": "00:04:27.720",
    "text": "En ENBENT mördare...?"
  },
  {
    "i": 34,
    "start": "00:04:34.080",
    "end": "00:04:40.200",
    "text": "–Oj, så fräknig!\n–Pippi, kom får du se!"
  },
  {
    "i": 35,
    "start": "00:04:40.360",
    "end": "00:04:45.040",
    "text": "–Vad är det?\n–Vet du vad det står här?"
  },
  {
    "i": 36,
    "start": "00:04:45.200",
    "end": "00:04:49.240",
    "text": "\"Lider ni av fräknar?\" står det."
  },
  {
    "i": 37,
    "start": "00:04:49.400",
    "end": "00:04:57.160",
    "text": "När de frågar hövligt, måste de få\nett hövligt svar. Kom, vi kilar in!"
  },
  {
    "i": 38,
    "start": "00:05:03.160",
    "end": "00:05:06.920",
    "text": "–Nej!\n–Vad menar du?"
  },
  {
    "i": 39,
    "start": "00:05:07.600",
    "end": "00:05:11.880",
    "text": "Jag menar:\nNej – jag lider INTE av fräknar."
  },
  {
    "i": 40,
    "start": "00:05:12.040",
    "end": "00:05:16.280",
    "text": "Kära barn,\ndu har ju hela ansiktet fullt!"
  },
  {
    "i": 41,
    "start": "00:05:16.440",
    "end": "00:05:20.360",
    "text": "Men jag lider inte. Jag gillar dem."
  },
  {
    "i": 42,
    "start": "00:05:20.520",
    "end": "00:05:26.920",
    "text": "-Har du några bra parfymer?\n-Ja, men de kostar."
  },
  {
    "i": 43,
    "start": "00:05:27.080",
    "end": "00:05:29.120",
    "text": "Oj då!"
  },
  {
    "i": 44,
    "start": "00:05:41.920",
    "end": "00:05:45.720",
    "text": "Det luktar pyton!"
  },
  {
    "i": 45,
    "start": "00:05:52.560",
    "end": "00:05:56.160",
    "text": "Här är ju spåren slut!"
  },
  {
    "i": 46,
    "start": "00:06:00.920",
    "end": "00:06:05.280",
    "text": "–Kan du förklara det här?\n–Nej..."
  },
  {
    "i": 47,
    "start": "00:06:06.840",
    "end": "00:06:11.160",
    "text": "Vi talar inte om det här för någon!"
  },
  {
    "i": 48,
    "start": "00:06:43.920",
    "end": "00:06:51.800",
    "text": "Här har vi ett tyg från Italien.\nVacker färg... Det klär nog damen."
  },
  {
    "i": 49,
    "start": "00:06:51.960",
    "end": "00:06:59.280",
    "text": "Mot det blonda håret... Så vackert!\nEn fantastisk kvalité."
  },
  {
    "i": 50,
    "start": "00:06:59.440",
    "end": "00:07:03.520",
    "text": "–Vad vill du?\n–Jag kanske ska köpa ett hästtäcke."
  },
  {
    "i": 51,
    "start": "00:07:03.680",
    "end": "00:07:09.880",
    "text": "Det här verkar sladdrigt.\nJag ser mig omkring."
  },
  {
    "i": 52,
    "start": "00:07:17.720",
    "end": "00:07:23.800",
    "text": "–Det här är ingen rolig affär.\n–Känn vad den är len!"
  },
  {
    "i": 53,
    "start": "00:07:28.000",
    "end": "00:07:31.400",
    "text": "Pippi, var är du? Pippi!"
  },
  {
    "i": 54,
    "start": "00:07:31.560",
    "end": "00:07:35.280",
    "text": "–Olé!\n–Så får man inte göra."
  },
  {
    "i": 55,
    "start": "00:07:35.440",
    "end": "00:07:39.400",
    "text": "Man får väl prova?"
  },
  {
    "i": 56,
    "start": "00:07:38.920",
    "end": "00:07:43.360",
    "text": "SPANSK GITARRMUSIK"
  },
  {
    "i": 57,
    "start": "00:07:41.520",
    "end": "00:07:45.480",
    "text": "Olé...olé!"
  },
  {
    "i": 58,
    "start": "00:08:00.720",
    "end": "00:08:02.960",
    "text": "Kom, Annika!"
  },
  {
    "i": 59,
    "start": "00:08:04.280",
    "end": "00:08:11.960",
    "text": "Den här vägen... Vi har en underbar\nbrokad som nog är idealisk för damen."
  },
  {
    "i": 60,
    "start": "00:08:12.120",
    "end": "00:08:18.120",
    "text": "–Ja, den har en härlig lyster.\n–Ska vi ta ut den och titta?"
  },
  {
    "i": 61,
    "start": "00:08:19.760",
    "end": "00:08:27.040",
    "text": "Judde-judderi, judde-juddera,\njudde-judderi ta-raj taj..."
  },
  {
    "i": 62,
    "start": "00:08:28.640",
    "end": "00:08:33.680",
    "text": "God dag, frun. Hur står det till?"
  },
  {
    "i": 63,
    "start": "00:08:33.840",
    "end": "00:08:38.440",
    "text": "Är det ni som äger den här affären?"
  },
  {
    "i": 64,
    "start": "00:08:38.600",
    "end": "00:08:43.120",
    "text": "Jag sa: God dag! Äger frun affären?"
  },
  {
    "i": 65,
    "start": "00:08:43.280",
    "end": "00:08:47.440",
    "text": "Jaså, inte det? Säg det då!"
  },
  {
    "i": 66,
    "start": "00:08:48.400",
    "end": "00:08:53.520",
    "text": "Adjö och tack!\nDet var verkligen trevl..."
  },
  {
    "i": 67,
    "start": "00:08:54.640",
    "end": "00:08:58.840",
    "text": "Oj! Vad ska vi göra nu?"
  },
  {
    "i": 68,
    "start": "00:09:05.200",
    "end": "00:09:10.360",
    "text": "–Vad har du gjort?!\n–Jag behöver den. Vad kostar den?"
  },
  {
    "i": 69,
    "start": "00:09:10.520",
    "end": "00:09:13.080",
    "text": "Skyltdockor är inte till salu!"
  },
  {
    "i": 70,
    "start": "00:09:13.240",
    "end": "00:09:18.720",
    "text": "Jag är inte knusslig. Tack och adjö."
  },
  {
    "i": 71,
    "start": "00:09:22.240",
    "end": "00:09:24.440",
    "text": "Titta!"
  },
  {
    "i": 72,
    "start": "00:09:52.040",
    "end": "00:09:56.360",
    "text": "Adjö, adjö, Prussiluskan..."
  },
  {
    "i": 73,
    "start": "00:09:56.520",
    "end": "00:10:02.200",
    "text": "–Tänk om man hade pengar...\n–En krona skulle räcka till mycket."
  },
  {
    "i": 74,
    "start": "00:10:02.360",
    "end": "00:10:05.760",
    "text": "Vilken lycklig tjej!"
  },
  {
    "i": 75,
    "start": "00:10:16.600",
    "end": "00:10:20.680",
    "text": "–Tjolahopp!\n–Kan vi inte gå in här?"
  },
  {
    "i": 76,
    "start": "00:10:20.840",
    "end": "00:10:24.160",
    "text": "Jo, här ska vi gå in!"
  },
  {
    "i": 77,
    "start": "00:10:26.280",
    "end": "00:10:30.960",
    "text": "Så där... Var så god. Tackar."
  },
  {
    "i": 78,
    "start": "00:10:34.040",
    "end": "00:10:40.360",
    "text": "–Vad ska du ha?\n–En tioöres klubba."
  },
  {
    "i": 79,
    "start": "00:10:40.520",
    "end": "00:10:45.840",
    "text": "Tur att det är lördag.\nAnnars skulle vi inte få äta godis."
  },
  {
    "i": 80,
    "start": "00:10:46.000",
    "end": "00:10:51.360",
    "text": "–Vad ska du ha, lilla vän?\n–18 kilo karameller."
  },
  {
    "i": 81,
    "start": "00:10:51.520",
    "end": "00:10:58.520",
    "text": "–Du menar väl 18 karameller?\n–Jag vill köpa 18 KILO karameller."
  },
  {
    "i": 82,
    "start": "00:10:58.680",
    "end": "00:11:02.120",
    "text": "–Räcker den?\n–Oj, en guldpeng!"
  },
  {
    "i": 83,
    "start": "00:11:02.280",
    "end": "00:11:05.920",
    "text": "Ja, det räcker till mera."
  },
  {
    "i": 84,
    "start": "00:11:06.080",
    "end": "00:11:11.240",
    "text": "Men 18 kilo har jag nog inte.\nJag ska titta på lagret."
  },
  {
    "i": 85,
    "start": "00:11:11.400",
    "end": "00:11:17.440",
    "text": "–Vi äter lite medan vi väntar.\n–Ja, ät bara! - En hel guldpeng..."
  },
  {
    "i": 86,
    "start": "00:12:05.440",
    "end": "00:12:11.280",
    "text": "–Det fanns bara 7 kilo på lagret.\n–Då ska vi ha de här..."
  },
  {
    "i": 87,
    "start": "00:12:12.600",
    "end": "00:12:15.400",
    "text": "...och de här."
  },
  {
    "i": 88,
    "start": "00:12:18.960",
    "end": "00:12:22.440",
    "text": "De här måste vi också ha."
  },
  {
    "i": 89,
    "start": "00:12:23.680",
    "end": "00:12:28.200",
    "text": "De gula också!\nDet är så god smörja i dem."
  },
  {
    "i": 90,
    "start": "00:12:28.360",
    "end": "00:12:31.960",
    "text": "Och kola-rullar!"
  },
  {
    "i": 91,
    "start": "00:12:32.120",
    "end": "00:12:35.640",
    "text": "Och sen ska jag ha..."
  },
  {
    "i": 92,
    "start": "00:12:35.800",
    "end": "00:12:41.480",
    "text": "...60 klubbor och 72 paket kola."
  },
  {
    "i": 93,
    "start": "00:12:41.640",
    "end": "00:12:47.480",
    "text": "–Och 103 chokladcigarretter!\n–60 klubbor, 72 paket kola..."
  },
  {
    "i": 94,
    "start": "00:12:47.640",
    "end": "00:12:51.320",
    "text": "...och 103 chokladcigarretter."
  },
  {
    "i": 95,
    "start": "00:12:51.480",
    "end": "00:12:55.720",
    "text": "Snälla Pippi, geléhallon\noch lakritsbåtar..."
  },
  {
    "i": 96,
    "start": "00:12:55.880",
    "end": "00:13:00.200",
    "text": "–Geléhallon och lakritsbåtar också!\n–Ja, ja..."
  },
  {
    "i": 97,
    "start": "00:13:01.480",
    "end": "00:13:04.720",
    "text": "Och kokosbollar..."
  },
  {
    "i": 98,
    "start": "00:13:05.600",
    "end": "00:13:08.240",
    "text": "...och bubbelgum..."
  },
  {
    "i": 99,
    "start": "00:13:08.400",
    "end": "00:13:11.000",
    "text": "...och sega gubbar..."
  },
  {
    "i": 100,
    "start": "00:13:11.160",
    "end": "00:13:13.600",
    "text": "...och polkagrisar..."
  },
  {
    "i": 101,
    "start": "00:13:13.760",
    "end": "00:13:17.280",
    "text": "...och röda remmar."
  },
  {
    "i": 102,
    "start": "00:13:18.400",
    "end": "00:13:23.880",
    "text": "–Så mycket godis!\n–Hon får ont i magen, stackarn."
  },
  {
    "i": 103,
    "start": "00:13:24.040",
    "end": "00:13:28.320",
    "text": "Finns det någon\nsom INTE äter karameller?"
  },
  {
    "i": 104,
    "start": "00:13:28.480",
    "end": "00:13:33.040",
    "text": "Jag! Men för en gångs skull..."
  },
  {
    "i": 105,
    "start": "00:13:33.200",
    "end": "00:13:37.720",
    "text": "–Finns det några fler?\n–JAG!"
  },
  {
    "i": 106,
    "start": "00:13:37.880",
    "end": "00:13:44.640",
    "text": "–Remmar och kokosbollar...\n–Tuggummi och polkagrisar... OJ!"
  },
  {
    "i": 107,
    "start": "00:14:24.920",
    "end": "00:14:30.360",
    "text": "Oj, vad vi åt!\nVi blev rädda att få ont i magen."
  },
  {
    "i": 108,
    "start": "00:14:30.520",
    "end": "00:14:36.960",
    "text": "–Nu ska jag gå och köpa medusin.\n–Me-di-cin heter det!"
  },
  {
    "i": 109,
    "start": "00:14:37.120",
    "end": "00:14:42.800",
    "text": "Just det. Folk dör\nför att de inte köper medusin i tid."
  },
  {
    "i": 110,
    "start": "00:14:42.960",
    "end": "00:14:48.400",
    "text": "–Medicin heter det!\n–Just det...medusin heter det."
  },
  {
    "i": 111,
    "start": "00:15:04.040",
    "end": "00:15:07.880",
    "text": "DÖRRKLOCKAN RINGER"
  },
  {
    "i": 112,
    "start": "00:15:08.160",
    "end": "00:15:11.240",
    "text": "Jaha...vad skulle det vara?"
  },
  {
    "i": 113,
    "start": "00:15:12.280",
    "end": "00:15:14.920",
    "text": "Egendomligt..."
  },
  {
    "i": 114,
    "start": "00:15:15.080",
    "end": "00:15:20.960",
    "text": "–Jag skulle ha fyra liter medusin.\n–Va??"
  },
  {
    "i": 115,
    "start": "00:15:35.560",
    "end": "00:15:38.760",
    "text": "Fyra liter medusin!"
  },
  {
    "i": 116,
    "start": "00:15:38.920",
    "end": "00:15:44.760",
    "text": "–FYRA LITER MEDUSIN!\n–Vad sa du? Vad är det du säger?"
  },
  {
    "i": 117,
    "start": "00:15:44.920",
    "end": "00:15:51.920",
    "text": "-Fyra liter medusin.\n-Fyra liter? Vad då för medicin?"
  },
  {
    "i": 118,
    "start": "00:15:52.080",
    "end": "00:15:58.200",
    "text": "Jag vill helst ha en medusin\nsom är bra för sjukdom."
  },
  {
    "i": 119,
    "start": "00:15:58.360",
    "end": "00:16:02.520",
    "text": "För sjukdom? Vad då för sjukdom?"
  },
  {
    "i": 120,
    "start": "00:16:02.680",
    "end": "00:16:08.040",
    "text": "Ta något\nsom hjälper mot kikhosta, skoskav..."
  },
  {
    "i": 121,
    "start": "00:16:08.200",
    "end": "00:16:15.560",
    "text": "...ont i magen,\nröda hund och ärtor i näsan."
  },
  {
    "i": 122,
    "start": "00:16:15.720",
    "end": "00:16:21.400",
    "text": "-Helst en man kan polera möbler med.\n-Du är visst lite prillig."
  },
  {
    "i": 123,
    "start": "00:16:21.560",
    "end": "00:16:28.400",
    "text": "Ge mig då något mot skit mellan\ntårna, växtvärk, kurr i magen–"
  },
  {
    "i": 124,
    "start": "00:16:28.560",
    "end": "00:16:36.160",
    "text": "–pip i bröstet, sus i öronen\noch prillighet. Har du sån medusin?"
  },
  {
    "i": 125,
    "start": "00:17:21.160",
    "end": "00:17:25.800",
    "text": "–Bjuder du på några?\n–Mig också!"
  },
  {
    "i": 126,
    "start": "00:17:25.960",
    "end": "00:17:30.960",
    "text": "–Var har ni fått allt godis?\n–Av Pippi Långstrump."
  },
  {
    "i": 127,
    "start": "00:17:31.120",
    "end": "00:17:33.360",
    "text": "Aha!"
  },
  {
    "i": 128,
    "start": "00:17:45.320",
    "end": "00:17:51.120",
    "text": "Tänk, vad folk är dumma! Så många\nflaskor när allt får rum i EN."
  },
  {
    "i": 129,
    "start": "00:17:51.280",
    "end": "00:17:57.320",
    "text": "-Att blanda så där kan vara farligt.\n-Äsch!"
  },
  {
    "i": 130,
    "start": "00:17:57.480",
    "end": "00:18:00.680",
    "text": "Titta där – en leksaksaffär!"
  },
  {
    "i": 131,
    "start": "00:18:09.320",
    "end": "00:18:14.120",
    "text": "En liten trevlig leksaksaffär. Haha!"
  },
  {
    "i": 132,
    "start": "00:18:21.160",
    "end": "00:18:25.240",
    "text": "KOM, ALLA BARN\nSOM VILL HA LEKSAKER!"
  },
  {
    "i": 133,
    "start": "00:18:25.400",
    "end": "00:18:29.280",
    "text": "Kom, alla barn som vill ha leksaker!"
  },
  {
    "i": 134,
    "start": "00:18:45.480",
    "end": "00:18:47.880",
    "text": "Yippeee!"
  },
  {
    "i": 135,
    "start": "00:18:54.200",
    "end": "00:19:01.720",
    "text": "–Kom hit! Hur kan de köpa så mycket?\n–Hon har en kappsäck med guldpengar."
  },
  {
    "i": 136,
    "start": "00:19:04.120",
    "end": "00:19:07.520",
    "text": "–Hon? Den flickan?\n–Ja."
  },
  {
    "i": 137,
    "start": "00:19:07.680",
    "end": "00:19:13.480",
    "text": "–Var bor du?\n–Villa Villekulla. Kom och hälsa på!"
  },
  {
    "i": 138,
    "start": "00:19:27.920",
    "end": "00:19:30.760",
    "text": "Ett, två, tre!"
  },
  {
    "i": 139,
    "start": "00:19:33.280",
    "end": "00:19:38.040",
    "text": "OLÅT UTAN MELODI"
  },
  {
    "i": 140,
    "start": "00:20:18.880",
    "end": "00:20:22.240",
    "text": "–Hör du?\n–Ja, kom!"
  },
  {
    "i": 141,
    "start": "00:20:35.200",
    "end": "00:20:41.720",
    "text": "–Stopp! Vad är det för oljud?\n–Kronobergs regementes paradmarsch."
  },
  {
    "i": 142,
    "start": "00:20:41.880",
    "end": "00:20:47.240",
    "text": "–Sånt här ska man ha tillstånd till!\n–Ge er i väg!"
  },
  {
    "i": 143,
    "start": "00:20:52.200",
    "end": "00:21:00.000",
    "text": "Ett hål! Ett väldigt egendomligt\nhål... Jag tror att det här hålet–"
  },
  {
    "i": 144,
    "start": "00:21:00.160",
    "end": "00:21:05.400",
    "text": "–går tvärsigenom jorden\nner till kattemaramerna."
  },
  {
    "i": 145,
    "start": "00:21:05.560",
    "end": "00:21:12.840",
    "text": "Säkert har kattemaramerna\nkikhosta och skoskav och röda hund."
  },
  {
    "i": 146,
    "start": "00:21:13.000",
    "end": "00:21:18.960",
    "text": "De har nog näsorna fulla med ärtor\nockså – men ingen medusin."
  },
  {
    "i": 147,
    "start": "00:21:20.280",
    "end": "00:21:27.200",
    "text": "Och kanske inget att polera\nmöbler med. Men NU har de det!"
  },
  {
    "i": 148,
    "start": "00:21:45.480",
    "end": "00:21:51.720",
    "text": "-Hej! Har pappa gått förbi här?\n-Har han blå ögon?"
  },
  {
    "i": 149,
    "start": "00:21:51.880",
    "end": "00:21:56.600",
    "text": "-Var han liksom mittemellan-lång?\n–Ja."
  },
  {
    "i": 150,
    "start": "00:21:56.760",
    "end": "00:22:00.960",
    "text": "–Svarta skor och svart hatt?\n-Just det!"
  },
  {
    "i": 151,
    "start": "00:22:01.120",
    "end": "00:22:05.200",
    "text": "Nej, honom har vi inte sett."
  },
  {
    "i": 152,
    "start": "00:22:05.360",
    "end": "00:22:08.280",
    "text": "Vänta... Var han flintskallig?"
  },
  {
    "i": 153,
    "start": "00:22:08.440",
    "end": "00:22:14.240",
    "text": "-Nej, det var han visst inte!\n-Tur för honom!"
  },
  {
    "i": 154,
    "start": "00:22:14.400",
    "end": "00:22:19.920",
    "text": "Du – hade han jätteöron\nsom räckte ner till axlarna?"
  },
  {
    "i": 155,
    "start": "00:22:20.080",
    "end": "00:22:27.600",
    "text": "–Har någon gått förbi med såna öron?\n–Nej, alla har gått med fötterna."
  },
  {
    "i": 156,
    "start": "00:22:27.760",
    "end": "00:22:34.040",
    "text": "Äsch! Jag menar:\nHar du sett någon med så stora öron?"
  },
  {
    "i": 157,
    "start": "00:22:34.200",
    "end": "00:22:40.280",
    "text": "Man kan inte ha så stora öron.\nJo – i Kina!"
  },
  {
    "i": 158,
    "start": "00:22:40.440",
    "end": "00:22:47.440",
    "text": "Där träffade jag en kines en gång.\nHan hade jätteöron."
  },
  {
    "i": 159,
    "start": "00:22:47.600",
    "end": "00:22:51.840",
    "text": "När det regnade\nkröp han in under öronen."
  },
  {
    "i": 160,
    "start": "00:22:52.000",
    "end": "00:22:57.400",
    "text": "Ibland bjöd han in vänner.\nDe satt under öronen och sjöng:"
  },
  {
    "i": 161,
    "start": "00:22:57.560",
    "end": "00:23:03.560",
    "text": "Tjing tjong, tjing tjing,\ntjing tjong – pling, pling"
  },
  {
    "i": 162,
    "start": "00:23:03.720",
    "end": "00:23:11.040",
    "text": "Vad du ser konstig ut. Tror du\natt jag ljuger? Säg ifrån i så fall!"
  },
  {
    "i": 163,
    "start": "00:23:11.200",
    "end": "00:23:16.200",
    "text": "Nej, du kanske inte ljuger, men..."
  },
  {
    "i": 164,
    "start": "00:23:16.360",
    "end": "00:23:22.800",
    "text": "Det är just vad jag gör!\nJag ljuger så tungan svartnar."
  },
  {
    "i": 165,
    "start": "00:23:22.960",
    "end": "00:23:30.080",
    "text": "Du! Vi har inte sett din pappa\n– ingen flintskallig på hela dagen."
  },
  {
    "i": 166,
    "start": "00:23:30.240",
    "end": "00:23:35.680",
    "text": "Men i går gick det förbi\nsjutton stycken arm i arm!"
  },
  {
    "i": 167,
    "start": "00:24:05.400",
    "end": "00:24:11.640",
    "text": "–Å, vad jag är törstig!\n–Jag också. Det är karamellerna..."
  },
  {
    "i": 168,
    "start": "00:24:13.680",
    "end": "00:24:20.240",
    "text": "Då är det tur att vi har trädet.\nHär inne växer det sockerdricka."
  },
  {
    "i": 169,
    "start": "00:24:20.400",
    "end": "00:24:24.200",
    "text": "Äh, det gör det ju inte!"
  },
  {
    "i": 170,
    "start": "00:24:26.320",
    "end": "00:24:30.360",
    "text": "–Vad är det här, då?\n–Nämen..."
  },
  {
    "i": 171,
    "start": "00:24:33.880",
    "end": "00:24:37.080",
    "text": "Konstigt..."
  },
  {
    "i": 172,
    "start": "00:25:03.040",
    "end": "00:25:09.000",
    "text": "Fint att ha träd\nsom det växer sockerdricka i."
  },
  {
    "i": 173,
    "start": "00:25:09.160",
    "end": "00:25:14.760",
    "text": "Vi kom överens om att det skulle\nvara vårt eget hemliga träd."
  },
  {
    "i": 174,
    "start": "00:25:16.400",
    "end": "00:25:22.000",
    "text": "Hit skulle ingen annan få komma."
  },
  {
    "i": 175,
    "start": "00:25:22.160",
    "end": "00:25:24.480",
    "text": "Hej då!"
  },
  {
    "i": 176,
    "start": "00:25:27.920",
    "end": "00:25:31.880",
    "text": "–Pippi!\n–Vart tog hon vägen?"
  },
  {
    "i": 177,
    "start": "00:25:32.040",
    "end": "00:25:36.360",
    "text": "Jag försmäktar i min fängelsehåla!"
  },
  {
    "i": 178,
    "start": "00:25:36.520",
    "end": "00:25:41.760",
    "text": "–Titta, det är ihåligt!\n–Hej! Ska ni komma ner?"
  },
  {
    "i": 179,
    "start": "00:25:41.920",
    "end": "00:25:47.120",
    "text": "–Nej, det törs jag inte.\n–Tänk om du inte kommer upp!"
  },
  {
    "i": 180,
    "start": "00:25:47.280",
    "end": "00:25:54.440",
    "text": "Nej, det är omöjligt. Jag måste\nstanna här tills jag blir gammal."
  },
  {
    "i": 181,
    "start": "00:25:54.600",
    "end": "00:26:01.800",
    "text": "Ni får kasta ner köttbullar\ntre gånger om dan."
  },
  {
    "i": 182,
    "start": "00:25:59.000",
    "end": "00:26:02.200",
    "text": "SLAG PÅ GONGGONG"
  },
  {
    "i": 183,
    "start": "00:26:01.960",
    "end": "00:26:06.760",
    "text": "Oj, vi måste kila! Det är mat."
  },
  {
    "i": 184,
    "start": "00:26:06.920",
    "end": "00:26:09.760",
    "text": "Hej då!"
  },
  {
    "i": 185,
    "start": "00:26:12.440",
    "end": "00:26:16.440",
    "text": "–Hej, hej!\n–Glöm inte köttbullarna!"
  },
  {
    "i": 186,
    "start": "00:26:16.600",
    "end": "00:26:23.760",
    "text": "–Kan du verkligen inte komma upp?\n–Jo, kanske...om jag försöker."
  },
  {
    "i": 187,
    "start": "00:26:26.000",
    "end": "00:26:29.960",
    "text": "GONGGONG-SLAG"
  },
  {
    "i": 188,
    "start": "00:26:35.800",
    "end": "00:26:40.680",
    "text": "–Du är fin, lilla gubben.\n–Tack för i dag!"
  },
  {
    "i": 189,
    "start": "00:26:40.840",
    "end": "00:26:44.800",
    "text": "Hej, hej – tack för i dag!"
  },
  {
    "i": 190,
    "start": "00:26:48.440",
    "end": "00:26:52.400",
    "text": "Mansröst : Hej, hej! Tack för i dag!"
  },
  {
    "i": 191,
    "start": "00:27:06.120",
    "end": "00:27:09.360",
    "text": "Textning: Inger Sjöstrand\nSveriges Television AB"
  }
]