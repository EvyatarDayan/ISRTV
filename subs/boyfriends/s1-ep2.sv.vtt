6ebb9d1b6a58461cb1f1d85a8dd72afd
00:12:16.800 --> 00:12:18.080 align:left position:22%
<c.teletext>Det bögigaste jag har gjort är</c>

abfdb2d26dfd4e9b91d1afc336dd7e3d
